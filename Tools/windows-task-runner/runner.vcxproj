<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{64ED7E89-B6F6-4C02-957F-78959FC92A09}</ProjectGuid>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType><UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset><CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <OutDir>$(ProjectDir)..\..\out\windows-task-runner\</OutDir>
    <TargetName>cider-task-runner</TargetName>
    <TargetName Condition="'$(Fixture)'=='true'">cider-task-fixture</TargetName>
    <TargetName Condition="'$(DeadlineFixture)'=='true'">cider-task-deadline-fixture</TargetName>
    <IntDir>$(OutDir)obj\$(TargetName)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel><TreatWarningAsError>true</TreatWarningAsError>
      <LanguageStandard_C>stdc17</LanguageStandard_C><RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions Condition="'$(DeadlineFixture)'=='true'">CIDER_RUNNER_DEADLINE_FIXTURE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link><SubSystem>Console</SubSystem></Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="runner.c" Condition="'$(Fixture)'!='true'" />
    <ClCompile Include="fixture.c" Condition="'$(Fixture)'=='true'" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Target Name="ValidateFixtureMode" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Fixture)'=='true' And '$(DeadlineFixture)'=='true'" Text="Choose only one fixture mode." />
  </Target>
</Project>
