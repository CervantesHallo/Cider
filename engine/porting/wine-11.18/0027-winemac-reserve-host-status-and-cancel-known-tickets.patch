+/* Wine-thread NT work; registry/queue/decision fields use remote_lock. Cocoa
+ * paths only enqueue an existing registry owner, never create/close a section. */
+static struct remote_host *host_status_lookup_locked(UINT64 ticket)
+{
+    struct remote_host *host;
+    for (host = host_status_registry; host; host = host->status_next)
+        if (host->ticket == ticket) return host;
+    return NULL;
+}
+static void queue_host_status_locked(struct remote_host *host)
+{
+    if (!host->status_registered || host->status_queued) return;
+    host->status_queued = TRUE;
+    host->status_retry_next = NULL;
+    InterlockedIncrement(&host->refs);
+    *host_status_retry_tail = host;
+    host_status_retry_tail = &host->status_retry_next;
+}
+static BOOL host_status_model_ready_locked(const struct remote_host *host)
+{
+    return host->state == HOST_RETIRED && !host->status_controls && !host->status_preparing &&
+        !host->model_jobs && !host->retirement_pending && !host->retirement_queued;
+}
+static BOOL publish_host_status_locked(struct remote_host *host, BOOL terminal)
+{
+    struct macdrv_status_values values = {0};
+    struct macdrv_status_snapshot snapshot;
+    enum macdrv_status_publish_result result;
+    if (host->status_terminal) return TRUE;
+    if (!host->status_ready || !host->status_cell) return FALSE;
+    values.state = terminal ? MACDRV_STATUS_RETIRED :
+        (host->state == HOST_RETIRED ? MACDRV_STATUS_REVOKING : MACDRV_STATUS_ACTIVE);
+    values.error = host->status_error;
+    values.pending_requests = host->status_controls;
+    values.pending_models = host->model_jobs || host->retirement_pending;
+    /* Permission-only bootstrap/SAFE protocol. Dynamic sequences stay zero
+     * until all refresh/control paths have a qualified prefix contract. Never
+     * advertise a high admitted number as if an overlapping operation finished. */
+    values.cleanup_pending = terminal;
+    if (terminal) values.quiescent_sequence = values.applied_sequence;
+    result = macdrv_status_cell_publish(host->status_cell, &values, terminal);
+    if (!terminal) return result == MACDRV_STATUS_PUBLISHED || result == MACDRV_STATUS_PUBLISH_EXHAUSTED;
+    if ((result != MACDRV_STATUS_PUBLISHED && result != MACDRV_STATUS_PUBLISH_EXHAUSTED) ||
+        macdrv_status_cell_read(host->status_cell, &snapshot) != MACDRV_STATUS_READ_SAFE_ONLY)
+        return FALSE;
+    host->status_terminal = TRUE; /* actual publication, never a missing-entry ACK */
+    return TRUE;
+}
+static void retry_one_host_status(void)
+{
+    struct remote_host *host, **cursor;
+    struct remote_producer *producer;
+    struct macdrv_status_cell *cell = NULL;
+    BOOL removed = FALSE, retry = FALSE, owns_cell = FALSE;
+    NTSTATUS closed = STATUS_SUCCESS;
+    pthread_mutex_lock(&remote_lock);
+    host = host_status_retries;
+    if (host)
+    {
+        host_status_retries = host->status_retry_next;
+        if (!host_status_retries) host_status_retry_tail = &host_status_retries;
+        host->status_retry_next = NULL;
+        host->status_queued = FALSE;
+        if (host->status_busy)
+        {
+            queue_host_status_locked(host);
+            pthread_mutex_unlock(&remote_lock);
+            host_release(host);
+            return;
+        }
+        host->status_busy = TRUE;
+    }
+    if (!host) { pthread_mutex_unlock(&remote_lock); return; }
+    producer = host->producer; /* the host's independent producer reference */
+    if (host_status_model_ready_locked(host))
+    {
+        if (!host->status_resource_done)
+        {
+            if ((host->status_failed && !host->model_possible) || publish_host_status_locked(host, TRUE))
+            {
+                assert(producer->host_resources_pending);
+                --producer->host_resources_pending;
+                host->status_resource_done = TRUE;
+            }
+            else retry = TRUE;
+        }
+        if (host->status_resource_done)
+        {
+            cell = host->status_cell;
+            owns_cell = TRUE; /* this invocation owns even a proven-empty cell */
+            host->status_cell = NULL;
+            host->status_ready = FALSE; /* detached NT owner stays counted by registry/busy */
+        }
+    }
+    else if (host->status_ready) publish_host_status_locked(host, FALSE);
+    pthread_mutex_unlock(&remote_lock);
+    if (cell) closed = macdrv_status_cell_close(&cell);
+    pthread_mutex_lock(&remote_lock);
+    if (owns_cell)
+    {
+        assert(!host->status_cell);
+        host->status_cell = cell; /* retain exact partial view/H after any NT failure */
+        if (!cell && !closed && !host->status_queued)
+        {
+            for (cursor = &host_status_registry; *cursor != host; cursor = &(*cursor)->status_next) assert(*cursor);
+            *cursor = host->status_next;
+            host->status_registered = FALSE;
+            assert(producer->host_status_owners && host_status_registered_count);
+            --producer->host_status_owners;
+            --host_status_registered_count;
+            removed = TRUE;
+        }
+        else retry = TRUE;
+    }
+    if (host->state == HOST_RETIRED && !removed) retry = TRUE;
+    host->status_busy = FALSE;
+    if (retry) queue_host_status_locked(host); /* runnable owner before popped ref is dropped */
+    pthread_mutex_unlock(&remote_lock);
+    if (removed)
+    {
+        queue_producer_cleanup(producer);
+        finalize_producer_watch(producer); /* Wine thread, after real host NT cleanup */
+        host_release(host); /* completion registry owner */
+    }
+    host_release(host); /* transferred FIFO owner */
+}
+static struct remote_producer *host_cancel_producer_locked(const struct macdrv_remote_packet *packet)
+{
+    struct remote_host *host = host_status_lookup_locked(packet->host_ticket);
+    if (!host || !host->status_registered || !host->producer ||
+        host->producer->id != packet->lease_id) return NULL;
+    return host->producer; /* caller validates exact root/pid/generation and takes its own request pin */
+}
+static UINT64 prepare_host_status(struct remote_producer *producer, const struct macdrv_remote_packet *packet, DWORD *error)
+{
+    struct remote_host *host, *retired = NULL;
+    struct macdrv_status_identity identity;
+    struct macdrv_status_values initial = {0};
+    struct macdrv_status_cell *cell = NULL;
+    UINT64 ticket = 0;
+    NTSTATUS status;
+    if (!(host = calloc(1, sizeof(*host)))) { *error = ERROR_NOT_ENOUGH_MEMORY; return 0; }
+    pthread_mutex_lock(&remote_lock);
+    if (!producer->active || producer->protocol != MACDRV_REMOTE_PREPARED_PACKET_VERSION ||
+        !producer->root->open || !producer->root->revision || !producer->status_ready ||
+        !macdrv_status_identity_valid(&producer->status_identity))
+        *error = ERROR_INVALID_HANDLE;
+    else if (producer->host_resources_pending == ~(UINT32)0 || producer->host_status_owners == ~(UINT32)0 ||
+             host_status_registered_count == ~(UINT64)0)
+        *error = ERROR_ARITHMETIC_OVERFLOW;
+    else if (!(host->ticket = identity_locked())) *error = ERROR_ARITHMETIC_OVERFLOW;
+    else *error = ERROR_SUCCESS;
+    if (*error) { pthread_mutex_unlock(&remote_lock); free(host); return 0; }
+    host->refs = 3; /* lookup + completion registry + this preparation control */
+    host->root = producer->root;
+    host->producer = producer;
+    InterlockedIncrement(&host->root->refs);
+    InterlockedIncrement(&producer->refs);
+    host->child = packet->child ? wine_server_ptr_handle(packet->child) : NULL;
+    if (host->child == host->root->hwnd) host->child = NULL;
+    host->context_id = packet->context_id;
+    host->state = HOST_RESERVED;
+    host->status_controls = 1;
+    host->status_preparing = TRUE;
+    host->status_sequence = packet->sequence;
+    host->status_registered = TRUE;
+    host->status_next = host_status_registry;
+    host_status_registry = host;
+    ++producer->host_resources_pending;
+    ++producer->host_status_owners;
+    ++host_status_registered_count;
+    host->next = hosts;
+    hosts = host;
+    identity = producer->status_identity;
+    identity.kind = MACDRV_STATUS_HOST;
+    identity.ticket = host->ticket;
+    identity.context_id = host->context_id;
+    pthread_mutex_unlock(&remote_lock);
+    initial.state = MACDRV_STATUS_ACTIVE; /* no import and no installed ACK */
+    status = macdrv_status_cell_create(&identity, &initial, &cell);
+    pthread_mutex_lock(&remote_lock);
+    host->status_cell = cell;
+    host->status_ready = !status;
+    host->status_failed = !!status;
+    host->status_preparing = FALSE;
+    host->status_error = status ? RtlNtStatusToDosError(status) : ERROR_SUCCESS;
+    --host->status_controls;
+    *error = host->status_error;
+    if (!producer->active || !host->root->open || host->state == HOST_RETIRED)
+        *error = ERROR_PROCESS_ABORTED;
+    if (*error && host->state != HOST_RETIRED) retire_locked(host, &retired);
+    if (!*error) ticket = host->ticket;
+    queue_host_status_locked(host);
+    pthread_mutex_unlock(&remote_lock);
+    dispose_retired(retired);
+    retry_one_host_status();
+    host_release(host); /* actual preparation control reference */
+    return ticket;
+}
+static struct remote_host *begin_host_status_control(struct remote_producer *producer,
+    const struct macdrv_remote_packet *packet, BOOL cancel, DWORD *error)
+{
+    struct remote_host *host = host_status_lookup_locked(packet->host_ticket);
+    *error = ERROR_INVALID_HANDLE;
+    if (!host || host->producer != producer || !host->status_registered) return NULL;
+    if (!cancel && (host->state != HOST_RESERVED || !host->status_ready || host->status_failed ||
+        host->status_preparing || host->status_terminal || !producer->active || !host->root->open || !host->root->revision))
+        return NULL;
+    if (host->status_controls == ~(UINT32)0) { *error = ERROR_ARITHMETIC_OVERFLOW; return NULL; }
+    ++host->status_controls;
+    host->status_sequence = packet->sequence;
+    InterlockedIncrement(&host->refs);
+    *error = ERROR_SUCCESS;
+    return host;
+}
+static DWORD install_prepared_host(struct remote_producer *producer, const struct macdrv_remote_packet *packet)
+{
+    struct remote_host *host, *old, *next, *retired = NULL;
+    struct host_geometry geometry;
+    BOOL installed = FALSE;
+    DWORD error;
+    pthread_mutex_lock(&remote_lock);
+    host = begin_host_status_control(producer, packet, FALSE, &error);
+    if (host)
+    {
+        host->state = HOST_PENDING;
+        host->prepared_revision = host->root->revision;
+        host->model_possible = TRUE;
+        host->model_jobs = 1;
+        for (old = hosts; old; old = next)
+        {
+            next = old->next;
+            if (old != host && old->root == host->root && old->state == HOST_PENDING &&
+                (old->child == host->child || old->context_id == host->context_id)) retire_locked(old, &retired);
+        }
+    }
+    pthread_mutex_unlock(&remote_lock);
+    if (!host) return error;
+    dispose_retired(retired);
+    retired = NULL;
+    if (geometry_for_host(host, &geometry))
+        installed = macdrv_window_create_remote_host_checked(host->root->window, host->context_id, host->ticket,
+            geometry.frame, geometry.clip, geometry.z, geometry.valid_z, install_commit, host);
+    pthread_mutex_lock(&remote_lock);
+    retired = host->predecessors;
+    host->predecessors = NULL;
+    error = installed && host->state == HOST_INSTALLED && host->root->open && producer->active ?
+        ERROR_SUCCESS : ERROR_INVALID_HANDLE;
+    if (error && host->state != HOST_RETIRED) retire_locked(host, &retired);
+    pthread_mutex_unlock(&remote_lock);
+    dispose_retired(retired);
+    finish_host_model_job(host);
+    pthread_mutex_lock(&remote_lock);
+    host->status_error = error;
+    --host->status_controls;
+    queue_host_status_locked(host);
+    pthread_mutex_unlock(&remote_lock);
+    retry_one_host_status();
+    host_release(host);
+    return error;
+}
+static DWORD cancel_prepared_host(struct remote_producer *producer, const struct macdrv_remote_packet *packet)
+{
+    struct remote_host *host, *retired = NULL;
+    DWORD error;
+    BOOL terminal;
+    pthread_mutex_lock(&remote_lock);
+    host = begin_host_status_control(producer, packet, TRUE, &error);
+    if (host && host->state != HOST_RETIRED) retire_locked(host, &retired);
+    pthread_mutex_unlock(&remote_lock);
+    if (!host) return error;
+    dispose_retired(retired);
+    pthread_mutex_lock(&remote_lock);
+    --host->status_controls;
+    queue_host_status_locked(host);
+    pthread_mutex_unlock(&remote_lock);
+    retry_one_host_status();
+    pthread_mutex_lock(&remote_lock);
+    terminal = host->status_terminal;
+    pthread_mutex_unlock(&remote_lock);
+    host_release(host);
+    return terminal ? ERROR_SUCCESS : ERROR_IO_PENDING;
+}
