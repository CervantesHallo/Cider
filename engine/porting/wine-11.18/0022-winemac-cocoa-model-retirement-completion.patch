+static void remote_retirement_complete(void *context, bool removed)
+{
+    struct remote_host *host = context;
+    UINT64 ticket = host->ticket;
+    pthread_mutex_lock(&remote_lock);
+    assert(host->retirement_pending && !host->retirement_queued);
+    if (removed)
+    {
+        host->retirement_pending = FALSE;
+        assert(retirement_outstanding);
+        --retirement_outstanding;
+        if (host->producer)
