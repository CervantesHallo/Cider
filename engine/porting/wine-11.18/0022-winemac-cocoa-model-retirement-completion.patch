+        host->retirement_queued = TRUE;
+        host->retry_next = NULL;
+        *retirement_retry_tail = host;
+        retirement_retry_tail = &host->retry_next;
+    }
+    pthread_mutex_unlock(&remote_lock);
+    if (removed) host_release(host);
+    else ERR("remote Cocoa retirement failed; owner retained for ticket %#llx\n", (unsigned long long)ticket);
