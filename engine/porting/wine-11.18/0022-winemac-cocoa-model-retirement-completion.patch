+void macdrv_window_release_remote_host_deferred_checked(WineWindow *window, unsigned int context_id,
+    uint64_t generation, macdrv_remote_retirement_callback completion, void *context)
+{
+    OnMainThreadAsync(^{
+        bool removed = false;
+        @try
+        {
+            NSView *content = [window contentView];
+            if (!content) removed = true; /* no layer can remain attached to this root */
+            else if ([content isKindOfClass:[WineContentView class]])
+                removed = [(WineContentView *)content removeCALayerHostView:context_id generation:generation];
+        }
+        @catch (NSException *exception)
+        {
+            ERR(@"Cocoa remote retirement exception %@; completion remains failed\n", [exception name]);
+        }
+        @finally
+        {
+            if (completion) completion(context, removed);
+        }
+    });
+}
