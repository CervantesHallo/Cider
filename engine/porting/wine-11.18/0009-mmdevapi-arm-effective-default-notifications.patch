+/* A failed partial sample must never replace the last complete snapshot.
+ * Initial readiness reports failures. A live subscription retries transient
+ * reads with bounded work/backoff and keeps its armed watch after failure. */
+static HRESULT sample_default_role_ids(WCHAR **ids, BOOL recover)
+{
+    unsigned int attempt, limit = recover ? 3 : 1;
+    HRESULT hr = E_FAIL;
+
+    for (attempt = 0; attempt < limit; ++attempt)
+    {
+        hr = read_default_role_ids(ids);
+        if (SUCCEEDED(hr))
+            return hr;
+        free_default_role_ids(ids);
+        memset(ids, 0, 4 * sizeof(*ids));
+        if (attempt + 1 < limit)
+            Sleep(50 * (attempt + 1));
+    }
+    return hr;
 }
 
