+static void notification_state_release(struct notification_thread_state *state)
+{
+    if (!InterlockedDecrement(&state->refs))
+    {
+        if (state->thread) CloseHandle(state->thread);
+        CloseHandle(state->ready);
+        free(state);
+    }
+}
 
