+/* Foreign child geometry for the managed-surface port. Native preparation only.
+ * Output rectangles are raw pixels in the root content view, never Cocoa points.
+ * Keep the full source rectangle separate from its clip: clipping must not scale
+ * the exported texture or shift its source origin. */
+#if 0
+#pragma makedep unix
+#endif
+#include "config.h"
+#include <stdlib.h>
+#include <string.h>
+#include "macdrv.h"
+
+static BOOL map_client_rect(HWND window, HWND root, UINT dpi, RECT *rect)
+{
+    if (!NtUserGetClientRect(window, rect, dpi)) return FALSE;
+    RtlSetLastWin32Error(0);
+    if (!NtUserMapWindowPoints(window, root, (POINT *)rect, 2, dpi) && RtlGetLastWin32Error()) return FALSE;
+    return TRUE;
+}
+
+BOOL macdrv_get_remote_geometry(HWND root, HWND child, POINT content_offset,
+                               struct macdrv_remote_geometry *geometry)
+{
+    HWND cursor, inline_seen[16], *seen = inline_seen;
+    SIZE_T count = 0, capacity = ARRAYSIZE(inline_seen), i;
+    UINT dpi = NtUserGetWinMonitorDpi(root, MDT_RAW_DPI);
+    BOOL visible = TRUE, ok = FALSE;
+    RECT frame, clip, ancestor;
+
+    if (!geometry || !root || !child || !dpi || NtUserGetAncestor(child, GA_ROOT) != root) return FALSE;
+    if (!map_client_rect(child, root, dpi, &frame) || !map_client_rect(root, root, dpi, &clip)) return FALSE;
+    for (cursor = child; cursor; cursor = NtUserGetAncestor(cursor, GA_PARENT))
+    {
+        DWORD style;
+        /* A sequence of separately valid reparent operations can repeat a
+         * handle in this observed walk. Reject that inconsistent snapshot.
+         * Do not impose the old fixed32-depth cap on a valid window tree. */
+        for (i = 0; i < count; ++i) if (seen[i] == cursor) goto done;
+        if (count == capacity)
+        {
+            HWND *next;
+            if (capacity > ~(SIZE_T)0 / (2 * sizeof(*seen))) goto done;
+            if (!(next = malloc(2 * capacity * sizeof(*seen)))) goto done;
+            memcpy(next, seen, count * sizeof(*seen));
+            if (seen != inline_seen) free(seen);
+            seen = next;
+            capacity *= 2;
+        }
+        seen[count++] = cursor;
+        if (!NtUserGetWindowThread(cursor, NULL)) goto done;
+        style = NtUserGetWindowLongW(cursor, GWL_STYLE);
+        if (!(style & WS_VISIBLE) || (style & WS_MINIMIZE)) visible = FALSE;
+        if (!map_client_rect(cursor, root, dpi, &ancestor)) goto done;
+        /* Native driver cannot call the PE user32 IntersectRect import. */
+        clip.left = max(clip.left, ancestor.left);
+        clip.top = max(clip.top, ancestor.top);
+        clip.right = min(clip.right, ancestor.right);
+        clip.bottom = min(clip.bottom, ancestor.bottom);
+        if (IsRectEmpty(&clip)) SetRectEmpty(&clip);
+        if (cursor == root) break;
+    }
+    if (cursor != root || NtUserGetAncestor(child, GA_ROOT) != root) goto done;
+    if (!visible) SetRectEmpty(&clip);
+    /* Preserve empty geometry explicitly, rather than treating0x0 as the
+     * old root-fills-view sentinel. Offset both rectangles in one space. */
+    OffsetRect(&frame, content_offset.x, content_offset.y);
+    OffsetRect(&clip, content_offset.x, content_offset.y);
+    geometry->frame = frame;
+    geometry->clip = clip;
+    ok = TRUE;
+done:
+    if (seen != inline_seen) free(seen);
+    return ok;
+}
