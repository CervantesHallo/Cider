+bool macdrv_window_create_remote_host(WineWindow *window, unsigned int context_id, uint64_t generation,
+                                      CGRect frame, CGRect clip, double z, bool valid_z)
+{
+@autoreleasepool
+{
+    __block BOOL installed = NO;
+    OnMainThread(^{
+        NSView *content = [window contentView];
+        if (!window.closing && [content isKindOfClass:[WineContentView class]])
+            installed = [(WineContentView *)content addCALayerHostViewWithContextId:context_id generation:generation
+                                          frame:frame clip:clip z:z validZ:valid_z];
+    });
+    return installed;
+}
+}
