+/* A clipping container owns the host; clipping never resizes the source image. */
+@interface WineRemoteLayerHost : CALayer
+{
+    CALayerHost *source_layer;
+    CGRect source_pixels, clip_pixels;
+    CGFloat pixel_scale;
+    uint64_t host_generation;
+}
+- (instancetype)initWithContextId:(CAContextID)contextId generation:(uint64_t)generation;
+- (uint64_t)generation;
+- (void)setSourceFrame:(CGRect)frame clip:(CGRect)clip;
+- (void)setRetinaMode:(BOOL)mode;
+@end
+
+@implementation WineRemoteLayerHost
+- (instancetype)initWithContextId:(CAContextID)contextId generation:(uint64_t)generation
+{
+    if (!(self = [super init])) return nil;
+    if (!(source_layer = [[CALayerHost alloc] init]))
+    {
+        [self release];
+        return nil;
+    }
+    host_generation = generation;
+    [source_layer setContextId:contextId];
+    source_layer.magnificationFilter = kCAFilterNearest;
+    source_pixels = clip_pixels = CGRectNull;
+    pixel_scale = retina_on ? 2.0 : 1.0;
+    self.masksToBounds = YES;
+    [self addSublayer:source_layer];
+    [self setRetinaMode:retina_on];
+    return self;
+}
+- (uint64_t)generation
+{
+    return host_generation;
+}
+- (void)dealloc
+{
+    [source_layer removeFromSuperlayer];
+    [source_layer release];
+    [super dealloc];
+}
+- (void)layoutSublayers
+{
+    [super layoutSublayers];
+    if (CGRectIsNull(source_pixels)) source_layer.frame = self.bounds;
+}
+- (void)setSourceFrame:(CGRect)frame clip:(CGRect)clip
+{
+    source_pixels = frame;
+    clip_pixels = clip;
+    [CATransaction begin];
+    [CATransaction setDisableActions:YES];
+    if (CGRectIsNull(frame))
+    {
+        /* Only the explicit root sentinel fills the content view. */
+        self.autoresizingMask = kCALayerWidthSizable | kCALayerHeightSizable;
+        self.frame = self.superlayer ? self.superlayer.bounds : CGRectZero;
+        self.hidden = NO;
+        source_layer.frame = self.bounds;
+    }
+    else
+    {
+        CGRect visible;
+        self.autoresizingMask = 0;
+        visible = CGRectIsNull(clip) ? frame : CGRectIntersection(frame, clip);
+        if (CGRectIsNull(visible) || CGRectIsEmpty(visible) || CGRectIsEmpty(frame))
+        {
+            self.hidden = YES;
+            self.frame = CGRectZero;
+        }
+        else
+        {
+            /* One raw-pixel to point conversion, using this view's current
+             * mode, including during a Retina transition. No edge snapping. */
+            CGRect points = CGRectMake(visible.origin.x / pixel_scale, visible.origin.y / pixel_scale,
+                                       visible.size.width / pixel_scale, visible.size.height / pixel_scale);
+            self.frame = points;
+            source_layer.frame = CGRectMake((frame.origin.x - visible.origin.x) / pixel_scale,
+                                            (frame.origin.y - visible.origin.y) / pixel_scale,
+                                            frame.size.width / pixel_scale, frame.size.height / pixel_scale);
+            self.hidden = NO;
+        }
+    }
+    [CATransaction commit];
+}
+- (void)setRetinaMode:(BOOL)mode
+{
+    pixel_scale = mode ? 2.0 : 1.0;
+    self.contentsScale = pixel_scale;
+    source_layer.contentsScale = pixel_scale;
+    [self setSourceFrame:source_pixels clip:clip_pixels];
+}
+@end
+
