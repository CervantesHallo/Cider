+/* Native legacy-renderer frontend over Wine's managed client surfaces.
+ * Candidate only: no public function table until the complete ABI is linked. */
+#include "config.h"
+#include <pthread.h>
+#include <stdlib.h>
+#include "macdrv.h"
+#include "legacy_abi.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(macdrv);
+
+extern struct client_surface *macdrv_create_legacy_client_surface(HWND hwnd);
+extern void *macdrv_legacy_retain_object(void *object);
+extern void macdrv_legacy_release_object(void *object);
+
+struct legacy_surface
+{
+    struct list entry;
+    unsigned int refs, renderers;
+    BOOL creating;
+    struct macdrv_client_surface *surface;
+    macdrv_view retained_view;
+};
+
+static pthread_mutex_t legacy_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct list legacy_surfaces = LIST_INIT(legacy_surfaces);
+
+/* Only pointer equality is used until membership and a live reference are
+ * established. The token is the actual retained Cocoa view, preserving the
+ * legacy snapshot while renderer operations remain routed through this owner. */
+static struct legacy_surface *legacy_surface_lookup(const void *token)
+{
+    struct legacy_surface *entry, *found = NULL;
+
+    pthread_mutex_lock(&legacy_lock);
+    LIST_FOR_EACH_ENTRY(entry, &legacy_surfaces, struct legacy_surface, entry)
+    {
+        if (entry->retained_view != token) continue;
+        ++entry->refs;
+        found = entry;
+        break;
+    }
+    pthread_mutex_unlock(&legacy_lock);
+    return found;
+}
+
+static void legacy_surface_release(struct legacy_surface *entry)
+{
+    BOOL destroy;
+
+    pthread_mutex_lock(&legacy_lock);
+    destroy = !--entry->refs;
+    if (destroy) list_remove(&entry->entry);
+    pthread_mutex_unlock(&legacy_lock);
+    if (destroy)
+    {
+        void *view = entry->retained_view;
+        /* Retirement uses win32u's existing cache, not a second HWND table. */
+        client_surface_end_external_use(&entry->surface->client);
+        client_surface_release(&entry->surface->client);
+        macdrv_legacy_release_object(view);
+        free(entry);
+    }
+}
+
+struct macdrv_legacy_win_data *macdrv_legacy_get_win_data(HWND hwnd)
+{
+    struct macdrv_legacy_win_data *snapshot;
+    struct legacy_surface *entry;
+    struct macdrv_win_data *data;
+    struct client_surface *client;
+
+    TRACE("legacy snapshot hwnd %p\n", hwnd);
+    if (!(snapshot = calloc(1, sizeof(*snapshot)))) return NULL;
+    if (!(entry = calloc(1, sizeof(*entry))))
+    {
+        free(snapshot);
+        return NULL;
+    }
+    if (!(client = macdrv_create_legacy_client_surface(hwnd))) goto failed;
+    entry->surface = impl_from_client_surface(client);
+    entry->retained_view = macdrv_legacy_retain_object(entry->surface->cocoa_view);
+    if (!client_surface_begin_external_use(client))
+    {
+        void *view = entry->retained_view;
+        client_surface_release(client);
+        macdrv_legacy_release_object(view);
+        goto failed;
+    }
+
+    entry->refs = 1; /* snapshot lease; creation adds a separate renderer lease */
+    pthread_mutex_lock(&legacy_lock);
+    list_add_tail(&legacy_surfaces, &entry->entry);
+    pthread_mutex_unlock(&legacy_lock);
+    snapshot->hwnd = hwnd;
+    snapshot->client_cocoa_view = entry->retained_view;
+    snapshot->padding[0] = entry;
+    snapshot->color_key = CLR_INVALID;
+
+    /* Never carry a private window-data lock into renderer/main-thread calls. */
+    if ((data = get_win_data(hwnd)))
+    {
+        snapshot->cocoa_window = macdrv_legacy_retain_object(data->cocoa_window);
+        snapshot->window_rect = data->rects.window;
+        snapshot->whole_rect = data->rects.visible;
+        snapshot->client_rect = data->rects.client;
+        snapshot->pixel_format = data->pixel_format;
+        if (data->drag_event)
+        {
+            /* The snapshot no longer holds the private window-data lock. */
+            if (NtDuplicateObject(NtCurrentProcess(), data->drag_event, NtCurrentProcess(),
+                    &snapshot->drag_event, 0, 0, DUPLICATE_SAME_ACCESS))
+            {
+                release_win_data(data);
+                macdrv_legacy_release_win_data(snapshot);
+                return NULL;
+            }
+        }
+        snapshot->on_screen = data->on_screen;
+        snapshot->shaped = data->shaped;
+        snapshot->layered = data->layered;
+        snapshot->ulw_layered = data->ulw_layered;
+        snapshot->per_pixel_alpha = data->per_pixel_alpha;
+        snapshot->minimized = data->minimized;
+        release_win_data(data);
+    }
+    else
+    {
+        HWND parent = NtUserGetAncestor(hwnd, GA_PARENT);
+        UINT dpi = NtUserGetWinMonitorDpi(hwnd, MDT_RAW_DPI);
+        RECT rect;
+
+        if (NtUserGetWindowRect(hwnd, &rect, dpi))
+        {
+            if (parent) NtUserMapWindowPoints(NULL, parent, (POINT *)&rect, 2, dpi);
+            snapshot->window_rect = snapshot->whole_rect = rect;
+        }
+        if (NtUserGetClientRect(hwnd, &rect, dpi))
+        {
+            NtUserMapWindowPoints(hwnd, parent, (POINT *)&rect, 2, dpi);
+            snapshot->client_rect = rect;
+        }
+        snapshot->on_screen = !!(NtUserGetWindowLongW(hwnd, GWL_STYLE) & WS_VISIBLE);
+    }
+    return snapshot;
+
+failed:
+    free(entry);
+    free(snapshot);
+    return NULL;
+}
+
+void macdrv_legacy_release_win_data(struct macdrv_legacy_win_data *snapshot)
+{
+    void *window;
+
+    if (!snapshot) return;
+    window = snapshot->cocoa_window;
+    if (snapshot->drag_event) NtClose(snapshot->drag_event);
+    legacy_surface_release(snapshot->padding[0]);
+    if (window) macdrv_legacy_release_object(window);
+    free(snapshot);
+}
+
+macdrv_metal_view macdrv_legacy_create_metal_view(macdrv_view token, macdrv_metal_device device)
+{
+    struct legacy_surface *entry = legacy_surface_lookup(token);
+    BOOL acquired = FALSE, creating;
+
+    if (!entry) return NULL;
+    pthread_mutex_lock(&legacy_lock);
+    creating = entry->creating;
+    if (!creating) entry->creating = TRUE;
+    pthread_mutex_unlock(&legacy_lock);
+    /* Never wait with a native registry lock held across a main-thread call.
+     * Concurrent creation of the same opaque view reports unavailable. */
+    if (!creating)
+    {
+        acquired = macdrv_client_surface_acquire_metal_swapchain_with_device(entry->surface, (id_MTLDevice)device);
+        if (acquired && !macdrv_swapchain_get_layer(entry->surface->metal_swapchain)) acquired = FALSE;
+        pthread_mutex_lock(&legacy_lock);
+        if (acquired)
+        {
+            ++entry->renderers;
+            ++entry->refs;
+        }
+        entry->creating = FALSE;
+        pthread_mutex_unlock(&legacy_lock);
+        if (acquired) client_surface_present(&entry->surface->client);
+    }
+    legacy_surface_release(entry);
+    return acquired ? (macdrv_metal_view)token : NULL;
+}
+
+macdrv_metal_layer macdrv_legacy_get_metal_layer(macdrv_metal_view token)
+{
+    struct legacy_surface *entry = legacy_surface_lookup(token);
+    macdrv_metal_layer layer = NULL;
+    BOOL ready;
+
+    if (!entry) return NULL;
+    pthread_mutex_lock(&legacy_lock);
+    ready = !!entry->renderers;
+    pthread_mutex_unlock(&legacy_lock);
+    if (ready) layer = (macdrv_metal_layer)macdrv_swapchain_get_layer(entry->surface->metal_swapchain);
+    legacy_surface_release(entry);
+    return layer;
+}
+
+void macdrv_legacy_release_metal_view(macdrv_metal_view token)
+{
+    struct legacy_surface *entry = legacy_surface_lookup(token);
+    BOOL renderer;
+
+    if (!entry) return;
+    pthread_mutex_lock(&legacy_lock);
+    renderer = !!entry->renderers;
+    if (renderer) --entry->renderers;
+    pthread_mutex_unlock(&legacy_lock);
+    if (renderer) legacy_surface_release(entry);
+    legacy_surface_release(entry);
+}
