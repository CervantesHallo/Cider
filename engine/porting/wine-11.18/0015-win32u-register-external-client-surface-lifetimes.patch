+
+void use_window_client_surface( struct client_surface *surface, BOOL use )
+{
+    TRACE( "surface %s, use %u\n", debugstr_client_surface( surface ), use );
+
+    pthread_mutex_lock( &surfaces_lock );
+    client_surface_use_locked( surface, use );
+    pthread_mutex_unlock( &surfaces_lock );
+}
+
+/* External graphics frontends own a reference independently of the window.
+ * Register only fresh surfaces, so repeated attachment cannot corrupt the
+ * shared GL/Vulkan list. The ordinary retirement path keeps the last image
+ * alive until a window update or destruction releases its cached reference. */
+BOOL client_surface_begin_external_use( struct client_surface *surface )
+{
+    BOOL attached = FALSE;
+
+    if (!surface) return FALSE;
+    pthread_mutex_lock( &surfaces_lock );
+    if (surface->hwnd && surface->entry.next == &surface->entry &&
+        surface->entry.prev == &surface->entry && NtUserIsWindow( surface->hwnd ))
+    {
+        client_surface_use_locked( surface, TRUE );
+        attached = TRUE;
+    }
+    pthread_mutex_unlock( &surfaces_lock );
+    return attached;
+}
+
+void client_surface_end_external_use( struct client_surface *surface )
+{
+    struct client_surface *iter;
+
+    if (!surface) return;
+    pthread_mutex_lock( &surfaces_lock );
+    LIST_FOR_EACH_ENTRY( iter, &client_surfaces, struct client_surface, entry )
+    {
+        if (iter != surface) continue;
+        client_surface_use_locked( surface, FALSE );
+        break;
+    }
     pthread_mutex_unlock( &surfaces_lock );
 }
 
