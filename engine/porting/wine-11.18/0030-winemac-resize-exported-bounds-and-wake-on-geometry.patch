+/* Window callbacks may run under win32u admission. Post only after releasing
+ * our service lock: no synchronous USER/Cocoa wait or renderer scan here. */
+void macdrv_remote_client_geometry_changed(void)
+{
+    UINT32 window=0,thread=0;
+    if(pthread_main_np())return; /* Cocoa can never originate NT/PE work */
+    pthread_mutex_lock(&client_service_lock);
+    if(client_window&&client_thread&&!geometry_wake_pending)
+    {window=client_window;thread=client_thread;geometry_wake_pending=TRUE;}
+    pthread_mutex_unlock(&client_service_lock);
+    if(window&&!NtUserPostMessage(wine_server_ptr_handle(window),WM_MACDRV_REMOTE_CLIENT_WAKE,0,0))
+    {
+        pthread_mutex_lock(&client_service_lock);
+        if(client_window==window&&client_thread==thread)geometry_wake_pending=FALSE;
+        pthread_mutex_unlock(&client_service_lock);
+        WARN("renderer geometry wake post failed; periodic recovery retained\n");
