+static NTSTATUS end_producer_setup(struct producer_setup *setup)
+{
+    NTSTATUS status;
+    BOOL removed;
+    UINT64 id;
+    if (!setup) return STATUS_SUCCESS;
+    status = close_setup_handles(setup);
+    pthread_mutex_lock(&remote_lock);
