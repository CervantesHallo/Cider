+/* Exactly one live acquisition or selected cleanup owns the handle use.
+ * The list remains counted while NT closes run; failed handles stay recorded. */
+static NTSTATUS close_setup_handles(struct producer_setup *setup)
+{
+    HANDLE thread, process;
+    NTSTATUS thread_status = STATUS_SUCCESS, process_status = STATUS_SUCCESS;
+    pthread_mutex_lock(&remote_lock);
+    assert(setup->active || setup->busy);
+    thread = setup->thread; process = setup->process;
+    pthread_mutex_unlock(&remote_lock);
+    if (thread) thread_status = NtClose(thread);
+    if (process) process_status = NtClose(process);
+    pthread_mutex_lock(&remote_lock);
+    if (!thread_status) setup->thread = NULL;
+    if (!process_status) setup->process = NULL;
+    setup->last_close = thread_status ? thread_status : process_status;
+    pthread_mutex_unlock(&remote_lock);
+    return thread_status ? thread_status : process_status;
+}
+static void unlink_setup_locked(struct producer_setup *setup)
+{
+    struct producer_setup **cursor;
+    for (cursor = &producer_setups; *cursor != setup; cursor = &(*cursor)->next) assert(*cursor);
+    *cursor = setup->next;
