+static void queue_setup_cleanup_locked(struct producer_setup *setup)
+{
+    assert(!setup->active && !setup->busy && !setup->cleanup_queued);
+    setup->cleanup_queued = TRUE;
+    setup->cleanup_next = NULL;
+    *setup_cleanup_tail = setup;
+    setup_cleanup_tail = &setup->cleanup_next;
