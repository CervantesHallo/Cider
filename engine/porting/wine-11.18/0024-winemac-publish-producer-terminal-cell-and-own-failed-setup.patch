+    if (!setup->id) { free(setup); return ERROR_ARITHMETIC_OVERFLOW; }
+    *out = setup;
+    error = watch_control(MACDRV_REMOTE_RECOVERY_ARM, NULL, setup->id, NULL);
+    return error;
