+    removed = !setup->thread && !setup->process;
+    if (removed) unlink_setup_locked(setup);
+    else queue_setup_cleanup_locked(setup);
+    pthread_mutex_unlock(&remote_lock);
+    if (removed) free(setup);
+    if (status) ERR("remote setup %#llx close failed %#x; owner retained\n",
+        (unsigned long long)id, (unsigned int)status);
+    return status;
