+/* Keep the source-reader upload path for native/software samples. A final
+ * transform already providing the requested D3D11 texture must not be copied
+ * through a second allocator, losing its resource identity and attributes. */
+static BOOL source_reader_can_forward_sample(struct source_reader *reader, struct media_stream *stream, IMFSample *sample)
+{
+    IMFDXGIBuffer *dxgi_buffer;
+    ID3D11Texture2D *texture;
+    D3D11_TEXTURE2D_DESC desc;
+    IMFMediaBuffer *buffer;
+    UINT32 shared = 0, without_mutex = 0;
+    DWORD count;
+    BOOL forward = FALSE;
+
+    if (!(reader->flags & SOURCE_READER_DXGI_DEVICE_MANAGER) || list_empty(&stream->transforms))
+        return FALSE;
+    if (FAILED(IMFSample_GetBufferCount(sample, &count)) || count != 1
+            || FAILED(IMFSample_GetBufferByIndex(sample, 0, &buffer)))
+        return FALSE;
+
+    if (SUCCEEDED(IMFMediaBuffer_QueryInterface(buffer, &IID_IMFDXGIBuffer, (void **)&dxgi_buffer)))
+    {
+        if (SUCCEEDED(IMFDXGIBuffer_GetResource(dxgi_buffer, &IID_ID3D11Texture2D, (void **)&texture)))
+        {
+            ID3D11Texture2D_GetDesc(texture, &desc);
+            IMFAttributes_GetUINT32(reader->attributes, &MF_SA_D3D11_SHARED_WITHOUT_MUTEX, &without_mutex);
+            IMFAttributes_GetUINT32(reader->attributes, &MF_SA_D3D11_SHARED, &shared);
+            /* Match the existing fallback allocator's precedence. */
+            if (without_mutex)
+                forward = !!(desc.MiscFlags & D3D11_RESOURCE_MISC_SHARED);
+            else if (shared)
+                forward = !!(desc.MiscFlags & D3D11_RESOURCE_MISC_SHARED_KEYEDMUTEX);
+            else
+                forward = TRUE;
+            ID3D11Texture2D_Release(texture);
+        }
+        IMFDXGIBuffer_Release(dxgi_buffer);
+    }
+    IMFMediaBuffer_Release(buffer);
+    return forward;
+}
