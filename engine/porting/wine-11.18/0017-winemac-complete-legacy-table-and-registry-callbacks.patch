+static macdrv_metal_device legacy_create_metal_device(void)
+{
+    return (macdrv_metal_device)macdrv_create_metal_device();
+}
+
+static void legacy_release_metal_device(macdrv_metal_device device)
+{
+    macdrv_release_metal_device((id_MTLDevice)device);
+}
