+/* Native-only full unit. Parent assigns these wrappers to the existing table.
+ * This file does not define or publish macdrv_functions. */
+#if 0
+#pragma makedep unix
+#endif
+#include "config.h"
+#include <stdlib.h>
+#include <pthread.h>
+#include <string.h>
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "macdrv.h"
+#include "legacy_registry.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(macdrv);
+
+static LONG64 callback_address;
+struct registry_mapping_owner
+{
+    struct registry_mapping_owner *next;
+    void *base;
+    SIZE_T size;
+    NTSTATUS last_error;
+};
+static pthread_mutex_t mapping_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct registry_mapping_owner *pending_mappings;
+static struct registry_mapping_owner **pending_tail = &pending_mappings;
+
+/* A failed release retains an explicit owner. It cannot erase a registry
+ * operation's result or lose the only published HKEY. Never replay mutations. */
+static void release_mapping(struct registry_mapping_owner *owner)
+{
+    void *base = owner->base;
+    SIZE_T zero = 0;
+    NTSTATUS status = NtFreeVirtualMemory(NtCurrentProcess(), &base, &zero, MEM_RELEASE);
+    if (!status)
+    {
+        free(owner);
+        return;
+    }
+    owner->last_error = status;
+    pthread_mutex_lock(&mapping_lock);
+    owner->next = NULL;
+    *pending_tail = owner;
+    pending_tail = &owner->next;
+    pthread_mutex_unlock(&mapping_lock);
+    ERR("legacy registry mapping cleanup failed %#x; owner retained, operation result unchanged\n", (unsigned int)status);
+}
+
+/* At most one old mapping is retried per new operation, outside the mutex.
+ * This only retries resource cleanup, never RegCreate/RegSet or other APIs. */
+static void retry_pending_mapping(void)
+{
+    struct registry_mapping_owner *owner;
+    pthread_mutex_lock(&mapping_lock);
+    owner = pending_mappings;
+    if (owner)
+    {
+        pending_mappings = owner->next;
+        if (!pending_mappings) pending_tail = &pending_mappings;
+    }
+    pthread_mutex_unlock(&mapping_lock);
+    if (owner) release_mapping(owner);
+}
+
+NTSTATUS macdrv_legacy_registry_initialize(UINT64 callback)
+{
+    LONG64 previous;
+    if (!callback) return STATUS_INVALID_PARAMETER;
+    previous = InterlockedCompareExchange64(&callback_address, callback, 0);
+    return !previous || (UINT64)previous == callback ? STATUS_SUCCESS : STATUS_INVALID_PARAMETER;
+}
+
+NTSTATUS macdrv_legacy_registry_init(void *args)
+{
+    const struct macdrv_legacy_reg_init *init = args;
+    if (!init || init->magic != MACDRV_LEGACY_REG_MAGIC || init->version != MACDRV_LEGACY_REG_VERSION)
+        return STATUS_INVALID_PARAMETER;
+    return macdrv_legacy_registry_initialize(init->callback);
+}
+
+static LONG encode_key(HKEY key, UINT32 *wire)
+{
+    UINT_PTR value = (UINT_PTR)key;
+    *wire = (UINT32)value;
+    if (value != (UINT_PTR)*wire && value != (UINT_PTR)(LONG_PTR)(LONG)*wire)
+        return ERROR_INVALID_HANDLE;
+    return ERROR_SUCCESS;
+}
+
+static struct macdrv_legacy_reg_request *new_request(UINT32 operation, HKEY key, LONG *status)
+{
+    struct macdrv_legacy_reg_request *r;
+    UINT32 wire;
+    *status = encode_key(key, &wire);
+    if (*status) return NULL;
+    if (!(r = calloc(1, sizeof(*r))))
+    {
+        *status = ERROR_NOT_ENOUGH_MEMORY;
+        return NULL;
+    }
+    r->magic = MACDRV_LEGACY_REG_MAGIC;
+    r->version = MACDRV_LEGACY_REG_VERSION;
+    r->operation = operation;
+    r->key = wire;
+    r->reply_offset = sizeof(*r);
+    return r;
+}
+
+static LONG append_bytes(struct macdrv_legacy_reg_request **request, const void *bytes,
+                         UINT32 len, size_t offset_field)
+{
+    struct macdrv_legacy_reg_request *r = *request, *next;
+    UINT32 stored = len ? len : 1, offset = r->reply_offset;
+    if (stored > ~0u - offset) return ERROR_NOT_ENOUGH_MEMORY;
+    if (!(next = realloc(r, (size_t)offset + stored))) return ERROR_NOT_ENOUGH_MEMORY;
+    *request = next;
+    *(UINT32 *)((BYTE *)next + offset_field) = offset;
+    if (len) memcpy((BYTE *)next + offset, bytes, len);
+    else *((BYTE *)next + offset) = 0;
+    next->reply_offset = offset + stored;
+    return ERROR_SUCCESS;
+}
+
+static LONG append_string(struct macdrv_legacy_reg_request **request, const char *str,
+                          size_t offset_field, size_t length_field)
+{
+    size_t length;
+    LONG status;
+    *(UINT32 *)((BYTE *)*request + offset_field) = 0;
+    *(UINT32 *)((BYTE *)*request + length_field) = 0;
+    if (!str) return ERROR_SUCCESS;
+    length = strlen(str);
+    if (length >= ~0u) return ERROR_NOT_ENOUGH_MEMORY;
+    status = append_bytes(request, str, (UINT32)length + 1, offset_field);
+    if (!status) *(UINT32 *)((BYTE *)*request + length_field) = (UINT32)length + 1;
+    return status;
+}
+
+#define FIELD(name) offsetof(struct macdrv_legacy_reg_request, name)
+
+/* Serialize absolute or self-relative native descriptors without exporting
+ * any native pointer to PE32. Offset-bearing descriptors are architecture-neutral. */
+static LONG append_security(struct macdrv_legacy_reg_request **request, LPSECURITY_ATTRIBUTES attributes)
+{
+    const SECURITY_DESCRIPTOR *absolute;
+    const SECURITY_DESCRIPTOR_RELATIVE *relative;
+    const BYTE *parts[4] = {0};
+    UINT32 lengths[4] = {0}, offsets[4] = {0}, total, i, pad;
+    SECURITY_DESCRIPTOR_RELATIVE *copy;
+    SECURITY_DESCRIPTOR_CONTROL control;
+    BYTE zeros[3] = {0};
+    LONG status;
+
+    if (!attributes) return ERROR_SUCCESS;
+    if (attributes->nLength != sizeof(*attributes)) return ERROR_INVALID_PARAMETER;
+    (*request)->flags |= MACDRV_LEGACY_REG_SECURITY;
+    (*request)->type = attributes->bInheritHandle;
+    if (!(absolute = attributes->lpSecurityDescriptor)) return ERROR_SUCCESS;
+    if (absolute->Revision != SECURITY_DESCRIPTOR_REVISION) return ERROR_UNKNOWN_REVISION;
+    control = absolute->Control;
+    if (control & SE_SELF_RELATIVE)
+    {
+        relative = (const SECURITY_DESCRIPTOR_RELATIVE *)absolute;
+        offsets[0] = relative->Owner;
+        offsets[1] = relative->Group;
+        offsets[2] = (control & SE_SACL_PRESENT) ? relative->Sacl : 0;
+        offsets[3] = (control & SE_DACL_PRESENT) ? relative->Dacl : 0;
+        for (i = 0; i < 4; ++i)
+        {
+            if (!offsets[i]) continue;
+            if (offsets[i] < sizeof(*relative)) return ERROR_INVALID_SECURITY_DESCR;
+            parts[i] = (const BYTE *)relative + offsets[i];
+        }
+    }
+    else
+    {
+        parts[0] = absolute->Owner;
+        parts[1] = absolute->Group;
+        parts[2] = (control & SE_SACL_PRESENT) ? (const BYTE *)absolute->Sacl : NULL;
+        parts[3] = (control & SE_DACL_PRESENT) ? (const BYTE *)absolute->Dacl : NULL;
+    }
+    total = sizeof(*copy);
+    for (i = 0; i < 4; ++i)
+    {
+        if (!parts[i]) continue;
+        if (i < 2)
+        {
+            const SID *sid = (const SID *)parts[i];
+            if (sid->Revision != SID_REVISION || sid->SubAuthorityCount > SID_MAX_SUB_AUTHORITIES)
+                return ERROR_INVALID_SID;
+            lengths[i] = offsetof(SID, SubAuthority) + sid->SubAuthorityCount * sizeof(DWORD);
+        }
+        else
+        {
+            const ACL *acl = (const ACL *)parts[i];
+            if (acl->AclSize < sizeof(*acl)) return ERROR_INVALID_ACL;
+            lengths[i] = acl->AclSize;
+        }
+        total = (total + 3) & ~3u;
+        offsets[i] = total;
+        total += lengths[i];
+    }
+    if (!(copy = calloc(1, total))) return ERROR_NOT_ENOUGH_MEMORY;
+    copy->Revision = absolute->Revision;
+    copy->Sbz1 = absolute->Sbz1;
+    copy->Control = control | SE_SELF_RELATIVE;
+    copy->Owner = parts[0] ? offsets[0] : 0;
+    copy->Group = parts[1] ? offsets[1] : 0;
+    copy->Sacl = parts[2] ? offsets[2] : 0;
+    copy->Dacl = parts[3] ? offsets[3] : 0;
+    for (i = 0; i < 4; ++i)
+        if (parts[i]) memcpy((BYTE *)copy + offsets[i], parts[i], lengths[i]);
+    pad = (0u - (*request)->reply_offset) & 3;
+    status = pad ? append_bytes(request, zeros, pad, FIELD(data_offset)) : ERROR_SUCCESS;
+    if (!status) status = append_bytes(request, copy, total, FIELD(data_offset));
+    if (!status) (*request)->data_bytes = total;
+    free(copy);
+    return status;
+}
+
+static LONG dispatch(struct macdrv_legacy_reg_request *r, struct macdrv_legacy_reg_reply **answer)
+{
+    struct macdrv_legacy_reg_dispatch call = {0};
+    struct macdrv_legacy_reg_reply *reply;
+    MEM_ADDRESS_REQUIREMENTS requirements = {0};
+    MEM_EXTENDED_PARAMETER parameter = {0};
+    void *shared = NULL, *returned = NULL;
+    SIZE_T region_size;
+    ULONG length = 0;
+    UINT32 input_bytes = r->reply_offset, payload = 0;
+    NTSTATUS status;
+    struct registry_mapping_owner *owner;
+
+    *answer = NULL;
+    retry_pending_mapping();
+    call.dispatch.callback = (UINT64)InterlockedCompareExchange64(&callback_address, 0, 0);
+    if (!call.dispatch.callback) return ERROR_PROC_NOT_FOUND;
+    if (r->reply_offset > ~0u - 3) return ERROR_NOT_ENOUGH_MEMORY;
+    r->reply_offset = (r->reply_offset + 3) & ~3u;
+    if (r->operation == MACDRV_LEGACY_REG_QUERY && (r->flags & MACDRV_LEGACY_REG_DATA))
+    {
+        r->buffer_capacity = r->query_capacity;
+        payload = r->query_capacity ? r->query_capacity : 1;
+    }
+    if (payload > ~0u - sizeof(*reply) ||
+        r->reply_offset > ~0u - sizeof(*reply) - payload) return ERROR_NOT_ENOUGH_MEMORY;
+    r->reply_capacity = sizeof(*reply) + payload;
+    r->total_size = r->reply_offset + r->reply_capacity;
+    /* Allocate the reply before any side effect, not after opening a key. */
+    if (!(reply = malloc(r->reply_capacity))) return ERROR_NOT_ENOUGH_MEMORY;
+    if (!(owner = calloc(1, sizeof(*owner))))
+    {
+        free(reply);
+        return ERROR_NOT_ENOUGH_MEMORY;
+    }
+    requirements.LowestStartingAddress = (void *)(UINT_PTR)0x10000;
+    requirements.HighestEndingAddress = (void *)(UINT_PTR)0xffffffffu;
+    parameter.Type = MemExtendedParameterAddressRequirements;
+    parameter.Pointer = &requirements;
+    region_size = r->total_size;
+    status = NtAllocateVirtualMemoryEx(NtCurrentProcess(), &shared, &region_size,
+            MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE, &parameter, 1);
+    if (status)
+    {
+        free(owner);
+        free(reply);
+        return RtlNtStatusToDosError(status);
+    }
+    owner->base = shared;
+    owner->size = region_size;
+    if ((UINT64)(UINT_PTR)shared > 0xffffffffu ||
+        region_size > 0x100000000ULL - (UINT64)(UINT_PTR)shared)
+        status = STATUS_INVALID_ADDRESS;
+    else
+    {
+        memcpy(shared, r, input_bytes);
+        call.magic = MACDRV_LEGACY_REG_MAGIC;
+        call.version = MACDRV_LEGACY_REG_VERSION;
+        call.packet = (UINT_PTR)shared;
+        call.packet_size = r->total_size;
+        status = KeUserDispatchCallback(&call.dispatch, sizeof(call), &returned, &length);
+        if (!status)
+        {
+            if (returned != (BYTE *)shared + r->reply_offset ||
+                length < sizeof(*reply) || length > r->reply_capacity) status = STATUS_DATA_ERROR;
+            else memcpy(reply, returned, length);
+        }
+    }
+    release_mapping(owner);
+    if (status)
+    {
+        free(reply);
+        return RtlNtStatusToDosError(status);
+    }
+    if (reply->magic != MACDRV_LEGACY_REG_MAGIC || reply->version != MACDRV_LEGACY_REG_VERSION ||
+        reply->operation != r->operation || reply->flags != r->flags || reply->zero ||
+        reply->total_size != length || reply->data_bytes != length - sizeof(*reply)) { free(reply); return ERROR_INVALID_DATA; }
+    if (r->operation == MACDRV_LEGACY_REG_QUERY)
+    {
+        if ((reply->status == ERROR_SUCCESS && (r->flags & MACDRV_LEGACY_REG_DATA)) ?
+            (reply->data_bytes != reply->value_size || reply->data_bytes > r->buffer_capacity) : reply->data_bytes)
+            { free(reply); return ERROR_INVALID_DATA; }
+        if (reply->key || reply->disposition) { free(reply); return ERROR_INVALID_DATA; }
+    }
+    else if (reply->data_bytes || reply->type || reply->value_size) { free(reply); return ERROR_INVALID_DATA; }
+    if (r->operation == MACDRV_LEGACY_REG_OPEN || r->operation == MACDRV_LEGACY_REG_CREATE)
+    {
+        if ((reply->status == ERROR_SUCCESS) != !!reply->key) { free(reply); return ERROR_INVALID_DATA; }
+    }
+    else if (reply->key || reply->disposition) { free(reply); return ERROR_INVALID_DATA; }
+    *answer = reply;
+    return (LONG)reply->status;
+}
+
+LONG WINAPI macdrv_legacy_RegQueryValueExA(HKEY key, LPCSTR name, LPDWORD reserved,
+                                         LPDWORD type, BYTE *data, LPDWORD count)
+{
+    struct macdrv_legacy_reg_request *r;
+    struct macdrv_legacy_reg_reply *reply = NULL;
+    LONG status;
+    if (reserved || (data && !count)) return ERROR_INVALID_PARAMETER;
+    if (!(r = new_request(MACDRV_LEGACY_REG_QUERY, key, &status))) return status;
+    r->flags = (type ? MACDRV_LEGACY_REG_TYPE : 0) | (data ? MACDRV_LEGACY_REG_DATA : 0) |
+               (count ? MACDRV_LEGACY_REG_SIZE : 0);
+    /* Type is out-only; size is out-only for a size query. Do not read either
+     * caller variable before the API is required to consume its value. */
+    r->query_capacity = data ? *count : 0;
+    if (!(status = append_string(&r, name, FIELD(name_offset), FIELD(name_bytes))))
+    {
+        status = dispatch(r, &reply);
+        if (reply && (status == ERROR_SUCCESS || status == ERROR_MORE_DATA))
+        {
+            if (type) *type = reply->type;
+            if (count) *count = reply->value_size;
+            if (!status && data && reply->data_bytes) memcpy(data, reply + 1, reply->data_bytes);
+        }
+    }
+    free(reply);
+    free(r);
+    return status;
+}
+
+LONG WINAPI macdrv_legacy_RegSetValueExA(HKEY key, LPCSTR name, DWORD reserved,
+                                       DWORD type, const BYTE *data, DWORD count)
+{
+    struct macdrv_legacy_reg_request *r;
+    struct macdrv_legacy_reg_reply *reply = NULL;
+    LONG status;
+    if (!data && count) return ERROR_INVALID_PARAMETER;
+    if (!(r = new_request(MACDRV_LEGACY_REG_SET, key, &status))) return status;
+    r->flags = data ? MACDRV_LEGACY_REG_DATA : 0;
+    r->reserved = reserved;
+    r->type = type;
+    r->data_bytes = count;
+    if (!(status = append_string(&r, name, FIELD(name_offset), FIELD(name_bytes))) &&
+        (!data || !(status = append_bytes(&r, data, count, FIELD(data_offset))))) status = dispatch(r, &reply);
+    free(reply);
+    free(r);
+    return status;
+}
+
+static LONG open_key(UINT32 op, HKEY key, LPCSTR name, DWORD reserved, LPSTR class_name,
+                     DWORD options, REGSAM access, LPSECURITY_ATTRIBUTES security, HKEY *opened, LPDWORD disposition)
+{
+    struct macdrv_legacy_reg_request *r;
+    struct macdrv_legacy_reg_reply *reply = NULL;
+    LONG status;
+    if (!opened) return ERROR_INVALID_PARAMETER;
+    if (!(r = new_request(op, key, &status))) return status;
+    r->reserved = reserved;
+    r->options = options;
+    r->access = access;
+    r->flags = disposition ? MACDRV_LEGACY_REG_DISPOSITION : 0;
+    if (!(status = append_string(&r, name, FIELD(name_offset), FIELD(name_bytes))) &&
+        !(status = append_string(&r, class_name, FIELD(class_offset), FIELD(class_bytes))) &&
+        !(status = append_security(&r, security)))
+    {
+        status = dispatch(r, &reply);
+        if (!status)
+        {
+            *opened = (HKEY)(LONG_PTR)(LONG)reply->key;
+            if (disposition) *disposition = reply->disposition;
+        }
+    }
+    free(reply);
+    free(r);
+    return status;
+}
+
+LONG WINAPI macdrv_legacy_RegOpenKeyExA(HKEY key, LPCSTR name, DWORD options, REGSAM access, HKEY *opened)
+{
+    return open_key(MACDRV_LEGACY_REG_OPEN, key, name, 0, NULL, options, access, NULL, opened, NULL);
+}
+
+LONG WINAPI macdrv_legacy_RegCreateKeyExA(HKEY key, LPCSTR name, DWORD reserved, LPSTR class_name,
+                                        DWORD options, REGSAM access, LPSECURITY_ATTRIBUTES security,
+                                        HKEY *opened, LPDWORD disposition)
+{
+    if (!opened) return ERROR_INVALID_PARAMETER;
+    return open_key(MACDRV_LEGACY_REG_CREATE, key, name, reserved, class_name, options, access, security, opened, disposition);
+}
+
+LONG WINAPI macdrv_legacy_RegCloseKey(HKEY key)
+{
+    struct macdrv_legacy_reg_request *r;
+    struct macdrv_legacy_reg_reply *reply = NULL;
+    LONG status;
+    if (!(r = new_request(MACDRV_LEGACY_REG_CLOSE, key, &status))) return status;
+    status = dispatch(r, &reply);
+    free(reply);
+    free(r);
+    return status;
+}
