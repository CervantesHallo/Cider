+/* PE-only full unit. No caller data/result address is taken from the wire. */
+#include <stdarg.h>
+#include <string.h>
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winbase.h"
+#include "winreg.h"
+#include "winternl.h"
+#include "legacy_registry.h"
+
+static BOOL input_range(const struct macdrv_legacy_reg_request *r, UINT32 off, UINT32 len)
+{
+    return off >= sizeof(*r) && off <= r->reply_offset && len <= r->reply_offset - off;
+}
+
+static BOOL wire_string(const struct macdrv_legacy_reg_request *r, BYTE *packet,
+                        UINT32 off, UINT32 len, char **str)
+{
+    *str = NULL;
+    if (!off && !len) return TRUE;
+    if (!off || !len || !input_range(r, off, len)) return FALSE;
+    if (memchr(packet + off, 0, len) != packet + off + len - 1) return FALSE;
+    *str = (char *)packet + off;
+    return TRUE;
+}
+
+static HKEY decode_key(UINT32 key)
+{
+    return (HKEY)(LONG_PTR)(LONG)key;
+}
+
+static BOOL encode_key(HKEY key, UINT32 *wire)
+{
+    UINT_PTR value = (UINT_PTR)key;
+    *wire = (UINT32)value;
+#ifdef _WIN64
+    return value == (UINT_PTR)*wire || value == (UINT_PTR)(LONG_PTR)(LONG)*wire;
+#else
+    return TRUE;
+#endif
+}
+
+static BOOL relative_descriptor(const BYTE *bytes, UINT32 length)
+{
+    const SECURITY_DESCRIPTOR_RELATIVE *descriptor;
+    UINT32 offsets[4], i, offset, part_length;
+
+    if (length < sizeof(*descriptor)) return FALSE;
+    descriptor = (const SECURITY_DESCRIPTOR_RELATIVE *)bytes;
+    if (descriptor->Revision != SECURITY_DESCRIPTOR_REVISION || !(descriptor->Control & SE_SELF_RELATIVE))
+        return FALSE;
+    offsets[0] = descriptor->Owner;
+    offsets[1] = descriptor->Group;
+    offsets[2] = (descriptor->Control & SE_SACL_PRESENT) ? descriptor->Sacl : 0;
+    offsets[3] = (descriptor->Control & SE_DACL_PRESENT) ? descriptor->Dacl : 0;
+    for (i = 0; i < 4; ++i)
+    {
+        offset = offsets[i];
+        if (!offset) continue;
+        if (offset < sizeof(*descriptor) || offset > length) return FALSE;
+        if (i < 2)
+        {
+            const SID *sid;
+            if (length - offset < offsetof(SID, SubAuthority)) return FALSE;
+            sid = (const SID *)(bytes + offset);
+            if (sid->Revision != SID_REVISION || sid->SubAuthorityCount > SID_MAX_SUB_AUTHORITIES) return FALSE;
+            part_length = offsetof(SID, SubAuthority) + sid->SubAuthorityCount * sizeof(DWORD);
+        }
+        else
+        {
+            const ACL *acl;
+            if (length - offset < sizeof(*acl)) return FALSE;
+            acl = (const ACL *)(bytes + offset);
+            part_length = acl->AclSize;
+            if (part_length < sizeof(*acl)) return FALSE;
+        }
+        if (part_length > length - offset) return FALSE;
+    }
+    return TRUE;
+}
+
+NTSTATUS WINAPI macdrv_legacy_registry_callback(void *args, ULONG size)
+{
+    struct macdrv_legacy_reg_request r;
+    struct macdrv_legacy_reg_dispatch envelope;
+    struct macdrv_legacy_reg_reply *reply;
+    BYTE *packet, *data = NULL;
+    char *name, *class_name;
+    HKEY opened = NULL;
+    DWORD type, count, disposition = 0;
+    LONG status;
+    UINT32 allowed;
+    NTSTATUS returned;
+    SECURITY_ATTRIBUTES attributes = {sizeof(attributes), NULL, FALSE};
+
+    if (!args || size != sizeof(envelope)) return STATUS_INVALID_PARAMETER;
+    memcpy(&envelope, args, sizeof(envelope));
+    if (envelope.magic != MACDRV_LEGACY_REG_MAGIC || envelope.version != MACDRV_LEGACY_REG_VERSION ||
+        envelope.zero || envelope.packet < 0x10000 || envelope.packet > 0xffffffffu ||
+        envelope.packet_size < sizeof(r) ||
+        envelope.packet_size > 0x100000000ULL - envelope.packet) return STATUS_INVALID_PARAMETER;
+    packet = (BYTE *)(UINT_PTR)envelope.packet;
+    memcpy(&r, packet, sizeof(r));
+    if (r.magic != MACDRV_LEGACY_REG_MAGIC || r.version != MACDRV_LEGACY_REG_VERSION ||
+        r.total_size != envelope.packet_size || r.zero || r.reserved0 || r.reply_offset < sizeof(r) ||
+        (r.reply_offset & 3) || r.reply_offset > r.total_size ||
+        r.reply_capacity != r.total_size - r.reply_offset || r.reply_capacity < sizeof(*reply))
+        return STATUS_INVALID_PARAMETER;
+
+    switch (r.operation)
+    {
+    case MACDRV_LEGACY_REG_QUERY:
+        allowed = MACDRV_LEGACY_REG_TYPE | MACDRV_LEGACY_REG_DATA | MACDRV_LEGACY_REG_SIZE;
+        break;
+    case MACDRV_LEGACY_REG_SET: allowed = MACDRV_LEGACY_REG_DATA; break;
+    case MACDRV_LEGACY_REG_CREATE:
+        allowed = MACDRV_LEGACY_REG_DISPOSITION | MACDRV_LEGACY_REG_SECURITY;
+        break;
+    case MACDRV_LEGACY_REG_OPEN:
+    case MACDRV_LEGACY_REG_CLOSE: allowed = 0; break;
+    default: return STATUS_INVALID_PARAMETER;
+    }
+    if ((r.flags & ~allowed) ||
+        !wire_string(&r, packet, r.name_offset, r.name_bytes, &name) ||
+        !wire_string(&r, packet, r.class_offset, r.class_bytes, &class_name))
+        return STATUS_INVALID_PARAMETER;
+    if (r.operation != MACDRV_LEGACY_REG_CREATE && class_name) return STATUS_INVALID_PARAMETER;
+    if (r.operation == MACDRV_LEGACY_REG_CLOSE && name) return STATUS_INVALID_PARAMETER;
+    if (r.operation != MACDRV_LEGACY_REG_SET &&
+        !(r.operation == MACDRV_LEGACY_REG_CREATE && (r.flags & MACDRV_LEGACY_REG_SECURITY)) &&
+        (r.data_offset || r.data_bytes))
+        return STATUS_INVALID_PARAMETER;
+    if (r.operation != MACDRV_LEGACY_REG_QUERY && r.buffer_capacity)
+        return STATUS_INVALID_PARAMETER;
+
+    reply = (struct macdrv_legacy_reg_reply *)(packet + r.reply_offset);
+    memset(reply, 0, sizeof(*reply));
+    reply->magic = MACDRV_LEGACY_REG_MAGIC;
+    reply->version = MACDRV_LEGACY_REG_VERSION;
+    reply->operation = r.operation;
+    reply->flags = r.flags;
+    reply->total_size = sizeof(*reply);
+
+    switch (r.operation)
+    {
+    case MACDRV_LEGACY_REG_QUERY:
+        if (r.reserved || ((r.flags & MACDRV_LEGACY_REG_DATA) && !(r.flags & MACDRV_LEGACY_REG_SIZE)))
+            return STATUS_INVALID_PARAMETER;
+        if (r.buffer_capacity > r.query_capacity ||
+            r.buffer_capacity > r.reply_capacity - sizeof(*reply) ||
+            ((r.flags & MACDRV_LEGACY_REG_DATA) && r.reply_capacity == sizeof(*reply)))
+            return STATUS_INVALID_PARAMETER;
+        type = 0;
+        count = (r.flags & MACDRV_LEGACY_REG_DATA) ? r.buffer_capacity : r.query_capacity;
+        if (r.flags & MACDRV_LEGACY_REG_DATA) data = (BYTE *)(reply + 1);
+        status = RegQueryValueExA(decode_key(r.key), name, NULL,
+                (r.flags & MACDRV_LEGACY_REG_TYPE) ? &type : NULL, data,
+                (r.flags & MACDRV_LEGACY_REG_SIZE) ? &count : NULL);
+        reply->type = type;
+        reply->value_size = count;
+        if (status == ERROR_SUCCESS && data)
+        {
+            if (count > r.buffer_capacity) return STATUS_DATA_ERROR;
+            reply->data_bytes = count;
+            reply->total_size += count;
+        }
+        break;
+    case MACDRV_LEGACY_REG_SET:
+        if (r.flags & MACDRV_LEGACY_REG_DATA)
+        {
+            if (!r.data_offset || !input_range(&r, r.data_offset, r.data_bytes ? r.data_bytes : 1))
+                return STATUS_INVALID_PARAMETER;
+            data = packet + r.data_offset;
+        }
+        else if (r.data_offset || r.data_bytes) return STATUS_INVALID_PARAMETER;
+        status = RegSetValueExA(decode_key(r.key), name, r.reserved, r.type, data, r.data_bytes);
+        break;
+    case MACDRV_LEGACY_REG_OPEN:
+        status = RegOpenKeyExA(decode_key(r.key), name, r.options, r.access, &opened);
+        break;
+    case MACDRV_LEGACY_REG_CREATE:
+        if (r.flags & MACDRV_LEGACY_REG_SECURITY)
+        {
+            attributes.bInheritHandle = r.type;
+            if (r.data_offset || r.data_bytes)
+            {
+                if (!r.data_offset || (r.data_offset & 3) || !input_range(&r, r.data_offset, r.data_bytes) ||
+                    !relative_descriptor(packet + r.data_offset, r.data_bytes)) return STATUS_INVALID_SECURITY_DESCR;
+                attributes.lpSecurityDescriptor = packet + r.data_offset;
+            }
+        }
+        status = RegCreateKeyExA(decode_key(r.key), name, r.reserved, class_name,
+                r.options, r.access, (r.flags & MACDRV_LEGACY_REG_SECURITY) ? &attributes : NULL, &opened,
+                (r.flags & MACDRV_LEGACY_REG_DISPOSITION) ? &disposition : NULL);
+        break;
+    default:
+        status = RegCloseKey(decode_key(r.key));
+        break;
+    }
+
+    if (r.operation == MACDRV_LEGACY_REG_OPEN || r.operation == MACDRV_LEGACY_REG_CREATE)
+    {
+        if (status == ERROR_SUCCESS && (!opened || !encode_key(opened, &reply->key)))
+        {
+            if (opened) RegCloseKey(opened);
+            opened = NULL;
+            reply->key = 0;
+            status = ERROR_NOT_SUPPORTED;
+        }
+        if (status == ERROR_SUCCESS) reply->disposition = disposition;
+    }
+    reply->status = status;
+    /* The native owner retains the shared mapping through this callback return.
+     * NtCallbackReturn normally unwinds and does not return to this statement. */
+    returned = NtCallbackReturn(reply, reply->total_size, STATUS_SUCCESS);
+    if (opened && status == ERROR_SUCCESS) RegCloseKey(opened);
+    return returned;
+}
