+static void legacy_init_display_devices(BOOL force)
+{
+    UINT32 paths = 0, modes = 0;
+    LONG status;
+    /* Wine now owns display-cache refresh through its display-config path. */
+    status = NtUserGetDisplayConfigBufferSizes(QDC_ONLY_ACTIVE_PATHS, &paths, &modes);
+    TRACE("legacy display init force %d, status %ld, paths %u modes %u\n", force, (long)status, paths, modes);
+}
