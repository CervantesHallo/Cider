+/* Native/PE registry bridge. The fixed callback frame contains a code address
+ * and one explicit packet address belonging to a checked guest-visible VM
+ * allocation. Caller strings, buffers, descriptors and output pointers never
+ * cross directly; packet members are fixed-width values and relative offsets.
+ */
+#ifndef __CIDER_LEGACY_REGISTRY_H
+#define __CIDER_LEGACY_REGISTRY_H
+
+#include <stddef.h>
+#include "ntuser.h"
+#include "winreg.h"
+
+#define MACDRV_LEGACY_REG_MAGIC 0x3147524dU
+#define MACDRV_LEGACY_REG_VERSION 2U
+/* Only this fixed-size envelope is copied onto the PE callback stack.
+ * The packet is an explicitly owned, guest-addressable VM allocation. */
+struct macdrv_legacy_reg_dispatch
+{
+    struct dispatch_callback_params dispatch;
+    UINT32 magic, version;
+    UINT64 packet;
+    UINT32 packet_size, zero;
+};
+C_ASSERT(sizeof(struct macdrv_legacy_reg_dispatch) == 32);
+
+enum macdrv_legacy_reg_op
+{
+    MACDRV_LEGACY_REG_QUERY = 1,
+    MACDRV_LEGACY_REG_SET,
+    MACDRV_LEGACY_REG_OPEN,
+    MACDRV_LEGACY_REG_CREATE,
+    MACDRV_LEGACY_REG_CLOSE
+};
+
+#define MACDRV_LEGACY_REG_TYPE       0x01U
+#define MACDRV_LEGACY_REG_DATA       0x02U
+#define MACDRV_LEGACY_REG_SIZE       0x04U
+#define MACDRV_LEGACY_REG_DISPOSITION 0x08U
+#define MACDRV_LEGACY_REG_SECURITY   0x10U
+
+struct macdrv_legacy_reg_request
+{
+    struct dispatch_callback_params dispatch;
+    UINT32 magic, version, operation, total_size;
+    UINT32 key, flags;
+    UINT32 reserved, type, options, access;
+    UINT32 name_offset, name_bytes;
+    UINT32 class_offset, class_bytes;
+    UINT32 data_offset, data_bytes;
+    UINT32 query_capacity, reserved0;
+    UINT32 reply_offset, reply_capacity;
+    UINT32 buffer_capacity, zero;
+};
+
+struct macdrv_legacy_reg_reply
+{
+    UINT32 magic, version, operation, total_size;
+    UINT32 status, type, value_size, data_bytes;
+    UINT32 key, disposition, flags, zero;
+    /* Returned query bytes immediately follow. Never a PE/native pointer. */
+};
+
+C_ASSERT(sizeof(struct dispatch_callback_params) == 8);
+C_ASSERT(sizeof(struct macdrv_legacy_reg_request) == 96);
+C_ASSERT(offsetof(struct macdrv_legacy_reg_request, key) == 24);
+C_ASSERT(offsetof(struct macdrv_legacy_reg_request, reply_offset) == 80);
+C_ASSERT(sizeof(struct macdrv_legacy_reg_reply) == 48);
+
+/* A separate appended Unix-call entry leaves existing init_params unchanged. */
+struct macdrv_legacy_reg_init
+{
+    UINT64 callback;
+    UINT32 magic, version;
+};
+C_ASSERT(sizeof(struct macdrv_legacy_reg_init) == 16);
+
+/* PE entrypoint; its code address is registered, not exported as a table. */
+NTSTATUS WINAPI macdrv_legacy_registry_callback(void *args, ULONG size);
+
+/* Native initialization: one stable PE callback address per process/bitted driver. */
+NTSTATUS macdrv_legacy_registry_initialize(UINT64 callback);
+NTSTATUS macdrv_legacy_registry_init(void *args);
+LONG WINAPI macdrv_legacy_RegQueryValueExA(HKEY, LPCSTR, LPDWORD, LPDWORD, BYTE *, LPDWORD);
+LONG WINAPI macdrv_legacy_RegSetValueExA(HKEY, LPCSTR, DWORD, DWORD, const BYTE *, DWORD);
+LONG WINAPI macdrv_legacy_RegOpenKeyExA(HKEY, LPCSTR, DWORD, REGSAM, HKEY *);
+LONG WINAPI macdrv_legacy_RegCreateKeyExA(HKEY, LPCSTR, DWORD, LPSTR, DWORD, REGSAM,
+                                       LPSECURITY_ATTRIBUTES, HKEY *, LPDWORD);
+LONG WINAPI macdrv_legacy_RegCloseKey(HKEY);
+
+#endif
