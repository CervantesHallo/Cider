+static BOOL remote_window(HWND hwnd)
+{
+    DWORD pid = 0, root_pid = 0;
+    HWND root = NtUserGetAncestor(hwnd, GA_ROOT);
+    if (!NtUserGetWindowThread(hwnd, &pid) || !NtUserGetWindowThread(root, &root_pid)) return FALSE;
+    return pid != GetCurrentProcessId() || root_pid != GetCurrentProcessId();
+}
+/* Before a foreign snapshot is returned, reserve native owners and establish
+ * its Wine recovery timer. An ARM failure has acquired no remote resources
+ * and is cleaned synchronously by this still-Wine-thread snapshot call. */
+static BOOL prepare_remote_owner(struct legacy_surface *entry)
+{
+    struct macdrv_remote_renderer *client;
+    DWORD error;
+    if (pthread_main_np() || !(client = macdrv_remote_renderer_alloc(entry->surface->client.hwnd))) return FALSE;
+    pthread_mutex_lock(&legacy_lock);
+    entry->creating = TRUE; entry->remote = client; entry->remote_owner = TRUE;
+    entry->remote_init_waiting = TRUE; ++entry->refs;
+    entry->surface_owner = TRUE; ++entry->refs; entry->surface->legacy_remote_owner = entry;
+    pthread_mutex_unlock(&legacy_lock);
+    error = macdrv_remote_arm_client_recovery();
+    pthread_mutex_lock(&legacy_lock);
+    entry->creating = FALSE;
+    if (error)
+    {
+        entry->remote = NULL; entry->remote_owner = FALSE; entry->remote_init_waiting = FALSE;
+        entry->surface_owner = FALSE; entry->surface->legacy_remote_owner = NULL;
+    }
+    pthread_mutex_unlock(&legacy_lock);
+    if (error)
+    {
+        macdrv_remote_renderer_free(client); /* no route/context was started */
+        legacy_surface_release(entry, FALSE); legacy_surface_release(entry, FALSE);
+    }
+    return !error;
+}
+static BOOL create_remote_renderer(struct legacy_surface *entry, id_MTLDevice device)
+{
+    struct macdrv_remote_renderer *client;
+    BOOL waiting, ready, done = FALSE;
+    DWORD error;
+    pthread_mutex_lock(&legacy_lock);
+    client = entry->remote; waiting = entry->remote_init_waiting; ready = entry->remote_ready;
+    if (waiting) entry->remote_init_waiting = FALSE;
+    pthread_mutex_unlock(&legacy_lock);
+    if (!client) return FALSE;
+    if (!waiting) return ready && macdrv_remote_renderer_device_matches(client, device);
+    error = macdrv_remote_renderer_start(client, device);
+    if (error) done = macdrv_remote_renderer_progress(client, MACDRV_RENDERER_STOP, FALSE);
+    pthread_mutex_lock(&legacy_lock);
+    entry->remote_ready = !error;
+    if (done) {entry->remote = NULL; entry->remote_owner = FALSE;}
+    pthread_mutex_unlock(&legacy_lock);
+    if (done) {macdrv_remote_renderer_free(client); legacy_surface_release(entry, FALSE);}
+    if (error) WARN("remote renderer creation failed %u; actual partial owner %s\n",
+                    (unsigned)error, done ? "settled locally" : "retained");
+    return !error;
+}
