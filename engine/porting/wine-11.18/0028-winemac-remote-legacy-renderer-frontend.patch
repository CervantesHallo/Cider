+/* One process-lifetime PE dispatcher, not a surface or foreign-HWND registry.
+ * The registry and its failed/stopped incarnation intentionally remain allocated.
+ * NT handle ownership is separate: only diagnostic STOP may close it, after a
+ * real kernel-thread join and the worker's checked window destruction. */
+#include <stdarg.h>
+#include <string.h>
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winbase.h"
+#include "winuser.h"
+#include "winternl.h"
+#include "unixlib.h"
+#include "remote_client.h"
+#include "wine/debug.h"
+WINE_DEFAULT_DEBUG_CHANNEL(macdrv);
+
+struct remote_client
+{
+    ULONG api_pins;
+    BOOL initializing, cleanup_active, stopping;
+    BOOL ready_published, ready_signaled, worker_finishing;
+    BOOL thread_created, joined, window_created, window_destroyed;
+    BOOL class_owned, class_unregistered;
+    DWORD startup_error, worker_error, destroy_error, stop_error, cleanup_error;
+    HANDLE ready, stop, thread;
+    HMODULE module;
+    HWND window;
+    DWORD thread_id;
+};
+static SRWLOCK client_lock = SRWLOCK_INIT;
+static struct remote_client *client;
+static DWORD allocation_error;
+static const WCHAR module_anchor;
+
+static DWORD client_last_error(void)
+{
+    DWORD error = GetLastError();
+    return error ? error : ERROR_GEN_FAILURE;
+}
+
+static LRESULT CALLBACK client_window_proc(HWND window, UINT message, WPARAM wparam, LPARAM lparam)
+{
+    struct remote_client *owner;
+    struct macdrv_remote_client_event event = {0};
+    NTSTATUS status;
+    BOOL enabled;
+
+    if (message == WM_NCCREATE)
+    {
+        CREATESTRUCTW *create = (CREATESTRUCTW *)lparam;
+        DWORD error;
+        owner = create->lpCreateParams;
+        if (!owner) return FALSE;
+        AcquireSRWLockExclusive(&client_lock);
+        owner->window = window;
+        owner->window_created = TRUE; /* actual USER object, startup not yet acknowledged */
+        ReleaseSRWLockExclusive(&client_lock);
+        SetLastError(ERROR_SUCCESS);
+        if (!SetWindowLongPtrW(window, GWLP_USERDATA, (LONG_PTR)owner) && (error = GetLastError()))
+        {
+            AcquireSRWLockExclusive(&client_lock); owner->startup_error = error; ReleaseSRWLockExclusive(&client_lock);
+            return FALSE;
+        }
+    }
+    owner = (struct remote_client *)GetWindowLongPtrW(window, GWLP_USERDATA);
+    if (!owner && message == WM_NCDESTROY)
+    {
+        AcquireSRWLockShared(&client_lock);
+        if (client && client->window == window) owner = client; /* failed userdata setup, stable registry */
+        ReleaseSRWLockShared(&client_lock);
+    }
+    if (message == WM_NCDESTROY && owner)
+    {
+        HANDLE stop = NULL;
+        AcquireSRWLockExclusive(&client_lock);
+        if (owner->window == window)
+        {
+            owner->window = NULL; owner->window_destroyed = TRUE;
+            owner->worker_finishing = TRUE; owner->stopping = TRUE; stop = owner->stop;
+        }
+        ReleaseSRWLockExclusive(&client_lock);
+        if (stop && !SetEvent(stop))
+        {
+            DWORD error = client_last_error();
+            AcquireSRWLockExclusive(&client_lock); owner->stop_error = error; ReleaseSRWLockExclusive(&client_lock);
+        }
+        PostQuitMessage(0); /* orderly completion even when the stop signal failed */
+        return DefWindowProcW(window, message, wparam, lparam);
+    }
+    if (message != WM_MACDRV_REMOTE_CLIENT_WAKE)
+        return DefWindowProcW(window, message, wparam, lparam);
+    if (!owner) return 0;
+    AcquireSRWLockShared(&client_lock);
+    enabled = owner->window == window && owner->ready_signaled &&
+              !owner->startup_error && !owner->stopping && !owner->worker_finishing;
+    ReleaseSRWLockShared(&client_lock);
+    if (!enabled) return 0;
+
+    event.size = sizeof(event);
+    event.version = MACDRV_REMOTE_CLIENT_VERSION;
+    event.operation = MACDRV_CLIENT_EVENT_WAKE;
+    event.window = HandleToULong(window);
+    event.generation = (UINT64)(UINT32)wparam | ((UINT64)(UINT32)lparam << 32);
+    event.thread = GetCurrentThreadId();
+    /* Neither message word is a pointer, ticket, or destruction authority.
+     * Generation zero requests an advisory poll of all producer generations.
+     * Native consumers must independently validate their RO state/identities. */
+    status = MACDRV_CALL(remote_client_event, &event);
+    if (status) WARN("remote client wake failed %#x\n", (unsigned int)status);
+    return 0;
+}
+
+static DWORD publish_startup(struct remote_client *owner, DWORD error)
+{
+    AcquireSRWLockExclusive(&client_lock);
+    if (!owner->startup_error) owner->startup_error = error;
+    owner->ready_published = TRUE;
+    /* Publish the outcome and the actual signaling result together. A failed
+     * SetEvent is sticky even when class/window creation succeeded. */
+    if (SetEvent(owner->ready)) owner->ready_signaled = TRUE;
+    else if (!owner->startup_error) owner->startup_error = client_last_error();
+    error = owner->startup_error;
+    ReleaseSRWLockExclusive(&client_lock);
+    return error;
+}
+
+static DWORD WINAPI client_worker(void *context)
+{
+    struct remote_client *owner = context;
+    WNDCLASSW class = {0};
+    HWND window = NULL;
+    HANDLE stop;
+    MSG message;
+    DWORD result, error = ERROR_SUCCESS, destroy_error = ERROR_SUCCESS;
+    BOOL destroyed;
+
+    AcquireSRWLockExclusive(&client_lock);
+    owner->thread_id = GetCurrentThreadId();
+    stop = owner->stop;
+    class.hInstance = owner->module;
+    ReleaseSRWLockExclusive(&client_lock);
+    result = WaitForSingleObject(stop, 0);
+    if (result != WAIT_TIMEOUT)
+        error = result == WAIT_OBJECT_0 ? ERROR_OPERATION_ABORTED :
+                result == WAIT_FAILED ? client_last_error() : ERROR_INVALID_DATA;
+    if (!error)
+    {
+        class.lpfnWndProc = client_window_proc;
+        class.lpszClassName = MACDRV_REMOTE_CLIENT_CLASS_NAMEW;
+        if (!RegisterClassW(&class)) error = client_last_error();
+        else
+        {
+            AcquireSRWLockExclusive(&client_lock);
+            owner->class_owned = TRUE;
+            ReleaseSRWLockExclusive(&client_lock);
+            window = CreateWindowExW(0, MACDRV_REMOTE_CLIENT_CLASS_NAMEW, NULL, 0,
+                                     0, 0, 0, 0, HWND_MESSAGE, NULL, class.hInstance, owner);
+            if (!window) error = client_last_error();
+            else
+            {
+                AcquireSRWLockShared(&client_lock);
+                if (owner->window != window || owner->window_destroyed) error = ERROR_OPERATION_ABORTED;
+                ReleaseSRWLockShared(&client_lock);
+            }
+        }
+    }
+    /* STOP may have arrived during the lock-free USER initialization. */
+    if (!error)
+    {
+        result = WaitForSingleObject(stop, 0);
+        if (result != WAIT_TIMEOUT)
+            error = result == WAIT_OBJECT_0 ? ERROR_OPERATION_ABORTED :
+                    result == WAIT_FAILED ? client_last_error() : ERROR_INVALID_DATA;
+    }
+    error = publish_startup(owner, error);
+    while (!error)
+    {
+        result = MsgWaitForMultipleObjectsEx(1, &stop, INFINITE, QS_ALLINPUT, MWMO_INPUTAVAILABLE);
+        if (result == WAIT_OBJECT_0) break;
+        if (result != WAIT_OBJECT_0 + 1)
+        {
+            error = result == WAIT_FAILED ? client_last_error() : ERROR_INVALID_DATA;
+            break;
+        }
+        while (PeekMessageW(&message, NULL, 0, 0, PM_REMOVE))
+        {
+            if (message.message == WM_QUIT)
+            {
+                error = ERROR_OPERATION_ABORTED;
+                goto finished;
+            }
+            TranslateMessage(&message);
+            DispatchMessageW(&message);
+            /* A busy producer cannot starve diagnostic STOP. No idle polling. */
+            result = WaitForSingleObject(stop, 0);
+            if (result == WAIT_OBJECT_0) goto finished;
+            if (result != WAIT_TIMEOUT)
+            {
+                error = result == WAIT_FAILED ? client_last_error() : ERROR_INVALID_DATA;
+                goto finished;
+            }
+        }
+    }
+finished:
+    AcquireSRWLockExclusive(&client_lock);
+    owner->worker_finishing = TRUE;
+    owner->worker_error = error;
+    ReleaseSRWLockExclusive(&client_lock);
+    if (window)
+    {
+        AcquireSRWLockShared(&client_lock); destroyed = owner->window_destroyed; ReleaseSRWLockShared(&client_lock);
+        if (!destroyed)
+        {
+            destroyed = DestroyWindow(window);
+            if (!destroyed) destroy_error = client_last_error();
+            AcquireSRWLockExclusive(&client_lock);
+            owner->destroy_error = destroy_error;
+            if (destroyed) {owner->window_destroyed = TRUE; owner->window = NULL;}
+            /* WM_NCDESTROY's real observation is not undone by a late failure. */
+            ReleaseSRWLockExclusive(&client_lock);
+        }
+    }
+    /* Returning is not a join, nor evidence that DestroyWindow succeeded.
+     * State/GWLP_USERDATA remain valid even on the failure path. */
+    return error ? error : destroy_error;
+}
+
+static void initialize_client(struct remote_client *owner)
+{
+    HMODULE module = NULL;
+    DWORD error = ERROR_SUCCESS, thread_id = 0;
+
+    /* Parent initialization already pins this callback module. Verify/pin the
+     * worker and WNDPROC's containing module here, outside DllMain and our lock. */
+    if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_PIN,
+                            &module_anchor, &module)) error = client_last_error();
+    AcquireSRWLockExclusive(&client_lock);
+    owner->module = module;
+    if (!error && owner->stopping) error = ERROR_OPERATION_ABORTED;
+    /* These kernel calls do not pump USER messages or wait. Each returned
+     * handle is immediately owned by the permanent registry, including every
+     * partial-construction failure. The worker publishes under this same lock. */
+    if (!error && !(owner->ready = CreateEventW(NULL, TRUE, FALSE, NULL))) error = client_last_error();
+    if (!error && !(owner->stop = CreateEventW(NULL, TRUE, FALSE, NULL))) error = client_last_error();
+    if (!error)
+    {
+        owner->thread = CreateThread(NULL, 0, client_worker, owner, 0, &thread_id);
+        if (owner->thread)
+        {
+            owner->thread_created = TRUE;
+            owner->thread_id = thread_id;
+        }
+        else error = client_last_error();
+    }
+    if (error)
+    {
+        owner->startup_error = error;
+        owner->ready_published = TRUE;
+    }
+    owner->initializing = FALSE;
+    ReleaseSRWLockExclusive(&client_lock);
+}
+
+/* All helpers with a _locked suffix require client_lock. */
+static BOOL cleanup_complete_locked(const struct remote_client *owner)
+{
+    return !owner->initializing && (!owner->thread_created || owner->joined) &&
+           (!owner->window_created || owner->window_destroyed) && !owner->class_owned &&
+           !owner->thread && !owner->ready && !owner->stop;
+}
+
+static void reply_state_locked(const struct remote_client *owner, struct macdrv_remote_client_reply *reply)
+{
+    reply->window = HandleToULong(owner->window);
+    reply->thread = owner->thread_id;
+    reply->flags = 0;
+    if (owner->joined) reply->flags |= MACDRV_CLIENT_THREAD_JOINED;
+    if (owner->window_destroyed) reply->flags |= MACDRV_CLIENT_WINDOW_DESTROYED;
+    if (!owner->initializing && !owner->thread && !owner->ready && !owner->stop)
+        reply->flags |= MACDRV_CLIENT_HANDLES_CLOSED;
+    if (owner->class_unregistered) reply->flags |= MACDRV_CLIENT_CLASS_UNREGISTERED;
+}
+
+static DWORD start_client(struct remote_client *owner)
+{
+    HANDLE ready;
+    DWORD error, result, timeout;
+    AcquireSRWLockShared(&client_lock);
+    error = owner->startup_error;
+    if (!error && (owner->stopping || owner->initializing)) error = ERROR_IO_PENDING;
+    if (!error && !owner->ready_published && owner->thread_id == GetCurrentThreadId())
+        error = ERROR_IO_PENDING; /* Reentrant START cannot wait for its own startup. */
+    ready = owner->ready;
+    timeout = owner->ready_published ? 0 : 2000;
+    ReleaseSRWLockShared(&client_lock);
+    if (error) return error;
+    if (!ready) return ERROR_IO_PENDING;
+    /* The callback's API pin excludes handle closing. Never wait with the
+     * registry lock held: the worker needs it to publish startup. */
+    result = WaitForSingleObject(ready, timeout);
+    if (result == WAIT_OBJECT_0) return ERROR_SUCCESS;
+    return result == WAIT_TIMEOUT ? ERROR_IO_PENDING :
+           result == WAIT_FAILED ? client_last_error() : ERROR_INVALID_DATA;
+}
+
+/* cleanup_active excludes all other API handle users, and the worker has been
+ * joined (or no thread was ever created). Failed closes keep their exact owner. */
+static DWORD close_client_handle(HANDLE *slot)
+{
+    HANDLE handle;
+    DWORD error = ERROR_SUCCESS;
+    AcquireSRWLockShared(&client_lock);
+    handle = *slot;
+    ReleaseSRWLockShared(&client_lock);
+    if (handle)
+    {
+        if (!CloseHandle(handle)) error = client_last_error();
+        else
+        {
+            AcquireSRWLockExclusive(&client_lock);
+            *slot = NULL;
+            ReleaseSRWLockExclusive(&client_lock);
+        }
+    }
+    return error;
+}
+
+static DWORD stop_client(struct remote_client *owner)
+{
+    HANDLE stop, thread;
+    DWORD thread_id, result, error = ERROR_SUCCESS, next_error;
+    BOOL class_owned;
+    HMODULE module;
+
+    AcquireSRWLockExclusive(&client_lock);
+    owner->stopping = TRUE;
+    stop = owner->stop;
+    thread = owner->thread;
+    thread_id = owner->thread_id;
+    ReleaseSRWLockExclusive(&client_lock);
+    /* Signal the actual event before attempting any join/cleanup. Every STOP
+     * remains nonblocking; neither a timeout nor our own thread is a join. */
+    if (stop && !SetEvent(stop)) error = client_last_error();
+    AcquireSRWLockExclusive(&client_lock);
+    owner->stop_error = error;
+    ReleaseSRWLockExclusive(&client_lock);
+    if (error) return error;
+    if (thread)
+    {
+        if (thread_id == GetCurrentThreadId()) return ERROR_IO_PENDING;
+        result = WaitForSingleObject(thread, 0);
+        if (result != WAIT_OBJECT_0)
+            return result == WAIT_TIMEOUT ? ERROR_IO_PENDING :
+                   result == WAIT_FAILED ? client_last_error() : ERROR_INVALID_DATA;
+        AcquireSRWLockExclusive(&client_lock);
+        owner->joined = TRUE;
+        ReleaseSRWLockExclusive(&client_lock);
+    }
+    AcquireSRWLockExclusive(&client_lock);
+    if (owner->initializing || (owner->thread_created && !owner->joined) || owner->api_pins != 1)
+        error = ERROR_IO_PENDING;
+    else if (owner->window_created && !owner->window_destroyed)
+        error = owner->destroy_error ? owner->destroy_error : ERROR_IO_PENDING;
+    if (error)
+    {
+        ReleaseSRWLockExclusive(&client_lock);
+        return error;
+    }
+    owner->cleanup_active = TRUE;
+    class_owned = owner->class_owned;
+    module = owner->module;
+    ReleaseSRWLockExclusive(&client_lock);
+
+    error = close_client_handle(&owner->thread);
+    next_error = close_client_handle(&owner->ready);
+    if (!error) error = next_error;
+    next_error = close_client_handle(&owner->stop);
+    if (!error) error = next_error;
+    if (class_owned)
+    {
+        if (!UnregisterClassW(MACDRV_REMOTE_CLIENT_CLASS_NAMEW, module))
+        {
+            next_error = client_last_error();
+            if (!error) error = next_error;
+        }
+        else
+        {
+            AcquireSRWLockExclusive(&client_lock);
+            owner->class_owned = FALSE;
+            owner->class_unregistered = TRUE;
+            ReleaseSRWLockExclusive(&client_lock);
+        }
+    }
+    AcquireSRWLockExclusive(&client_lock);
+    owner->cleanup_error = error;
+    owner->cleanup_active = FALSE;
+    ReleaseSRWLockExclusive(&client_lock);
+    return error;
+}
+
+static void snapshot_client(struct remote_client *owner, struct macdrv_remote_client_reply *reply,
+                            DWORD operation_error)
+{
+    HANDLE thread;
+    HWND window;
+    DWORD thread_id, process_id = 0, result = WAIT_TIMEOUT, error = ERROR_SUCCESS;
+    BOOL live = FALSE;
+
+    AcquireSRWLockShared(&client_lock);
+    thread = owner->thread;
+    window = owner->window;
+    thread_id = owner->thread_id;
+    ReleaseSRWLockShared(&client_lock);
+    if (thread)
+    {
+        result = WaitForSingleObject(thread, 0);
+        if (result == WAIT_FAILED) error = client_last_error();
+        else if (result != WAIT_TIMEOUT && result != WAIT_OBJECT_0) error = ERROR_INVALID_DATA;
+        if (result == WAIT_TIMEOUT && window && thread_id)
+        {
+            live = GetWindowThreadProcessId(window, &process_id) == thread_id &&
+                   process_id == GetCurrentProcessId();
+            if (!live) error = ERROR_INVALID_WINDOW_HANDLE;
+        }
+    }
+    AcquireSRWLockExclusive(&client_lock);
+    if (thread && result == WAIT_OBJECT_0) owner->joined = TRUE;
+    reply_state_locked(owner, reply);
+    live = live && owner->window == window && owner->thread_id == thread_id &&
+           owner->ready_published && owner->ready_signaled && !owner->startup_error &&
+           !owner->stopping && !owner->worker_finishing && !owner->joined;
+    if (live) reply->flags |= MACDRV_CLIENT_LIVE;
+    if (operation_error && operation_error != ERROR_IO_PENDING) reply->status = operation_error;
+    else if (owner->startup_error) reply->status = owner->startup_error;
+    else if (owner->worker_error) reply->status = owner->worker_error;
+    else if (owner->destroy_error) reply->status = owner->destroy_error;
+    else if (owner->stop_error) reply->status = owner->stop_error;
+    else if (owner->cleanup_error) reply->status = owner->cleanup_error;
+    else if (error) reply->status = error;
+    else if (operation_error) reply->status = operation_error;
+    else if (owner->stopping)
+        reply->status = cleanup_complete_locked(owner) ? ERROR_SUCCESS : ERROR_IO_PENDING;
+    else if (owner->joined) reply->status = ERROR_OPERATION_ABORTED;
+    else reply->status = live ? ERROR_SUCCESS : ERROR_IO_PENDING;
+    ReleaseSRWLockExclusive(&client_lock);
+}
+
+NTSTATUS WINAPI macdrv_remote_client_callback(void *args, ULONG size)
+{
+    struct macdrv_remote_client_request request;
+    struct macdrv_remote_client_reply reply = {0};
+    struct remote_client *owner;
+    BOOL initialize = FALSE;
+    DWORD error = ERROR_SUCCESS;
+
+    if (!args || size != sizeof(request)) return STATUS_INVALID_PARAMETER;
+    memcpy(&request, args, sizeof(request));
+    if (request.magic != MACDRV_REMOTE_CLIENT_MAGIC || request.version != MACDRV_REMOTE_CLIENT_VERSION ||
+        request.reserved || !request.generation ||
+        (request.operation != MACDRV_CLIENT_START && request.operation != MACDRV_CLIENT_QUERY &&
+         request.operation != MACDRV_CLIENT_STOP)) return STATUS_INVALID_PARAMETER;
+    reply.magic = request.magic;
+    reply.version = request.version;
+    reply.operation = request.operation;
+    reply.generation = request.generation;
+    reply.reserved = request.reserved;
+    /* Only incarnation one exists. A different nonzero generation is a valid
+     * frame with an operation error, never permission to replace the registry. */
+    if (request.generation != 1)
+    {
+        reply.status = ERROR_INVALID_PARAMETER;
+        return NtCallbackReturn(&reply, sizeof(reply), STATUS_SUCCESS);
+    }
+    AcquireSRWLockExclusive(&client_lock);
+    if (!client && !allocation_error && request.operation == MACDRV_CLIENT_START)
+    {
+        client = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*client));
+        if (!client) allocation_error = ERROR_NOT_ENOUGH_MEMORY;
+        else
+        {
+            client->initializing = TRUE;
+            initialize = TRUE;
+        }
+    }
+    owner = client;
+    if (!owner) reply.status = allocation_error ? allocation_error : ERROR_NOT_FOUND;
+    else if (owner->cleanup_active || owner->api_pins == ~(ULONG)0)
+    {
+        reply_state_locked(owner, &reply);
+        reply.status = owner->cleanup_active ? ERROR_IO_PENDING : ERROR_ARITHMETIC_OVERFLOW;
+        owner = NULL;
+    }
+    else ++owner->api_pins;
+    ReleaseSRWLockExclusive(&client_lock);
+    if (owner)
+    {
+        if (initialize) initialize_client(owner);
+        if (request.operation == MACDRV_CLIENT_START) error = start_client(owner);
+        else if (request.operation == MACDRV_CLIENT_STOP) error = stop_client(owner);
+        snapshot_client(owner, &reply, error);
+        AcquireSRWLockExclusive(&client_lock);
+        --owner->api_pins;
+        ReleaseSRWLockExclusive(&client_lock);
+    }
+    return NtCallbackReturn(&reply, sizeof(reply), STATUS_SUCCESS);
+}
