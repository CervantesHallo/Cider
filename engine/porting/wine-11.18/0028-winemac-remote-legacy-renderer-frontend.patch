+/* Candidate renderer client control ABI. No private HWND layouts or status
+ * success substitution. All payload fields have fixed widths across WoW64. */
+#ifndef __WINE_MACDRV_REMOTE_CLIENT_H
+#define __WINE_MACDRV_REMOTE_CLIENT_H
+#include "ntuser.h"
+#define MACDRV_REMOTE_CLIENT_MAGIC 0x3143524dU
+#define MACDRV_REMOTE_CLIENT_VERSION 1U
+#define MACDRV_REMOTE_CLIENT_CLASS_NAMEW u"CiderRemoteClientEventsV1"
+#define WM_MACDRV_REMOTE_CLIENT_WAKE (WM_APP + 0x3c1)
+enum macdrv_remote_client_control { MACDRV_CLIENT_START=1, MACDRV_CLIENT_QUERY, MACDRV_CLIENT_STOP };
+enum macdrv_remote_client_event_op { MACDRV_CLIENT_EVENT_WAKE=1 };
+enum macdrv_remote_client_flags
+{
+    MACDRV_CLIENT_LIVE=1, MACDRV_CLIENT_THREAD_JOINED=2,
+    MACDRV_CLIENT_WINDOW_DESTROYED=4, MACDRV_CLIENT_HANDLES_CLOSED=8,
+    MACDRV_CLIENT_CLASS_UNREGISTERED=16
+};
+struct macdrv_remote_client_init { UINT32 magic,version; UINT64 callback; };
+struct macdrv_remote_client_request
+{
+    struct dispatch_callback_params dispatch;
+    UINT32 magic,version,operation,reserved;
+    UINT64 generation; /* process-local service incarnation; initial value1 */
+};
+struct macdrv_remote_client_reply
+{
+    UINT32 magic,version,operation,status;
+    UINT64 generation;
+    UINT32 window,thread,flags,reserved;
+};
+struct macdrv_remote_client_event
+{
+    UINT32 size,version,operation,window;
+    UINT64 generation; /* advisory remote producer generation; 0 = poll all */
+    UINT32 thread,reserved;
+};
+C_ASSERT(sizeof(struct macdrv_remote_client_init)==16);
+C_ASSERT(sizeof(struct macdrv_remote_client_request)==32);
+C_ASSERT(sizeof(struct macdrv_remote_client_reply)==40);
+C_ASSERT(sizeof(struct macdrv_remote_client_event)==32);
+extern NTSTATUS WINAPI macdrv_remote_client_callback(void *,ULONG);
+#endif
