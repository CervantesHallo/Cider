+BOOL client_surface_try_add_ref( struct client_surface *surface )
+{
+    LONG refs;
+    if (!surface) return FALSE;
+    refs = InterlockedCompareExchange( &surface->ref, 0, 0 );
+    while (refs > 0 && refs < 0x7fffffff)
+    {
+        LONG observed = InterlockedCompareExchange( &surface->ref, refs + 1, refs );
+        if (observed == refs) return TRUE;
+        refs = observed;
+    }
+    return FALSE;
+}
+
+BOOL client_surface_forget_unused( struct client_surface *surface )
+{
+    struct client_surface *entry;
+    BOOL removed = FALSE;
+    if (!surface) return FALSE;
+    pthread_mutex_lock( &surfaces_lock );
+    LIST_FOR_EACH_ENTRY( entry, &unused_surfaces, struct client_surface, entry )
+        if (entry == surface)
+        {
+            client_surface_detach_locked( surface );
+            client_surface_release_locked( surface ); /* exact cached owner, caller still pins */
+            removed = TRUE;
+            break;
+        }
+    if (!surface->hwnd) removed = TRUE; /* already detached, not a GPU/owner-completion assertion */
+    pthread_mutex_unlock( &surfaces_lock );
+    return removed;
 }
 
