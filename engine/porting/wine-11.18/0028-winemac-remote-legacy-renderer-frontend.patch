+/* Wine-thread notification only. The message is a wake hint, never a SAFE
+ * permission. Copy scalar endpoints under the registry lock; no USER call or
+ * borrowed NT handle is used while holding that lock. */
+static BOOL client_notify_window_valid(HWND window, DWORD pid, DWORD tid)
+{
+    static const WCHAR expected[] = MACDRV_REMOTE_CLIENT_CLASS_NAMEW;
+    WCHAR buffer[64];
+    UNICODE_STRING name = {0, sizeof(buffer), buffer};
+    DWORD actual_pid = 0;
+    UINT actual_tid = NtUserGetWindowThread(window, &actual_pid);
+    INT length;
+    if (!window || !tid || actual_tid != tid || actual_pid != pid) return FALSE;
+    length = NtUserGetClassName(window, FALSE, &name);
+    return length == ARRAY_SIZE(expected) - 1 && !memcmp(buffer, expected, length * sizeof(WCHAR));
+}
+static void notify_remote_clients(HWND root_hwnd)
+{
+    struct client_notice { HWND window; DWORD pid, tid; UINT64 generation; } *snapshot;
+    struct remote_producer *producer;
+    SIZE_T count = 0, index = 0;
+    pthread_mutex_lock(&remote_lock);
+    for (producer = producers; producer; producer = producer->next)
+        if (producer->root->hwnd == root_hwnd && producer->notify_window) ++count;
+    snapshot = count && count <= ~(SIZE_T)0 / sizeof(*snapshot) ? malloc(count * sizeof(*snapshot)) : NULL;
+    if (snapshot)
+        for (producer = producers; producer; producer = producer->next)
+            if (producer->root->hwnd == root_hwnd && producer->notify_window)
+                snapshot[index++] = (struct client_notice){producer->notify_window, producer->pid,
+                    producer->notify_thread, producer->generation};
+    pthread_mutex_unlock(&remote_lock);
+    for (index = 0; snapshot && index < count; ++index)
+        if (client_notify_window_valid(snapshot[index].window, snapshot[index].pid, snapshot[index].tid))
+            NtUserPostMessage(snapshot[index].window, WM_MACDRV_REMOTE_CLIENT_WAKE,
+                (UINT32)snapshot[index].generation, (UINT32)(snapshot[index].generation >> 32));
+    free(snapshot); /* dropped wake is covered by the existing PE recovery timer */
+}
