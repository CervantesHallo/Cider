+BOOL macdrv_legacy_remote_recover(UINT64 generation)
+{
+    struct legacy_surface **snapshot, *entry;
+    SIZE_T count = 0, index = 0;
+    BOOL pending = FALSE;
+    pthread_mutex_lock(&legacy_lock);
+    LIST_FOR_EACH_ENTRY(entry, &legacy_surfaces, struct legacy_surface, entry)
+        if (entry->remote_owner || entry->need_forget || entry->handoff || entry->handoff_pending || (entry->surface_owner && entry->surface_ref_owned)) ++count;
+    snapshot = count && count <= ~(SIZE_T)0 / sizeof(*snapshot) ? malloc(count * sizeof(*snapshot)) : NULL;
+    if (snapshot)
+        LIST_FOR_EACH_ENTRY(entry, &legacy_surfaces, struct legacy_surface, entry)
+            if ((entry->remote_owner || entry->need_forget || entry->handoff || entry->handoff_pending || (entry->surface_owner && entry->surface_ref_owned)) && entry->refs != ~0u)
+            {++entry->refs; snapshot[index++] = entry;}
+    pthread_mutex_unlock(&legacy_lock);
+    if (count && !snapshot) return TRUE; /* no false all-clear on allocation failure */
+    count = index;
+    for (index = 0; index < count; ++index)
+    {
+        struct macdrv_remote_renderer *client = NULL;
+        enum macdrv_remote_renderer_mode mode = MACDRV_RENDERER_STOP;
+        BOOL done = FALSE;
+        entry = snapshot[index];
+        perform_handoff(entry);
+        pthread_mutex_lock(&legacy_lock);
+        if (entry->remote_owner && (!entry->remote_init_waiting || !entry->public_refs) && !entry->creating && !entry->poll_busy && !entry->layer_users)
+        {
+            entry->poll_busy = TRUE; client = entry->remote;
+            mode = !entry->surface || !entry->remote_ready ? MACDRV_RENDERER_STOP :
+                   entry->public_refs ? MACDRV_RENDERER_ACTIVE : MACDRV_RENDERER_CACHED;
+        }
+        pthread_mutex_unlock(&legacy_lock);
+        if (client) done = macdrv_remote_renderer_progress(client, mode, generation != 0);
+        pthread_mutex_lock(&legacy_lock);
+        if (client)
+        {
+            entry->poll_busy = FALSE;
+            if (done)
+            {
+                entry->remote = NULL; entry->remote_owner = FALSE; entry->remote_ready = FALSE;
+                if (!entry->public_refs && entry->surface_owner) entry->need_forget = TRUE;
+            }
+        }
+        pthread_mutex_unlock(&legacy_lock);
+        if (done) {macdrv_remote_renderer_free(client); legacy_surface_release(entry, FALSE);}
+        forget_retired_cache(entry);
+        legacy_surface_release(entry, FALSE); /* snapshot pin */
+    }
+    free(snapshot);
+    pthread_mutex_lock(&legacy_lock);
+    LIST_FOR_EACH_ENTRY(entry, &legacy_surfaces, struct legacy_surface, entry)
+        if (entry->remote_owner || entry->need_forget || entry->handoff || entry->handoff_pending || (entry->surface_owner && entry->surface_ref_owned)) {pending = TRUE; break;}
+    pthread_mutex_unlock(&legacy_lock);
+    return pending;
 }
 
