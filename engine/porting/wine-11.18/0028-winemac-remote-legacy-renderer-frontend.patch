+#include "remote_renderer.h"
+#include "status_cell.h"
+#include "wine/server.h"
+WINE_DEFAULT_DEBUG_CHANNEL(macdrv);
+
+struct renderer_route
+{
+    struct renderer_route *next;
+    HWND root;
+    struct macdrv_status_identity producer_id,host_id;
+    struct macdrv_status_cell *producer_reader,*host_reader;
+    UINT64 sequence,ticket;
+    BOOL acquire_unknown,prepare_sent,install_sent,cancel_sent,release_sent;
+    BOOL stopping,host_safe,producer_safe,ready,safety_probed,producer_reader_failed;
+    DWORD last_error;
+};
+struct macdrv_remote_renderer
+{
+    HWND hwnd;
+    UINT32 owner_pid,session,dispatcher_window,dispatcher_thread;
+    UINT64 owner_birth,window_identity,birth;
+    id_WineMetalSwapChain context;
+    UINT context_id;
+    struct renderer_route *routes,*current;
+    BOOL started,dead,stopping;
+    DWORD last_error;
+};
+static LONG64 client_callback;
+static pthread_mutex_t client_service_lock=PTHREAD_MUTEX_INITIALIZER;
+static UINT64 next_generation=1;
+static UINT32 client_window,client_thread;
+
+NTSTATUS macdrv_remote_client_init(void *args)
+{
+    const struct macdrv_remote_client_init *p=args;
+    LONG64 old;
+    if(!p||p->magic!=MACDRV_REMOTE_CLIENT_MAGIC||p->version!=MACDRV_REMOTE_CLIENT_VERSION||!p->callback)
+        return STATUS_INVALID_PARAMETER;
+    old=InterlockedCompareExchange64(&client_callback,p->callback,0);
+    return !old||(UINT64)old==p->callback?STATUS_SUCCESS:STATUS_INVALID_PARAMETER;
+}
+NTSTATUS macdrv_remote_client_event(void *args)
+{
+    const struct macdrv_remote_client_event *p=args;
+    BOOL valid;
+    if(!p||p->size!=sizeof(*p)||p->version!=MACDRV_REMOTE_CLIENT_VERSION||
+       p->operation!=MACDRV_CLIENT_EVENT_WAKE||p->reserved)return STATUS_INVALID_PARAMETER;
+    pthread_mutex_lock(&client_service_lock);
+    valid=client_window&&client_thread&&p->window==client_window&&p->thread==client_thread;
+    pthread_mutex_unlock(&client_service_lock);
+    if(!valid||GetCurrentThreadId()!=p->thread)return STATUS_INVALID_HANDLE;
+    macdrv_legacy_remote_recover(p->generation); /* no permission is supplied by the message */
+    return STATUS_SUCCESS;
+}
+static DWORD ensure_dispatcher(UINT32 *window,UINT32 *thread)
+{
+    struct macdrv_remote_client_request request={0};
+    struct macdrv_remote_client_reply reply;
+    void *returned=NULL;
+    ULONG bytes=0;
+    NTSTATUS status;
+    request.dispatch.callback=(UINT64)InterlockedCompareExchange64(&client_callback,0,0);
+    if(!request.dispatch.callback)return ERROR_PROC_NOT_FOUND;
+    request.magic=MACDRV_REMOTE_CLIENT_MAGIC;request.version=MACDRV_REMOTE_CLIENT_VERSION;
+    request.operation=MACDRV_CLIENT_START;request.generation=1;
+    status=KeUserDispatchCallback(&request.dispatch,sizeof(request),&returned,&bytes);
+    if(status)return RtlNtStatusToDosError(status);
+    if(!returned||bytes!=sizeof(reply))return ERROR_INVALID_DATA;
+    memcpy(&reply,returned,sizeof(reply));
+    if(reply.magic!=request.magic||reply.version!=request.version||reply.operation!=request.operation||
+       reply.generation!=request.generation||reply.reserved)return ERROR_INVALID_DATA;
+    if(reply.status)return reply.status;
+    if(!(reply.flags&MACDRV_CLIENT_LIVE)||!reply.window||!reply.thread)return ERROR_INVALID_DATA;
+    pthread_mutex_lock(&client_service_lock);
+    if(client_window&&(client_window!=reply.window||client_thread!=reply.thread))
+    {pthread_mutex_unlock(&client_service_lock);return ERROR_INVALID_DATA;}
+    client_window=*window=reply.window;client_thread=*thread=reply.thread;
+    pthread_mutex_unlock(&client_service_lock);
+    return ERROR_SUCCESS;
+}
+static DWORD generation(uint64_t *value)
+{
+    DWORD error=ERROR_SUCCESS;
+    pthread_mutex_lock(&client_service_lock);
+    if(!next_generation)error=ERROR_ARITHMETIC_OVERFLOW;
+    else *value=next_generation++;
+    pthread_mutex_unlock(&client_service_lock);
+    return error;
+}
+static DWORD query_window(HWND hwnd,UINT32 *pid,UINT64 *birth,UINT64 *identity)
+{
+    struct macdrv_remote_packet packet={0};
+    packet.operation=MACDRV_REMOTE_QUERY_WINDOW_IDENTITY;
+    if(!macdrv_remote_prepared_packet_send(hwnd,&packet))return ERROR_IO_PENDING;
+    if(packet.status)return packet.status;
+    if(!packet.root_pid||!packet.root_create_time||!packet.root_epoch)return ERROR_INVALID_DATA;
+    *pid=packet.root_pid;*birth=packet.root_create_time;*identity=packet.root_epoch;
+    return ERROR_SUCCESS;
+}
+static BOOL same_window(struct macdrv_remote_renderer *client)
+{
+    UINT32 pid=0;
+    UINT64 birth=0,identity=0;
+    DWORD error=query_window(client->hwnd,&pid,&birth,&identity);
+    if(error)
+    {
+        client->last_error=error;
+        if(error==ERROR_INVALID_WINDOW_HANDLE||error==ERROR_INVALID_HANDLE)client->dead=TRUE;
+        return FALSE;
+    }
+    if(pid!=client->owner_pid||birth!=client->owner_birth||identity!=client->window_identity)
+    {client->dead=TRUE;client->last_error=ERROR_INVALID_WINDOW_HANDLE;return FALSE;}
+    return TRUE;
+}
+static DWORD route_send(struct renderer_route *route,UINT operation,UINT context,UINT32 child,
+                        struct macdrv_remote_packet *packet)
+{
+    memset(packet,0,sizeof(*packet));
+    if(route->sequence==~(UINT64)0)return ERROR_ARITHMETIC_OVERFLOW;
+    packet->operation=operation;packet->producer_generation=route->producer_id.generation;
+    packet->root_epoch=route->producer_id.root_epoch;packet->lease_id=route->producer_id.lease;
+    packet->sequence=++route->sequence;
+    packet->context_id=context;packet->child=child;
+    if(operation==MACDRV_REMOTE_INSTALL_PREPARED_HOST||operation==MACDRV_REMOTE_CANCEL_HOST)
+        packet->host_ticket=route->ticket;
+    if(!macdrv_remote_prepared_packet_send(route->root,packet))return ERROR_IO_PENDING;
+    if(packet->root_pid!=route->producer_id.root_pid||packet->root_create_time!=route->producer_id.root_birth)
+        return ERROR_INVALID_DATA;
+    return packet->status;
+}
+static void read_permissions(struct renderer_route *route)
+{
+    struct macdrv_status_snapshot snapshot;
+    if(route->host_reader&&macdrv_status_cell_read(route->host_reader,&snapshot)==MACDRV_STATUS_READ_SAFE_ONLY&&
+       !snapshot.values_valid)route->host_safe=TRUE;
+    if(route->producer_reader&&macdrv_status_cell_read(route->producer_reader,&snapshot)==MACDRV_STATUS_READ_SAFE_ONLY&&
+       !snapshot.values_valid)route->producer_safe=TRUE;
+}
+static BOOL retire_route(struct renderer_route *route)
+{
+    struct macdrv_remote_packet packet;
+    DWORD error;
+    NTSTATUS status;
+    route->stopping=TRUE;
+    if(route->acquire_unknown)return FALSE; /* no known lease; no invented peer cleanup */
+    if(route->producer_id.lease)
+    {
+        if(route->producer_reader_failed && !route->prepare_sent && !route->install_sent && !route->ticket)
+        {
+            status=macdrv_status_cell_close(&route->producer_reader);
+            if(status){route->last_error=RtlNtStatusToDosError(status);return FALSE;}
+            if(!route->release_sent)
+            {
+                if(route->sequence==~(UINT64)0)return FALSE;
+                route->release_sent=TRUE;
+                error=route_send(route,MACDRV_REMOTE_RELEASE_PRODUCER,0,0,&packet);
+                route->last_error=error;
+            }
+            WARN("renderer reader setup failed before PREPARE: local no-import owner settled; peer revoke result %u is not SAFE\n",(unsigned)route->last_error);
+            return TRUE;
+        }
+        if(route->ticket&&route->install_sent&&!route->cancel_sent)
+        {
+            if(route->sequence==~(UINT64)0)return FALSE;
+            route->cancel_sent=TRUE; /* before the possible irreversible effect */
+            error=route_send(route,MACDRV_REMOTE_CANCEL_HOST,0,0,&packet);
+            if(error&&error!=ERROR_IO_PENDING)route->last_error=error;
+        }
+        if(!route->release_sent)
+        {
+            if(route->sequence==~(UINT64)0)return FALSE;
+            route->release_sent=TRUE;
+            error=route_send(route,MACDRV_REMOTE_RELEASE_PRODUCER,0,0,&packet);
+            if(error&&error!=ERROR_IO_PENDING)route->last_error=error;
+        }
+        read_permissions(route);
+        if(route->install_sent&&!route->host_safe&&!route->producer_safe)return FALSE;
+        if(!route->producer_safe)return FALSE;
+    }
+    status=macdrv_status_cell_close(&route->host_reader);
+    if(status){route->last_error=RtlNtStatusToDosError(status);return FALSE;}
+    status=macdrv_status_cell_close(&route->producer_reader);
+    if(status){route->last_error=RtlNtStatusToDosError(status);return FALSE;}
+    return TRUE;
+}
+static DWORD open_route(struct macdrv_remote_renderer *client,HWND root,struct renderer_route **out)
+{
+    struct renderer_route *route;
+    struct macdrv_remote_packet packet={0};
+    struct macdrv_status_snapshot snapshot;
+    NTSTATUS status;
+    DWORD error;
+    unsigned attempt;
+    *out=NULL;
+    if(!(route=calloc(1,sizeof(*route))))return ERROR_NOT_ENOUGH_MEMORY;
+    route->root=root;route->next=client->routes;client->routes=route; /* own every partial setup */
+    packet.operation=MACDRV_REMOTE_QUERY_ROOT;
+    if(!macdrv_remote_prepared_packet_send(root,&packet))return ERROR_IO_PENDING;
+    if(packet.status)return packet.status;
+    if(!packet.root_pid||!packet.root_create_time||!packet.root_epoch)return ERROR_INVALID_DATA;
+    route->producer_id=(struct macdrv_status_identity){.session_id=client->session,.root_pid=packet.root_pid,
+        .producer_pid=GetCurrentProcessId(),.kind=MACDRV_STATUS_PRODUCER,.root_birth=packet.root_create_time,
+        .root_epoch=packet.root_epoch,.producer_birth=client->birth};
+    /* Independent surfaces use independent leases. Only a definite no-lease
+     * acquisition rejection may consume a fresh generation; never retry an
+     * unknown transport result or an INSTALL. No context has been imported. */
+    for(attempt=0;attempt<8;++attempt)
+    {
+        if((error=generation(&route->producer_id.generation)))return error;
+        memset(&packet,0,sizeof(packet));packet.operation=MACDRV_REMOTE_ACQUIRE_PRODUCER;
+        packet.producer_generation=route->producer_id.generation;packet.root_epoch=route->producer_id.root_epoch;
+        if(!macdrv_remote_prepared_packet_send(root,&packet))
+        {route->acquire_unknown=TRUE;return ERROR_IO_PENDING;}
+        route->producer_id.lease=packet.lease_id; /* actual effect, before later checks */
+        if(packet.root_pid!=route->producer_id.root_pid||packet.root_create_time!=route->producer_id.root_birth)
+            return ERROR_INVALID_DATA;
+        if(!packet.status&&packet.lease_id)break;
+        if(packet.lease_id||packet.status!=ERROR_INVALID_HANDLE)return packet.status?packet.status:ERROR_INVALID_DATA;
+        if(!same_window(client)||NtUserGetAncestor(client->hwnd,GA_ROOT)!=root)return ERROR_INVALID_WINDOW_HANDLE;
+    }
+    if(!route->producer_id.lease)return ERROR_RETRY;
+    status=macdrv_status_cell_open(&route->producer_id,&route->producer_reader);
+    if(status){route->producer_reader_failed=TRUE;return RtlNtStatusToDosError(status);}
+    error=route_send(route,MACDRV_REMOTE_REGISTER_PRODUCER_NOTIFY,client->dispatcher_thread,client->dispatcher_window,&packet);
+    if(error)return error;
+    route->prepare_sent=TRUE;
+    error=route_send(route,MACDRV_REMOTE_PREPARE_HOST,client->context_id,wine_server_user_handle(client->hwnd),&packet);
+    route->ticket=packet.host_ticket;
+    if(error)return error;
+    if(!route->ticket)return ERROR_INVALID_DATA;
+    route->host_id=route->producer_id;route->host_id.kind=MACDRV_STATUS_HOST;
+    route->host_id.ticket=route->ticket;route->host_id.context_id=client->context_id;
+    status=macdrv_status_cell_open(&route->host_id,&route->host_reader);
+    if(status)return RtlNtStatusToDosError(status);
+    if(macdrv_status_cell_read(route->host_reader,&snapshot)!=MACDRV_STATUS_READ_SNAPSHOT||!snapshot.values_valid)
+        return ERROR_INVALID_DATA;
+    if(!same_window(client)||NtUserGetAncestor(client->hwnd,GA_ROOT)!=root)return ERROR_INVALID_WINDOW_HANDLE;
+    if(route->sequence==~(UINT64)0)return ERROR_ARITHMETIC_OVERFLOW;
+    route->install_sent=TRUE;
+    error=route_send(route,MACDRV_REMOTE_INSTALL_PREPARED_HOST,0,0,&packet);
+    if(error)return error;
+    if(macdrv_status_cell_read(route->host_reader,&snapshot)!=MACDRV_STATUS_READ_SNAPSHOT||!snapshot.values_valid)
+        return ERROR_PROCESS_ABORTED;
+    route->ready=TRUE;*out=route;
+    return ERROR_SUCCESS;
+}
+struct macdrv_remote_renderer *macdrv_remote_renderer_alloc(HWND hwnd)
+{
+    struct macdrv_remote_renderer *client=calloc(1,sizeof(*client));
+    if(client)client->hwnd=hwnd;
+    return client;
+}
+DWORD macdrv_remote_renderer_start(struct macdrv_remote_renderer *client,id_MTLDevice device)
+{
+    KERNEL_USER_TIMES times;
+    RECT rect;
+    NTSTATUS status;
+    DWORD error;
+    struct renderer_route *route;
+    if(!client||client->started||client->context||client->routes||pthread_main_np())return ERROR_INVALID_STATE;
+    if((error=ensure_dispatcher(&client->dispatcher_window,&client->dispatcher_thread)))return error;
+    error=query_window(client->hwnd,&client->owner_pid,&client->owner_birth,&client->window_identity);
+    if(error)return error;
+    status=NtQueryInformationProcess(NtCurrentProcess(),ProcessTimes,&times,sizeof(times),NULL);
+    if(!status)status=NtQueryInformationProcess(NtCurrentProcess(),ProcessSessionInformation,&client->session,sizeof(client->session),NULL);
+    if(status)return RtlNtStatusToDosError(status);
+    client->birth=times.CreateTime.QuadPart;
+    if(!NtUserGetClientRect(client->hwnd,&rect,NtUserGetWinMonitorDpi(client->hwnd,MDT_RAW_DPI)))return ERROR_INVALID_WINDOW_HANDLE;
+    client->context=macdrv_create_exported_metal_context(cgrect_from_rect(rect),device);
+    if(!client->context||!(client->context_id=macdrv_exported_metal_context_id(client->context)))return ERROR_NOT_ENOUGH_MEMORY;
+    error=open_route(client,NtUserGetAncestor(client->hwnd,GA_ROOT),&route);
+    if(error)
+    {
+        struct renderer_route *r;
+        for(r=client->routes;r;r=r->next)r->stopping=TRUE;
+        client->last_error=error;return error;
+    }
+    client->current=route;client->started=TRUE;
+    TRACE("renderer client active hwnd %p context %u root %p lease %#llx ticket %#llx generation %#llx\n",
+        client->hwnd, client->context_id, route->root, (unsigned long long)route->producer_id.lease,
+        (unsigned long long)route->ticket, (unsigned long long)route->producer_id.generation);
+    return ERROR_SUCCESS;
+}
+BOOL macdrv_remote_renderer_progress(struct macdrv_remote_renderer *client,enum macdrv_remote_renderer_mode mode,BOOL event_probe)
+{
+    struct renderer_route **cursor,*route;
+    BOOL pending=FALSE,need_update=FALSE,window_valid=FALSE;
+    HWND root;
+    (void)event_probe; /* wakes accelerate the same independent periodic identity check */
+    if(!client||pthread_main_np())return FALSE;
+    if(mode==MACDRV_RENDERER_STOP)client->stopping=TRUE;
+    if(client->started&&!client->stopping&&!client->dead)
+        window_valid=same_window(client); /* bounded Wine-thread check even while RO is ACTIVE */
+    if(client->current)
+    {
+        read_permissions(client->current);
+        need_update=client->current->host_safe||client->current->producer_safe;
+        if(mode==MACDRV_RENDERER_CACHED&&need_update)client->stopping=TRUE; /* replacement must not resurrect cached pixels */
+    }
+    if(client->started&&!client->stopping&&!client->dead&&window_valid&&
+       (mode==MACDRV_RENDERER_ACTIVE||mode==MACDRV_RENDERER_CACHED))
+    {
+        root=NtUserGetAncestor(client->hwnd,GA_ROOT);
+        if(root&&client->current)
+        {
+            struct macdrv_remote_packet query={0};
+            BOOL failed_route=FALSE,changed,delivered;
+            query.operation=MACDRV_REMOTE_QUERY_ROOT;
+            delivered=macdrv_remote_prepared_packet_send(root,&query);
+            changed=delivered&&!query.status&&query.root_epoch&&
+                (root!=client->current->root||query.root_epoch!=client->current->producer_id.root_epoch||
+                 query.root_pid!=client->current->producer_id.root_pid||query.root_create_time!=client->current->producer_id.root_birth);
+            if(delivered&&!query.status&&query.root_epoch&&query.root_pid&&query.root_create_time)client->current->safety_probed=TRUE;
+            for(route=client->routes;route;route=route->next)if(route!=client->current)failed_route=TRUE;
+            /* A new swapchain on the SAME root may have superseded this one.
+             * SAFE alone must not reimport and overwrite the newer image. */
+            if(changed&&mode==MACDRV_RENDERER_CACHED) client->stopping=TRUE;
+            if(changed&&mode==MACDRV_RENDERER_ACTIVE&&!failed_route)
+            {
+                struct renderer_route *fresh=NULL;
+                DWORD error=open_route(client,root,&fresh);
+                if(!error){client->current->stopping=TRUE;client->current=fresh;}
+                else
+                {
+                    for(route=client->routes;route;route=route->next)if(route!=client->current)route->stopping=TRUE;
+                    client->last_error=error;
+                }
+            }
+        }
+        else if(!root)client->dead=TRUE;
+        if(client->dead)for(route=client->routes;route;route=route->next)route->stopping=TRUE;
+    }
+    for(cursor=&client->routes;(route=*cursor);)
+    {
+        if(client->stopping||client->dead)route->stopping=TRUE;
+        if(route->stopping)
+        {
+            if(retire_route(route))
+            {
+                *cursor=route->next;if(client->current==route)client->current=NULL;free(route);continue;
+            }
+            pending=TRUE;
+        }
+        cursor=&route->next;
+    }
+    if(client->routes||pending)return FALSE;
+    /* Active renderer leases keep a borrowed CAMetalLayer valid even after
+     * its HWND disappears; there is no free based on a message or process exit. */
+    if(mode==MACDRV_RENDERER_ACTIVE&&!client->stopping)return FALSE;
+    if(client->context){macdrv_destroy_swapchain(client->context);client->context=NULL;}
+    return TRUE;
+}
+void *macdrv_remote_renderer_layer(struct macdrv_remote_renderer *client)
+{
+    return client&&client->context?macdrv_swapchain_get_layer(client->context):NULL;
+}
+BOOL macdrv_remote_renderer_device_matches(struct macdrv_remote_renderer *client,id_MTLDevice device)
+{
+    return client&&client->context&&(!device||macdrv_swapchain_get_device(client->context)==device);
+}
+BOOL macdrv_remote_renderer_has_generation(const struct macdrv_remote_renderer *client,UINT64 value)
+{
+    const struct renderer_route *route;
+    if(!client)return FALSE;
+    for(route=client->routes;route;route=route->next)if(route->producer_id.generation==value)return TRUE;
+    return FALSE;
+}
+void macdrv_remote_renderer_free(struct macdrv_remote_renderer *client)
+{
+    if(!client)return;
+    if(client->routes||client->context)
+    {ERR("renderer resource free rejected while context/routes still owned\n");return;}
+    TRACE("renderer client freed hwnd %p context0 routes0\n",client->hwnd);
+    free(client);
+}
