Wine 11.18 semantic port of the qualified Cider 0003-0005 caption fixes.

Initialize both style-mask outputs. Preserve the actual NCCALCSIZE client
inside the visible window rectangle. When that nonempty client reaches the
window top, suppress the duplicate native caption while preserving Windows
styles and borderless resize behavior. Apply decoration before converting
and syncing content geometry; echo native frame events only for changed
visible/window insets. No application-name or fixed-pixel special case.

--- a/dlls/win32u/window.c
+++ b/dlls/win32u/window.c
@@ -2221,6 +2221,10 @@
     visible_rect.right  -= rect.right;
     visible_rect.top    -= rect.top;
     visible_rect.bottom -= rect.bottom;
+    /* NCCALCSIZE may extend the client through a nominal WS_CAPTION. Keep
+     * that actual client inside the host-visible surface, within the window. */
+    if (intersect_rect( &rect, &rects->client, &rects->window ))
+        union_rect( &visible_rect, &visible_rect, &rect );
     if (visible_rect.top >= visible_rect.bottom) visible_rect.bottom = visible_rect.top + 1;
     if (visible_rect.left >= visible_rect.right) visible_rect.right = visible_rect.left + 1;
 
--- a/dlls/winemac.drv/window.c
+++ b/dlls/winemac.drv/window.c
@@ -97,7 +97,12 @@
     if (ex_style & WS_EX_NOACTIVATE) wf.prevents_app_activation = TRUE;
     if (EqualRect(&data->rects.window, &data->rects.visible)) return wf;
 
-    return get_window_features_for_style(style, ex_style, data->shaped);
+    wf = get_window_features_for_style(style, ex_style, data->shaped);
+    /* Retain Windows style/resize semantics; an application whose actual
+     * nonempty client reaches the top owns its caption pixels itself. */
+    if (!IsRectEmpty(&data->rects.client) && data->rects.client.top == data->rects.window.top)
+        wf.title_bar = FALSE;
+    return wf;
 }
 
 
@@ -1667,7 +1672,7 @@
 {
     struct macdrv_window_features wf = get_window_features_for_style(style, ex_style, FALSE);
 
-    *style_mask = ex_style = 0;
+    *style_mask = *ex_style_mask = 0;
     if (wf.title_bar)
