+        (LONGLONG)old_rects.visible.top - old_rects.window.top != (LONGLONG)new_rects->visible.top - new_rects->window.top ||
+        (LONGLONG)old_rects.window.right - old_rects.visible.right != (LONGLONG)new_rects->window.right - new_rects->visible.right ||
+        (LONGLONG)old_rects.window.bottom - old_rects.visible.bottom != (LONGLONG)new_rects->window.bottom - new_rects->visible.bottom;
 
     TRACE("win %p/%p new_rects %s style %08x flags %08x surface %p\n", hwnd, data->cocoa_window,
           debugstr_window_rects(new_rects), new_style, swp_flags, surface);
