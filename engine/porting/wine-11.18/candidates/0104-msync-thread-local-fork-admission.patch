+/* SC publication/recheck: a fork sees every admitted existing descriptor, or
+ * its owner sees the closed gate before using it. A cold thread blocked on the
+ * registry has not opened an inheritable work description yet. */
+static void coord_depart(void)
+{
+    struct thread_data *data = get_thread_data();
+    __atomic_store_n( &data->msync_in_transaction, 0, __ATOMIC_SEQ_CST );
+    if (__atomic_load_n( &coord_forking, __ATOMIC_SEQ_CST ))
+        __ulock_wake( 1 | ULF_WAKE_ALL, (void *)&data->msync_in_transaction, 0 );
+}
