         pthread_sigmask( SIG_BLOCK, &mask, &coord_fork_signals ) ||
         pthread_mutex_lock( &coord_fork_mutex )) msync_coord_fatal( "fork prepare" );
-    if (__atomic_fetch_or( &coord_admission, COORD_ADMISSION_CLOSED, __ATOMIC_SEQ_CST ) & COORD_ADMISSION_CLOSED)
+    if (__atomic_exchange_n( &coord_forking, 1, __ATOMIC_SEQ_CST ))
