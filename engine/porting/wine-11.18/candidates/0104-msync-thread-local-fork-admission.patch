+        if (!__atomic_load_n( &coord_forking, __ATOMIC_SEQ_CST )) continue;
+        ret = __ulock_wait( 1 | ULF_NO_ERRNO, &coord_forking, 1, 1000 );
+        if (ret < 0 && ret != -EINTR && ret != -ETIMEDOUT && ret != -EFAULT)
+            msync_coord_fatal( "fork admission wait" );
