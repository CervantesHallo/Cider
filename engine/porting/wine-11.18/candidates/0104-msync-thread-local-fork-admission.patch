+    /* The registry pins each thread_data until the record is unlinked. Active
+     * registered operations never need this mutex; cold opens wait outside it. */
+    for (record = coord_fds; record; record = record->next)
+        while (__atomic_load_n( &record->thread_data->msync_in_transaction, __ATOMIC_SEQ_CST ))
+        {
+            ret = __ulock_wait( 1 | ULF_NO_ERRNO,
+                       (void *)&record->thread_data->msync_in_transaction, 1, 1000 );
+            if (ret < 0 && ret != -EINTR && ret != -ETIMEDOUT && ret != -EFAULT)
+                msync_coord_fatal( "fork active thread wait" );
+        }
 }
 
