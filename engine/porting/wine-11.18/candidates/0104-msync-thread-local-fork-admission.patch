-                                              __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST )) return;
-        }
-    }
-}
-
-static void coord_depart(void)
-{
-    unsigned int value = __atomic_sub_fetch( &coord_admission, 1, __ATOMIC_SEQ_CST );
-    if (value == COORD_ADMISSION_CLOSED)
-        __ulock_wake( 1 | ULF_WAKE_ALL, &coord_admission, 0 );
+        __atomic_store_n( &data->msync_in_transaction, 1, __ATOMIC_SEQ_CST );
+        if (!__atomic_load_n( &coord_forking, __ATOMIC_SEQ_CST )) return;
