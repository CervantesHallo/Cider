--- a/dlls/ntdll/unix/msync.c
+++ b/dlls/ntdll/unix/msync.c
@@ -240,9 +240,8 @@
 /* Only short publication/release regions defer Wine control signals. Blocking
  * waits and Mach map exchanges remain interruptible. No kernel signal-mask
  * operation is needed on the hot path. */
-void msync_control_begin(void)
-{
-    struct thread_data *data = get_thread_data();
+void msync_control_begin_data( struct thread_data *data )
+{
     /* Only this executor writes depth; signal handlers read/defer. A signal
      * before publication sees the old safe region; after it sees the new one.
      * Keep atomic stores and the compiler fence, without a shared RMW. */
@@ -251,14 +250,25 @@
     __atomic_signal_fence( __ATOMIC_SEQ_CST );
 }
 
-void msync_control_end(void)
-{
-    struct thread_data *data = get_thread_data();
+void msync_control_end_data( struct thread_data *data )
+{
     unsigned int depth;
     __atomic_signal_fence( __ATOMIC_SEQ_CST );
     depth = (unsigned int)__atomic_load_n( &data->msync_control_depth, __ATOMIC_RELAXED ) - 1;
     __atomic_store_n( &data->msync_control_depth, (sig_atomic_t)depth, __ATOMIC_RELAXED );
     if (!depth) msync_replay_controls_data( data );
+}
+
+/* General callers retain the original lookup; native frames may reuse their
+ * already pinned same-thread record without changing control boundaries. */
+void msync_control_begin(void)
+{
+    msync_control_begin_data( get_thread_data() );
+}
+
+void msync_control_end(void)
+{
+    msync_control_end_data( get_thread_data() );
 }
 
