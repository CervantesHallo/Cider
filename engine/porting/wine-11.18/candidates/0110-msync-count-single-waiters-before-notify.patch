--- /dev/null
+++ b/include/wine/msync_waiter_hint.h
@@ -0,0 +1,64 @@
+#ifndef __WINE_MSYNC_WAITER_HINT_H
+#define __WINE_MSYNC_WAITER_HINT_H
+#include "msync_coord.h"
+
+/* An advisory count, never a Windows permit count. The pump maintains MANY
+ * from its own exact node/temporary-registration count. A hard-killed client
+ * may leave a conservative overestimate; no new shared reference is held.
+ * At the hint limit STICKY permanently selects the original unconditional
+ * single-wake path until the object is destroyed. No API/state is clamped. */
+#define MSYNC_HINT_COUNT UINT32_C(0x1fffffff)
+#define MSYNC_HINT_PUBLISH UINT32_C(0x20000000)
+#define MSYNC_HINT_MANY UINT32_C(0x40000000)
+#define MSYNC_HINT_STICKY UINT32_C(0x80000000)
+static inline void msync_hint_enter( uint32_t *hint, int many )
+{
+    uint32_t old = __atomic_load_n( hint, __ATOMIC_SEQ_CST ), next;
+    for (;;)
+    {
+        if (old & MSYNC_HINT_STICKY)
+        {
+            if (many) __atomic_fetch_or( hint, MSYNC_HINT_MANY, __ATOMIC_SEQ_CST );
+            return;
+        }
+        if ((old & MSYNC_HINT_COUNT) == MSYNC_HINT_COUNT)
+            next = (old & (MSYNC_HINT_MANY | MSYNC_HINT_PUBLISH)) | MSYNC_HINT_STICKY;
+        else next = old + 1;
+        if (many) next |= MSYNC_HINT_MANY;
+        if (__atomic_compare_exchange_n( hint, &old, next, 0,
+                                         __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST )) return;
+    }
+}
+static inline void msync_hint_leave( uint32_t *hint )
+{
+    uint32_t old = __atomic_load_n( hint, __ATOMIC_SEQ_CST );
+    for (;;)
+    {
+        if (old & MSYNC_HINT_STICKY) return;
+        if (!(old & MSYNC_HINT_COUNT)) msync_coord_fatal( "wait hint underflow" );
+        if (__atomic_compare_exchange_n( hint, &old, old - 1, 0,
+                                         __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST )) return;
+    }
+}
+static inline void msync_hint_clear_many( uint32_t *hint )
+{
+    __atomic_fetch_and( hint, ~MSYNC_HINT_MANY, __ATOMIC_SEQ_CST );
+}
+static inline uint32_t msync_hint_snapshot( uint32_t *hint )
+{
+    /* Change an irrelevant bit so the toolchain must perform a real same-word
+     * RMW, rather than lower a zero-op RMW to a stack fence plus load. Publish
+     * preceding payload stores to subsequent registering RMWs; every live hint
+     * write preserves that release sequence. Nothing depends on this bit's
+     * value or on its wrap period. Only COUNT/MANY/STICKY decide notification. */
+    return __atomic_fetch_xor( hint, MSYNC_HINT_PUBLISH, __ATOMIC_SEQ_CST );
+}
+static inline int msync_hint_wake_single( uint32_t hint )
+{
+    return !!(hint & (MSYNC_HINT_COUNT | MSYNC_HINT_STICKY));
+}
+static inline int msync_hint_wake_many( uint32_t hint )
+{
+    return !!(hint & MSYNC_HINT_MANY);
+}
+#endif
