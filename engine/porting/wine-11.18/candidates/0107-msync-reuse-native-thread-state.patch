+     * Keep atomic stores and the compiler fence, without a shared RMW. */
+    unsigned int depth = __atomic_load_n( &data->msync_control_depth, __ATOMIC_RELAXED );
+    __atomic_store_n( &data->msync_control_depth, (sig_atomic_t)(depth + 1), __ATOMIC_RELAXED );
     __atomic_signal_fence( __ATOMIC_SEQ_CST );
 }
 
 void msync_control_end(void)
 {
     struct thread_data *data = get_thread_data();
+    unsigned int depth;
     __atomic_signal_fence( __ATOMIC_SEQ_CST );
