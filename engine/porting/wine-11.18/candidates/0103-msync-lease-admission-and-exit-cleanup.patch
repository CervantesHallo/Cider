+static inline void msync_coord_give( struct msync_coord_guard *guard )
+{
+    struct msync_coord_header *header = guard->coord->header;
+    uint64_t expected = guard->token;
+    if (!__atomic_compare_exchange_n( &header->owner, &expected, 0, 0,
