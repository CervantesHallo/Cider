+/* Single writer: the Mach pump. A seqlock permits coherent read-only native
+ * observations without adding logging, RPCs, or a gate to the pump. */
+static inline void pool_statistics( int allocation, int fallback )
+{
+    struct msync_coord_statistics *stats;
+    uint64_t current;
+    if (!stats_enabled) return;
+    stats = msync_statistics();
+    __atomic_add_fetch( &stats->sequence, 1, __ATOMIC_SEQ_CST );
+    current = __atomic_load_n( &stats->current, __ATOMIC_RELAXED );
+    if (allocation)
+    {
+        __atomic_add_fetch( &stats->allocations, 1, __ATOMIC_RELAXED );
+        ++current;
+        if (fallback)
+        {
+            __atomic_add_fetch( &stats->fallback_total, 1, __ATOMIC_RELAXED );
+            __atomic_add_fetch( &stats->fallback_current, 1, __ATOMIC_RELAXED );
+        }
+    }
+    else
+    {
+        if (!current) msync_coord_fatal( "wait node statistics underflow" );
+        __atomic_add_fetch( &stats->frees, 1, __ATOMIC_RELAXED );
+        --current;
+        if (fallback)
+        {
+            if (!__atomic_load_n( &stats->fallback_current, __ATOMIC_RELAXED ))
+                msync_coord_fatal( "fallback statistics underflow" );
+            __atomic_sub_fetch( &stats->fallback_current, 1, __ATOMIC_RELAXED );
+        }
+    }
+    __atomic_store_n( &stats->current, current, __ATOMIC_RELAXED );
+    if (current > __atomic_load_n( &stats->peak, __ATOMIC_RELAXED ))
+        __atomic_store_n( &stats->peak, current, __ATOMIC_RELAXED );
+    __atomic_store_n( &stats->pool_free, pool->count, __ATOMIC_RELAXED );
+    __atomic_add_fetch( &stats->sequence, 1, __ATOMIC_RELEASE );
+}
 
