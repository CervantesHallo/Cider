+            ret = __ulock_wait( MSYNC_COORD_UL_SHARED | MSYNC_COORD_UL_NO_ERRNO,
+                                &header->wake_sequence, sequence, 1000 );
+            if (ret == -ETIMEDOUT && __atomic_load_n( &header->owner, __ATOMIC_SEQ_CST ) == owner &&
+                msync_coord_reclaim( guard, owner ))
