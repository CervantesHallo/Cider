+static inline int msync_coord_reclaim( struct msync_coord_guard *guard, uint64_t owner )
+{
+    struct msync_coord_header *header = guard->coord->header;
+    struct flock lease = {0};
+    uint64_t expected = owner;
+    int ret, acquired;
+    if (!owner || owner >= INT64_MAX - 2) msync_coord_fatal( "owner lease" );
+    lease.l_type = F_WRLCK;
+    lease.l_whence = SEEK_SET;
+    lease.l_start = (off_t)(owner + 2);
+    lease.l_len = 1;
+    do ret = fcntl( guard->fd, F_OFD_SETLK, &lease ); while (ret < 0 && errno == EINTR);
+    if (ret < 0)
+    {
+        if (errno == EAGAIN || errno == EACCES) return 0; /* executor still owns its lease */
+        msync_coord_fatal( "owner lease probe" );
+    }
+    acquired = __atomic_compare_exchange_n( &header->owner, &expected, guard->token,
+                                           0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST );
+    msync_coord_lock( guard->fd, F_UNLCK, (off_t)(owner + 2) );
+    return acquired;
+}
+
+static inline void msync_coord_take( struct msync_coord_guard *guard )
+{
+    struct msync_coord_header *header = guard->coord->header;
+    uint64_t expected, owner;
+    uint32_t sequence;
+    unsigned int spin;
+    int ret;
+    if (!guard->token) msync_coord_fatal( "missing lease" );
+    for (;;)
+    {
+        for (spin = 0; spin < 512; ++spin)
+        {
+            expected = __atomic_load_n( &header->owner, __ATOMIC_RELAXED );
+            if (expected)
+            {
+                if (expected == guard->token) msync_coord_fatal( "recursive transaction" );
+                msync_coord_pause();
+                continue;
+            }
+            if (__atomic_compare_exchange_n( &header->owner, &expected, guard->token,
+                                              0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST )) return;
+            if (expected == guard->token) msync_coord_fatal( "recursive transaction" );
+            msync_coord_pause();
+        }
+        sequence = __atomic_load_n( &header->wake_sequence, __ATOMIC_SEQ_CST );
+        __atomic_store_n( &header->wait_hint, 1, __ATOMIC_SEQ_CST );
+        owner = __atomic_load_n( &header->owner, __ATOMIC_SEQ_CST );
+        if (owner)
