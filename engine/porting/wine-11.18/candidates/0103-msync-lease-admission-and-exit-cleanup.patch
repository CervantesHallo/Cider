+/* A token is never reused in this instance. Its EX byte remains locked until
+ * the independent description closes. Recoverers use the kernel lease as proof
+ * that an old executor can no longer write, not a timeout or logical TID state. */
+static inline uint64_t msync_coord_new_lease( struct msync_coord *coord, int fd )
+{
+    uint64_t previous = __atomic_load_n( &coord->header->next_lease, __ATOMIC_RELAXED );
+    do
+    {
+        if (previous >= INT64_MAX - 3) msync_coord_fatal( "lease overflow" );
+    } while (!__atomic_compare_exchange_n( &coord->header->next_lease, &previous, previous + 1,
+                                          0, __ATOMIC_SEQ_CST, __ATOMIC_RELAXED ));
+    msync_coord_lock( fd, F_WRLCK, (off_t)(previous + 3) );
+    return previous + 1;
+}
