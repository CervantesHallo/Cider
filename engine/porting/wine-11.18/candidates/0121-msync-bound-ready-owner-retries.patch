-/* Caller protects controls/cancellation and its admission for this CPU-only
- * attempt. No waiting, fd probe, mapping, journal recovery or notification.
- * A failed attempt leaves the journal untouched; an acquired dirty gate is
- * released, including the original wake sequence and guarded kernel wake. */
-static inline int msync_coord_try_clean( struct msync_coord *coord, int fd, uint64_t token,
-                                        struct msync_coord_guard *guard )
-{
-    uint64_t expected = 0;
-    if (!token) return 0;
+/* Same finite CPU budget as the normal gate take; no kernel wait, lease
+ * probe, allocation, or event readiness retry. The caller keeps its original
+ * native frame/admission and control guard for the whole short attempt. */
+#define MSYNC_COORD_TRY_SPINS 512u
+static inline int msync_coord_try_clean_bounded( struct msync_coord *coord, int fd, uint64_t token,
+                                                struct msync_coord_guard *guard, unsigned int max_spins )
+{
+    uint64_t expected;
+    unsigned int spin;
+    if (!token || !max_spins || max_spins > MSYNC_COORD_TRY_SPINS) return 0;
     guard->coord = coord;
     guard->fd = fd;
     guard->token = token;
     guard->cancel_state = -1;
-    if (!__atomic_compare_exchange_n( &coord->header->owner, &expected, token, 0,
-                                      __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST )) return 0;
-    if (__atomic_load_n( &coord->header->state, __ATOMIC_ACQUIRE ) == MSYNC_COORD_CLEAN) return 1;
-    msync_coord_give( guard );
+    for (spin = 0; spin < max_spins; ++spin)
+    {
+        /* Match normal take's load-before-CAS behavior: do not bounce the
+         * owner's cache line with failed locked RMWs while it is visibly busy. */
+        expected = __atomic_load_n( &coord->header->owner, __ATOMIC_RELAXED );
+        if (expected)
+        {
+            if (expected == token) return 0;
+            msync_coord_pause();
+            continue;
+        }
+        if (__atomic_compare_exchange_n( &coord->header->owner, &expected, token, 0,
+                                          __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST ))
+        {
+            if (__atomic_load_n( &coord->header->state, __ATOMIC_ACQUIRE ) == MSYNC_COORD_CLEAN) return 1;
+            /* Dirty journals promptly reach the original recovery path. */
+            msync_coord_give( guard );
+            return 0;
+        }
+        if (expected == token) return 0;
+        msync_coord_pause();
+    }
     return 0;
+}
+
+/* Retain the original single-attempt helper for callers and fixtures that
+ * need a poll, including the zero-timeout ready-event path. */
+static inline int msync_coord_try_clean( struct msync_coord *coord, int fd, uint64_t token,
+                                        struct msync_coord_guard *guard )
+{
+    return msync_coord_try_clean_bounded( coord, fd, token, guard, 1 );
 }
 
 static inline struct msync_coord_header *msync_coord_map( int fd )
