+/* Caller has a pinned cached event and holds its short Wine control guard.
+ * No slow descriptor/TLV initialization, mapping, wait, recovery or notification
+ * may occur. Anything outside this closed CPU path retries under the old mask. */
+NTSTATUS msync_try_wait_ready_event( int obj )
+{
+    struct coord_fd_record *record;
+    struct thread_data *data = get_thread_data();
+    struct msync_coord_guard guard;
+    struct msync_coord_entry entry;
+    struct event *event;
+    unsigned int tid = GetCurrentThreadId();
+    NTSTATUS status = STATUS_PENDING;
+    if (!__atomic_load_n( &coord_fd_key_ready, __ATOMIC_ACQUIRE ) ||
+        !(record = pthread_getspecific( coord_fd_key ))) return STATUS_PENDING;
+    /* No TLV expression here: the compiler may hoist its resolver across an
+     * earlier NULL-key branch. Fork-child retirement is copied into the existing
+     * pthread record before its inherited descriptor closes. */
+    if (record->retired || !data->msync_private_frames || !data->msync_control_depth ||
+        record->thread_data != data || !data->msync_epoch || (data->msync_epoch & 1) ||
+        tid >= MSYNC_COORD_TIDS ||
+        __atomic_load_n( &msync_coord_epochs( &coord )[tid], __ATOMIC_ACQUIRE ) != data->msync_epoch ||
+        !(event = coord_slot( obj, 0 ))) return STATUS_PENDING;
+    __atomic_store_n( &data->msync_in_transaction, 1, __ATOMIC_SEQ_CST );
+    if (!__atomic_load_n( &coord_forking, __ATOMIC_SEQ_CST ) &&
+        msync_coord_try_clean( &coord, record->fd, record->token, &guard ))
+    {
+        /* The server can retire an epoch before this attempt acquires owner.
+         * Validate again inside owner, exactly like the ordinary entry path. */
+        if (__atomic_load_n( &msync_coord_epochs( &coord )[tid], __ATOMIC_ACQUIRE ) == data->msync_epoch &&
+            (event->msync_type == MSYNC_AUTO_EVENT || event->msync_type == MSYNC_MANUAL_EVENT) &&
+            event->signaled)
+        {
+            entry = (struct msync_coord_entry){ obj, 0,
+                msync_coord_value( event->msync_type == MSYNC_AUTO_EVENT ? 0 : event->signaled,
+                                   event->unused ) };
+            msync_coord_commit( &coord, &entry, 1 );
+            status = STATUS_SUCCESS;
+        }
+        msync_coord_give( &guard );
+    }
+    coord_depart( data );
+    return status;
 }
 
