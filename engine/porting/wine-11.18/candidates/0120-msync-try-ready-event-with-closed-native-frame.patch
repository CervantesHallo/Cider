+/* Only the ready-only attempt uses this mode. Controls remain deferred until
+ * its pins/owner/admission are drained; it cannot call a cancellation point. */
+static void inproc_frame_enter_ready( struct inproc_frame *frame )
+{
+    struct thread_data *data = get_thread_data();
+    msync_control_begin_data( data );
+    if (pthread_setcanceltype( PTHREAD_CANCEL_DEFERRED, &frame->cancel_type )) _exit(1);
+    frame->cancel_state = -1;
+    frame->data = data;
+    frame->prev = data->msync_frames;
+    frame->count = 0;
+    data->msync_frames = frame;
+    data->msync_private_frames++;
+}
+
+static void inproc_frame_mask( struct inproc_frame *frame )
+{
+    if (frame->cancel_state == -1 &&
+        pthread_setcancelstate( PTHREAD_CANCEL_DISABLE, &frame->cancel_state )) _exit(1);
+}
+
+/* Called before the ready attempt can cross any kernel-wake boundary. Once
+ * escalated, its original state is restored only after complete frame cleanup. */
+void inproc_prepare_kernel(void)
+{
+    struct inproc_frame *frame = get_thread_data()->msync_frames;
+    if (frame && frame->cancel_type != -1) inproc_frame_mask( frame );
+}
+
+static void inproc_frame_promote( struct inproc_frame *frame )
+{
+    inproc_frame_mask( frame );
+    /* Never restore an incoming ASYNCHRONOUS type while enabled on fallback. */
+    if (frame->cancel_type != -1)
+    {
+        if (pthread_setcanceltype( frame->cancel_type, NULL )) _exit(1);
+        frame->cancel_type = -1;
+    }
+    while (frame->count) release_inproc_sync( frame->pins[--frame->count] );
+}
+
