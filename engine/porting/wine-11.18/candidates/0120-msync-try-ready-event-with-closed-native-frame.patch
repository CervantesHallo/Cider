-    if (pthread_setcancelstate( frame->cancel_state, NULL )) _exit(1);
+    if (frame->cancel_state != -1 && pthread_setcancelstate( frame->cancel_state, NULL )) _exit(1);
+    if (frame->cancel_type != -1 && pthread_setcanceltype( frame->cancel_type, NULL )) _exit(1);
     msync_control_end_data( data );
 }
 
