+/* Caller protects controls/cancellation and its admission for this CPU-only
+ * attempt. No waiting, fd probe, mapping, journal recovery or notification.
+ * A failed attempt leaves the journal untouched; an acquired dirty gate is
+ * released, including the original wake sequence and guarded kernel wake. */
+static inline int msync_coord_try_clean( struct msync_coord *coord, int fd, uint64_t token,
+                                        struct msync_coord_guard *guard )
+{
+    uint64_t expected = 0;
+    if (!token) return 0;
+    guard->coord = coord;
+    guard->fd = fd;
+    guard->token = token;
+    guard->cancel_state = -1;
+    if (!__atomic_compare_exchange_n( &coord->header->owner, &expected, token, 0,
+                                      __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST )) return 0;
+    if (__atomic_load_n( &coord->header->state, __ATOMIC_ACQUIRE ) == MSYNC_COORD_CLEAN) return 1;
+    msync_coord_give( guard );
