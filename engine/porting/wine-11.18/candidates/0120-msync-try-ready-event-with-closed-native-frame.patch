+        struct inproc_sync *sync = frame->pins[frame->count - 1];
+        unsigned int attempts;
+        LONG old;
+        if (frame->cancel_type != -1 && frame->cancel_state == -1)
+        {
+            /* Only a nonterminal decrement is CP-free. Do not touch sync after
+             * a successful CAS; another thread may release the surviving ref. */
+            old = InterlockedCompareExchange( &sync->refcount, 0, 0 );
+            for (attempts = 0; old > 1 && attempts < 8; ++attempts)
+            {
+                LONG actual = InterlockedCompareExchange( &sync->refcount, old - 1, old );
+                if (actual == old) break;
+                old = actual;
+            }
+            if (old > 1 && attempts < 8) { --frame->count; continue; }
+            /* Mask BEFORE removing the final pin accounting or close delivery. */
+            inproc_frame_mask( frame );
+        }
