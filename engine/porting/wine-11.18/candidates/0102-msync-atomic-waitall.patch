+    /* map=0 must never allocate or send an RPC. map=1 is only called unlocked. */
+    void *(*slot)( unsigned int idx, int map );
+    /* blocking=0 must only try a kernel wake/Mach send, never RPC or wait. */
+    int (*notify)( unsigned int idx, void *shm, int blocking );
+    void (*set_active)( int active );
+    int (*get_fd)(void); /* refreshed under local quiescence after a fork */
