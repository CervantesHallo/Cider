+static void coord_fork_parent(void)
+{
+    struct coord_fd_record *record;
+    int saved_errno = errno;
+    /* The child may not have run its close callback yet. Replace EVERY
+     * parent's idle description, so no FUTURE gate lock is shared with it. */
+    for (record = coord_fds; record; record = record->next)
