+        record->fd = msync_coord_open( inproc_device_fd );
+    }
+    pthread_mutex_unlock( &coord_fd_mutex );
+    pthread_mutex_unlock( &coord_local_gate );
+    pthread_sigmask( SIG_SETMASK, &coord_fork_signals, NULL );
+    pthread_setcancelstate( coord_fork_cancel_state, NULL );
+    errno = saved_errno;
