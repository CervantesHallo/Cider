+static inline void msync_coord_lock( int fd, short type, off_t start )
+{
+    struct flock lock = {0};
+    int ret;
+    lock.l_type = type;
+    lock.l_whence = SEEK_SET;
+    lock.l_start = start;
+    lock.l_len = 1;
+    do ret = fcntl( fd, F_OFD_SETLKW, &lock ); while (ret < 0 && errno == EINTR);
+    if (ret < 0) msync_coord_fatal( "OFD lock" );
