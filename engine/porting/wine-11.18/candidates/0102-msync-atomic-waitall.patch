+    msync_coord_signal_mask( &mask, &server_block_set );
+    if (coord_retired) return; /* pre-exec child already closed inherited records */
+    if (pthread_setcancelstate( PTHREAD_CANCEL_DISABLE, &cancel_state ) ||
+        pthread_sigmask( SIG_BLOCK, &mask, &signals )) msync_coord_fatal( "cleanup mask" );
+    if (record)
