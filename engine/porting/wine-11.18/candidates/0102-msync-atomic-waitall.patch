+/* All target slots must be prefetched and pinned by their normal handle cache
+ * (or the server object). The allocator also enters this gate before reuse. */
+static inline void msync_coord_commit( struct msync_coord *coord, const struct msync_coord_entry *entries,
+                                unsigned int count )
+{
+    struct msync_coord_header *header = coord->header;
+    unsigned int i;
+    if (!count) return;
+    if (count > MSYNC_COORD_ENTRIES || header->state != MSYNC_COORD_CLEAN || header->sequence == UINT64_MAX)
+        msync_coord_fatal( "commit bounds" );
+    __atomic_store_n( &header->state, MSYNC_COORD_PREPARING, __ATOMIC_RELEASE );
+    ++header->sequence;
+    header->count = count;
