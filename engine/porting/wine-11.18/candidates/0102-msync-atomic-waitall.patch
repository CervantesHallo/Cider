+     * a stopped pre-exec child must not retain its parent's transaction lock. */
+    for (record = coord_fds; record; record = record->next) close( record->fd );
+    coord_fds = coord_record = NULL;
+    coord_retired = 1; /* child must exec/_exit; never enter the old Wine instance */
+    coord_fork_parent();
