+static int prepare_acquire( int obj, void *shm, unsigned int tid,
+                            struct msync_coord_entry *entry, int *abandoned )
+{
+    struct event *event = shm;
+    struct mutex *mutex = shm;
+    struct semaphore *semaphore = shm;
+    *entry = (struct msync_coord_entry){ obj, 0, __atomic_load_n( (uint64_t *)shm, __ATOMIC_ACQUIRE ) };
+    switch (event->msync_type)
+    {
+    case MSYNC_SEMAPHORE:
+        if (!semaphore->count) return 0;
+        entry->value = msync_coord_value( semaphore->count - 1, semaphore->max );
+        return 1;
+    case MSYNC_MUTEX:
+        if (mutex->tid && mutex->tid != ~0 && mutex->tid != tid) return 0;
+        if (mutex->count == UINT_MAX) return 0; /* saturated upstream ntsync recursion count */
+        if (mutex->tid == ~0) *abandoned = 1;
+        entry->value = msync_coord_value( tid, mutex->tid == tid ? mutex->count + 1 : 1 );
+        return 1;
+    case MSYNC_AUTO_EVENT:
+    case MSYNC_AUTO_SERVER:
+        if (!event->signaled) return 0;
+        entry->value = msync_coord_value( 0, event->unused );
+        return 1;
+    case MSYNC_MANUAL_EVENT:
+    case MSYNC_MANUAL_SERVER:
+        return !!event->signaled;
+    default:
+        msync_coord_fatal( "object type" );
+        return 0;
+    }
+}
