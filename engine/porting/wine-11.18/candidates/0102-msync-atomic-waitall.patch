+static void coord_fork_prepare(void)
+{
+    sigset_t mask;
+    msync_coord_signal_mask( &mask, &server_block_set );
+    if (pthread_setcancelstate( PTHREAD_CANCEL_DISABLE, &coord_fork_cancel_state ) ||
+        pthread_sigmask( SIG_BLOCK, &mask, &coord_fork_signals ) ||
+        pthread_mutex_lock( &coord_local_gate ) || pthread_mutex_lock( &coord_fd_mutex )) msync_coord_fatal( "fork prepare" );
