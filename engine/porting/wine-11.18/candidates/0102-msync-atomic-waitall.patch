+/* No Wine exception/debugger/server callback is safe while owning the gate.
+ * A broken backend terminates the Unix process; it must not return a false
+ * failure after a committed release, nor keep the shared gate locked. */
+static inline void msync_coord_fatal( const char *operation )
+{
+    /* Even stderr can be a full blocking pipe. Never wait for diagnostics
+     * while holding a shared gate, or enter Wine's assertion/debugger path. */
+    (void)operation;
+    _exit(1);
