+/* Conservative potential payload-ulock waiters. Collisions and a killed
+ * process may leave extra wakes; no notifier or slot reuse clears a bucket.
+ * UINT32_MAX is sticky, so this hint can never wrap to a false zero. */
+struct msync_single_waiter
+{
+    struct msync_single_waiter *prev;
+    uint32_t *counter;
+    unsigned int idx;
+};
+
+static inline uint32_t *msync_coord_hint( struct msync_coord *coord, unsigned int idx )
+{
+    if (!idx || idx > 0x0fffffff) msync_coord_fatal( "single hint index" );
+    return (uint32_t *)((char *)coord->header + MSYNC_COORD_HINT_OFFSET) +
+           (idx & (MSYNC_COORD_HINT_BUCKETS - 1));
+}
+
+static inline int msync_coord_event_waiters( struct msync_coord *coord, unsigned int idx )
+{
+    return __atomic_load_n( msync_coord_hint( coord, idx ), __ATOMIC_SEQ_CST ) != 0;
+}
+
+static inline void msync_coord_hint_add( uint32_t *counter )
+{
+    uint32_t value = __atomic_load_n( counter, __ATOMIC_RELAXED );
+    while (value != UINT32_MAX &&
+           !__atomic_compare_exchange_n( counter, &value, value + 1, 0,
+                                         __ATOMIC_SEQ_CST, __ATOMIC_RELAXED ));
+}
+
+static inline void msync_coord_hint_remove( uint32_t *counter )
+{
+    uint32_t value = __atomic_load_n( counter, __ATOMIC_RELAXED );
+    for (;;)
+    {
+        if (value == UINT32_MAX) return;
+        if (!value) msync_coord_fatal( "single hint underflow" );
+        if (__atomic_compare_exchange_n( counter, &value, value - 1, 0,
+                                         __ATOMIC_SEQ_CST, __ATOMIC_RELAXED )) return;
+    }
+}
+
+static inline void msync_coord_single_publish( struct msync_coord_guard *guard,
+        struct msync_single_waiter **head, struct msync_single_waiter *waiter, unsigned int idx )
+{
+    if (waiter->counter || !guard->token ||
+        __atomic_load_n( &guard->coord->header->owner, __ATOMIC_RELAXED ) != guard->token)
+        msync_coord_fatal( "single hint publication outside owner" );
+    waiter->counter = msync_coord_hint( guard->coord, idx );
+    waiter->idx = idx;
+    waiter->prev = *head;
+    msync_coord_hint_add( waiter->counter );
+    *head = waiter;
+}
+
+/* Caller defers controls. This does not acquire owner or consult a possibly
+ * retired epoch, and must run before the native caller releases its pins. */
+static inline void msync_coord_single_remove( struct msync_single_waiter **head,
+                                              struct msync_single_waiter *waiter )
+{
+    uint32_t *counter = waiter->counter;
+    if (*head != waiter || !counter) msync_coord_fatal( "single hint stack" );
+    *head = waiter->prev;
+    waiter->counter = NULL;
+    msync_coord_hint_remove( counter );
+}
+
+static inline void msync_coord_single_unknown( struct msync_coord_guard *guard, unsigned int idx )
+{
+    if (!guard->token || __atomic_load_n( &guard->coord->header->owner, __ATOMIC_RELAXED ) != guard->token)
+        msync_coord_fatal( "unknown single hint outside owner" );
+    __atomic_store_n( msync_coord_hint( guard->coord, idx ), UINT32_MAX, __ATOMIC_SEQ_CST );
+}
+
+static inline void msync_coord_single_fork_child( struct msync_single_waiter **head )
+{
+    *head = NULL; /* inherited addresses are not a child's registrations */
 }
 
