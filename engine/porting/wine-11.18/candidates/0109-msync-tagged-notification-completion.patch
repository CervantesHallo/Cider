+/* One atomic word binds phase to a never-reused serial. A completed notifier
+ * may clear exactly its APPLIED decision without acquiring the owner again. */
+#define MSYNC_COORD_PHASE_MASK UINT64_C(3)
+#define MSYNC_COORD_SERIAL_MAX (UINT64_MAX >> 2)
+static inline unsigned int msync_coord_phase( const struct msync_coord_header *header )
+{
+    return __atomic_load_n( &header->decision, __ATOMIC_ACQUIRE ) & MSYNC_COORD_PHASE_MASK;
+}
+static inline uint64_t msync_coord_serial( const struct msync_coord_header *header )
+{
+    return __atomic_load_n( &header->decision, __ATOMIC_ACQUIRE ) >> 2;
+}
+static inline void msync_coord_notify_pending( struct msync_coord *coord,
+              const struct msync_coord_entry *pending, void **slots, unsigned int count )
+{
+    unsigned int i;
+    for (i = 0; i < count; ++i)
+        if (pending[i].notify && !coord->notify( pending[i].idx, slots[i], 1 ))
+            msync_coord_fatal( "blocking notification did not complete" );
+}
+static inline void msync_coord_clear_applied( struct msync_coord *coord, uint64_t tag )
+{
+    uint64_t expected = tag;
+    if ((tag & MSYNC_COORD_PHASE_MASK) != MSYNC_COORD_APPLIED)
+        msync_coord_fatal( "notification decision phase" );
+    /* A newer transaction must never lose its notification obligations. A
+     * failed comparison means another helper finished or the serial advanced. */
+    __atomic_compare_exchange_n( &coord->header->decision, &expected,
+                                tag & ~MSYNC_COORD_PHASE_MASK, 0,
+                                __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST );
+}
