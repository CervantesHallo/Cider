+/* Caller still owns its completed commit and pins. Capture that exact journal
+ * before dropping owner; do not reacquire merely to retrieve our own snapshot. */
+static inline void msync_coord_finish( struct msync_coord_guard *guard )
+{
+    struct msync_coord *coord = guard->coord;
+    struct msync_coord_header *header = coord->header;
+    struct msync_coord_entry pending[MSYNC_COORD_ENTRIES];
+    void *slots[MSYNC_COORD_ENTRIES];
+    uint64_t tag = __atomic_load_n( &header->decision, __ATOMIC_ACQUIRE );
+    unsigned int count, i;
+    if ((tag & MSYNC_COORD_PHASE_MASK) == MSYNC_COORD_CLEAN)
+    {
+        msync_coord_leave( guard );
+        return;
+    }
+    count = header->count;
+    if ((tag & MSYNC_COORD_PHASE_MASK) != MSYNC_COORD_APPLIED ||
+        !count || count > MSYNC_COORD_ENTRIES)
+        msync_coord_fatal( "finish journal state" );
+    memcpy( pending, header->entries, count * sizeof(*pending) );
+    for (i = 0; i < count; ++i)
+        if (!(slots[i] = coord->slot( pending[i].idx, 0 )))
+            msync_coord_fatal( "finish unpinned slot" );
+    msync_coord_leave( guard );
+    msync_coord_notify_pending( coord, pending, slots, count );
+    msync_coord_clear_applied( coord, tag );
 }
 
