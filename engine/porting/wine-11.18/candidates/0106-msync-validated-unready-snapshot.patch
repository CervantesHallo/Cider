+/* This is only a no-state-change rejection. A ready object, an APC/mutex,
+ * an uncertain incarnation, or any in-flight journal uses the existing gate. */
+static int coord_snapshot_unready( void *shm, unsigned int tid )
+{
+    struct thread_data *data = get_thread_data();
+    struct event *event = shm;
+    struct msync_coord_snapshot view;
+    uint64_t value;
+    if (coord_thread.retired || !data->msync_private_frames) return 0;
+    if (event->msync_type != MSYNC_AUTO_EVENT && event->msync_type != MSYNC_SEMAPHORE) return 0;
+    if ((uint32_t)__atomic_load_n( (uint64_t *)shm, __ATOMIC_ACQUIRE )) return 0; /* hint only */
+    if (!msync_coord_snapshot_begin( &coord, tid, data->msync_epoch, &view )) return 0;
+    value = __atomic_load_n( (uint64_t *)shm, __ATOMIC_ACQUIRE );
+    return !(uint32_t)value && msync_coord_snapshot_end( &coord, &view );
+}
