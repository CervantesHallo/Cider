+/* A pinned read-only availability probe. Any uncertain view takes the normal
+ * transaction path, including recovery of pending writes/notifications. */
+struct msync_coord_snapshot
+{
+    uint64_t sequence;
+    uint64_t epoch;
+    unsigned int tid;
+};
+
+static inline int msync_coord_snapshot_begin( struct msync_coord *coord, unsigned int tid,
+                                               uint64_t epoch, struct msync_coord_snapshot *view )
+{
+    if (!epoch || (epoch & 1) || tid >= MSYNC_COORD_TIDS) return 0;
+    view->sequence = __atomic_load_n( &coord->header->sequence, __ATOMIC_SEQ_CST );
+    view->epoch = epoch;
+    view->tid = tid;
+    return !__atomic_load_n( &coord->header->owner, __ATOMIC_SEQ_CST ) &&
+           __atomic_load_n( &coord->header->state, __ATOMIC_ACQUIRE ) == MSYNC_COORD_CLEAN &&
+           __atomic_load_n( &msync_coord_epochs( coord )[tid], __ATOMIC_ACQUIRE ) == epoch;
+}
+
+static inline int msync_coord_snapshot_end( struct msync_coord *coord,
+                                             const struct msync_coord_snapshot *view )
+{
+    /* Pair the payload load with BOTH version observations, rather than merely
+     * an atomic_signal_fence which supplies no inter-thread ordering. */
+    __atomic_thread_fence( __ATOMIC_SEQ_CST );
+    return __atomic_load_n( &msync_coord_epochs( coord )[view->tid], __ATOMIC_ACQUIRE ) == view->epoch &&
+           !__atomic_load_n( &coord->header->owner, __ATOMIC_SEQ_CST ) &&
+           __atomic_load_n( &coord->header->state, __ATOMIC_ACQUIRE ) == MSYNC_COORD_CLEAN &&
+           __atomic_load_n( &coord->header->sequence, __ATOMIC_SEQ_CST ) == view->sequence;
+}
+
 static inline void msync_coord_leave( struct msync_coord_guard *guard )
 {
     msync_coord_give( guard );
