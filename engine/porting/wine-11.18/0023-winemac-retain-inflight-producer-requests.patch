+/* Consume the admitted request pin only after its synchronous operation and
+ * any failed-install disposal have returned. Nested RELEASE owns a separate pin. */
+static DWORD packet_producer_end(struct remote_producer *producer, UINT operation, DWORD error)
+{
+    pthread_mutex_lock(&remote_lock);
+    assert(producer->request_inflight);
+    --producer->request_inflight;
+    if (!producer->active && operation != MACDRV_REMOTE_RELEASE_PRODUCER) error = ERROR_PROCESS_ABORTED;
+    pthread_mutex_unlock(&remote_lock);
+    finalize_producer_watch(producer);
+    producer_release(producer);
     return error;
 }
