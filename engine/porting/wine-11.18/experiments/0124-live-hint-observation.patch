--- /dev/null
+++ b/dlls/ntdll/unix/hint-trace.cinc
@@ -0,0 +1,73 @@
+/* Private observation only. Called outside owner in original fully masked
+ * paths. No stdio/locale/heap locks: CPU formatting plus async-safe raw write.
+ * Missing/partial records are unavailable, never evidence of a zero count. */
+static unsigned int hint_trace_enabled;
+static int *(*hint_trace_errno)(void);
+
+static void hint_trace_configure(void)
+{
+    const char *value = getenv( "WINEMSYNC_TRACE_WAIT" );
+    if (!value || value[0] != '1' || value[1]) return;
+    hint_trace_errno = (void *)dlsym( RTLD_DEFAULT, "__error" );
+    if (hint_trace_errno)
+    {
+        volatile int warmup = *hint_trace_errno();
+        (void)warmup;
+        hint_trace_enabled = 1;
+    }
+}
+
+static void hint_trace_text( volatile char *buffer, unsigned int *length, const char *text )
+{
+    while (*text && *length < 512) buffer[(*length)++] = *text++;
+}
+
+static void hint_trace_uint( volatile char *buffer, unsigned int *length, uint64_t value )
+{
+    char digits[20];
+    unsigned int count = 0;
+    do { digits[count++] = '0' + value % 10; value /= 10; } while (value);
+    while (count && *length < 512) buffer[(*length)++] = digits[--count];
+}
+
+static void hint_trace_emit( unsigned int kind, HANDLE handle, unsigned int idx )
+{
+    volatile char buffer[512];
+    struct thread_data *data;
+    unsigned int length = 0;
+    uint32_t hint;
+    struct stat file;
+    int *error, previous;
+    if (!hint_trace_enabled || !coord.header || !idx || idx > 0x0fffffff) return;
+    error = hint_trace_errno();
+    previous = *error;
+    if (fstat( inproc_device_fd, &file )) { *error = previous; return; }
+    data = get_thread_data();
+    hint = __atomic_load_n( msync_coord_hint( &coord, idx ), __ATOMIC_SEQ_CST );
+    hint_trace_text( buffer, &length, "{\"type\":\"cider-live-hint\",\"phase\":\"" );
+    hint_trace_text( buffer, &length, kind ? "registered" : "reset" );
+    hint_trace_text( buffer, &length, "\",\"pid\":" );
+    hint_trace_uint( buffer, &length, (unsigned int)getpid() );
+    hint_trace_text( buffer, &length, ",\"windows_pid\":" );
+    hint_trace_uint( buffer, &length, HandleToULong( PsGetCurrentProcessId() ) );
+    hint_trace_text( buffer, &length, ",\"windows_tid\":" );
+    hint_trace_uint( buffer, &length, data->tid );
+    hint_trace_text( buffer, &length, ",\"windows_handle\":" );
+    hint_trace_uint( buffer, &length, (uintptr_t)handle );
+    hint_trace_text( buffer, &length, ",\"idx\":" );
+    hint_trace_uint( buffer, &length, idx );
+    hint_trace_text( buffer, &length, ",\"coord_dev\":" );
+    hint_trace_uint( buffer, &length, (uint32_t)file.st_dev );
+    hint_trace_text( buffer, &length, ",\"coord_ino\":" );
+    hint_trace_uint( buffer, &length, (uint64_t)file.st_ino );
+    hint_trace_text( buffer, &length, ",\"hint\":" );
+    hint_trace_uint( buffer, &length, hint );
+    hint_trace_text( buffer, &length, "}\n" );
+    if (length < sizeof(buffer)) (void)write( STDERR_FILENO, (const char *)buffer, length );
+    *error = previous;
+}
+
+void msync_trace_reset_index( HANDLE handle, int obj )
+{
+    hint_trace_emit( 0, handle, obj );
+}
