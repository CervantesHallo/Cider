+/* A PE worker waits on the real Wine process object and an owned stop event.
+ * The process handle pins its incarnation; no Unix PID sampling or reuse guess.
+ * One registry ref and one worker ref. Completion failure retains an explicit
+ * registry owner; a later STOP retries only cleanup notification, never START. */
+#include <assert.h>
+#include <stdarg.h>
+#include <string.h>
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winbase.h"
+#include "winternl.h"
+#include "unixlib.h"
+#include "remote_watch.h"
+#include "wine/debug.h"
+WINE_DEFAULT_DEBUG_CHANNEL(macdrv);
+
+struct process_watch
+{
+    struct process_watch *next;
+    LONG refs, worker_ref_live;
+    HANDLE process, stop, thread;
+    UINT32 original_handle;
+    BOOL linked, completion_ready, native_completed;
+    struct macdrv_remote_watch_completion completion;
+};
+static SRWLOCK watch_lock = SRWLOCK_INIT;
+static struct process_watch *watches;
+
+/* One timer per active process-local watch set. It supplies a runnable cleanup
+ * owner after publication failure or a dead wait worker, and is retired when
+ * the registry becomes empty. Timer callbacks never retain caller frames. */
+struct recovery_timer { struct recovery_timer *next; HANDLE handle; };
+static struct recovery_timer *active_timer, *retired_timers;
+static struct recovery_timer **retired_timer_tail = &retired_timers;
+static void CALLBACK recovery_tick(void *context, BOOLEAN fired);
+static DWORD arm_recovery_locked(void)
+{
+    struct recovery_timer *timer;
+    DWORD error;
+    if (active_timer) return ERROR_SUCCESS;
+    timer = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*timer));
+    if (!timer) return ERROR_NOT_ENOUGH_MEMORY;
+    if (!CreateTimerQueueTimer(&timer->handle, NULL, recovery_tick, NULL, 250, 250, WT_EXECUTEDEFAULT))
+    { error = GetLastError(); HeapFree(GetProcessHeap(), 0, timer); return error; }
+    active_timer = timer;
+    return ERROR_SUCCESS;
+}
+static void cleanup_one_retired_timer(void)
+{
+    struct recovery_timer *timer;
+    DWORD error;
+    AcquireSRWLockExclusive(&watch_lock);
+    timer = retired_timers;
+    if (timer)
+    {
+        retired_timers = timer->next;
+        if (!retired_timers) retired_timer_tail = &retired_timers;
+    }
+    ReleaseSRWLockExclusive(&watch_lock);
+    if (!timer) return;
+    if (DeleteTimerQueueTimer(NULL, timer->handle, NULL)) error = ERROR_SUCCESS;
+    else error = GetLastError();
+    /* IO_PENDING confirms deferred cancellation; callbacks use NULL context,
+     * pinned driver code and the global protected registry, not this owner. */
+    if (error == ERROR_SUCCESS || error == ERROR_IO_PENDING)
+        HeapFree(GetProcessHeap(), 0, timer);
+    else
+    {
+        AcquireSRWLockExclusive(&watch_lock);
+        timer->next = NULL; *retired_timer_tail = timer; retired_timer_tail = &timer->next;
+        ReleaseSRWLockExclusive(&watch_lock);
+        ERR("remote recovery timer delete failed %u; owner retained\n", (unsigned)error);
+    }
+}
+static void retire_empty_timer(void)
+{
+    AcquireSRWLockExclusive(&watch_lock);
+    if (!watches && active_timer)
+    {
+        active_timer->next = NULL;
+        *retired_timer_tail = active_timer;
+        retired_timer_tail = &active_timer->next;
+        active_timer = NULL;
+    }
+    ReleaseSRWLockExclusive(&watch_lock);
+    cleanup_one_retired_timer();
+}
+
+static void watch_release(struct process_watch *watch)
+{
+    if (InterlockedDecrement(&watch->refs)) return;
+    if (watch->process) CloseHandle(watch->process);
+    if (watch->stop) CloseHandle(watch->stop);
+    if (watch->thread) CloseHandle(watch->thread);
+    HeapFree(GetProcessHeap(), 0, watch);
+}
+static struct process_watch *watch_find(UINT64 id)
+{
+    struct process_watch *watch;
+    for (watch = watches; watch; watch = watch->next)
+        if (watch->completion.lease_id == id) return watch;
+    return NULL;
+}
+static void publish_completion(struct process_watch *watch)
+{
+    struct process_watch **cursor;
+    BOOL unlinked = FALSE, acknowledged, ended;
+    NTSTATUS status = STATUS_SUCCESS;
+    AcquireSRWLockShared(&watch_lock);
+    acknowledged = watch->native_completed;
+    ReleaseSRWLockShared(&watch_lock);
+    if (!acknowledged) status = MACDRV_CALL(remote_watch_complete, &watch->completion);
+    if (status && status != STATUS_NOT_FOUND)
+    {
+        if (status == STATUS_PENDING)
+            WARN("remote process cleanup pending %#llx; owner retained\n", (unsigned long long)watch->completion.lease_id);
+        else
+            ERR("remote process completion %#llx failed %#x; owner retained\n",
+                (unsigned long long)watch->completion.lease_id, (unsigned int)status);
+        return;
+    }
+    ended = WaitForSingleObject(watch->thread, 0) == WAIT_OBJECT_0;
+    AcquireSRWLockExclusive(&watch_lock);
+    watch->native_completed = TRUE;
+    /* Native acknowledgement alone does not retire the worker owner. Keep the
+     * recovery registry/timer until the kernel confirms that thread ended and
+     * its ref ledger was reconciled. */
+    if (watch->linked && ended && !watch->worker_ref_live)
+    {
+        for (cursor = &watches; *cursor != watch; cursor = &(*cursor)->next) assert(*cursor);
+        *cursor = watch->next;
+        watch->linked = FALSE;
+        unlinked = TRUE;
+    }
+    ReleaseSRWLockExclusive(&watch_lock);
+    if (unlinked) watch_release(watch); /* registry ref, caller still pins */
+    retire_empty_timer();
+}
+static DWORD WINAPI process_worker(void *context)
+{
+    struct process_watch *watch = context;
+    HANDLE handles[2] = { watch->stop, watch->process };
+    DWORD result = WaitForMultipleObjects(2, handles, FALSE, INFINITE), error = 0;
+    UINT32 outcome;
+    if (result == WAIT_OBJECT_0) outcome = MACDRV_REMOTE_WATCH_CANCELED;
+    else if (result == WAIT_OBJECT_0 + 1) outcome = MACDRV_REMOTE_WATCH_EXITED;
+    else
+    {
+        outcome = MACDRV_REMOTE_WATCH_FAILED;
+        error = result == WAIT_FAILED ? GetLastError() : ERROR_INVALID_DATA;
+    }
+    AcquireSRWLockExclusive(&watch_lock);
+    watch->completion.outcome = outcome;
+    watch->completion.error = error;
+    watch->completion_ready = TRUE;
+    ReleaseSRWLockExclusive(&watch_lock);
+    publish_completion(watch);
+    AcquireSRWLockExclusive(&watch_lock);
+    if (watch->worker_ref_live)
+    {
+        LONG remaining;
+        watch->worker_ref_live = 0;
+        /* Paired ledger update while registry ownership still exists. There
+         * is no killable exchange-to-release gap outside the lock. */
+        remaining = InterlockedDecrement(&watch->refs);
+        assert(remaining > 0);
+        (void)remaining;
+    }
+    ReleaseSRWLockExclusive(&watch_lock);
+    return 0; /* no further access to watch; timer observes kernel thread exit */
+}
+static DWORD start_watch(const struct macdrv_remote_watch_request *request)
+{
+    struct process_watch *watch;
+    HANDLE thread;
+    DWORD status;
+    if (!request->process_handle || !request->lease_id) return ERROR_INVALID_PARAMETER;
+    if (!(watch = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*watch)))) return ERROR_NOT_ENOUGH_MEMORY;
+    watch->refs = 2;
+    watch->worker_ref_live = 1;
+    watch->completion.lease_id = request->lease_id;
+    watch->original_handle = request->process_handle;
+    if (!DuplicateHandle(GetCurrentProcess(), ULongToHandle(request->process_handle), GetCurrentProcess(),
+                         &watch->process, SYNCHRONIZE, FALSE, 0))
+    {
+        status = GetLastError();
+        watch_release(watch); watch_release(watch);
+        return status;
+    }
+    if (!(watch->stop = CreateEventW(NULL, TRUE, FALSE, NULL)))
+    {
+        status = GetLastError();
+        watch_release(watch); watch_release(watch);
+        return status;
+    }
+    AcquireSRWLockExclusive(&watch_lock);
+    if (watch_find(request->lease_id))
+    {
+        ReleaseSRWLockExclusive(&watch_lock);
+        watch_release(watch); watch_release(watch);
+        return ERROR_ALREADY_EXISTS;
+    }
+    status = arm_recovery_locked();
+    if (status)
+    {
+        ReleaseSRWLockExclusive(&watch_lock);
+        watch_release(watch); watch_release(watch);
+        return status;
+    }
+    watch->next = watches;
+    watches = watch;
+    watch->linked = TRUE;
+    /* The worker cannot finish/unlink until this construction lock is released. */
+    thread = CreateThread(NULL, 0, process_worker, watch, 0, NULL);
+    watch->thread = thread;
+    if (!thread)
+    {
+        status = GetLastError();
+        watches = watch->next;
+        watch->linked = FALSE;
+        ReleaseSRWLockExclusive(&watch_lock);
+        watch_release(watch); watch_release(watch);
+        retire_empty_timer();
+        return status;
+    }
+    ReleaseSRWLockExclusive(&watch_lock);
+    return ERROR_SUCCESS;
+}
+static void CALLBACK recovery_tick(void *context, BOOLEAN fired)
+{
+    struct process_watch *watch, **snapshot;
+    SIZE_T count = 0, index = 0;
+    struct macdrv_remote_watch_recovery recovery = {sizeof(recovery), MACDRV_REMOTE_WATCH_VERSION, 0, 0};
+    NTSTATUS recovered;
+    (void)context; (void)fired;
+    recovered = MACDRV_CALL(remote_watch_recover, &recovery);
+    if (recovered) ERR("remote native cleanup retry failed %#x\n", (unsigned int)recovered);
+    cleanup_one_retired_timer();
+    AcquireSRWLockExclusive(&watch_lock);
+    for (watch = watches; watch; watch = watch->next) ++count;
+    snapshot = count && count <= ~(SIZE_T)0 / sizeof(*snapshot) ?
+               HeapAlloc(GetProcessHeap(), 0, count * sizeof(*snapshot)) : NULL;
+    if (snapshot)
+        for (watch = watches; watch; watch = watch->next)
+        { InterlockedIncrement(&watch->refs); snapshot[index++] = watch; }
+    ReleaseSRWLockExclusive(&watch_lock);
+    if (!snapshot) { retire_empty_timer(); return; }
+    for (index = 0; index < count; ++index)
+    {
+        DWORD state;
+        BOOL ready;
+        watch = snapshot[index];
+        state = WaitForSingleObject(watch->thread, 0);
+        AcquireSRWLockExclusive(&watch_lock);
+        if (state == WAIT_OBJECT_0)
+        {
+            if (!watch->completion_ready)
+            {
+                watch->completion.outcome = MACDRV_REMOTE_WATCH_FAILED;
+                watch->completion.error = ERROR_OPERATION_ABORTED;
+                watch->completion_ready = TRUE;
+            }
+            if (watch->worker_ref_live)
+            {
+                LONG remaining;
+                watch->worker_ref_live = 0;
+                remaining = InterlockedDecrement(&watch->refs);
+                assert(remaining > 0); /* snapshot pin remains */
+                (void)remaining;
+            }
+        }
+        ready = watch->completion_ready;
+        ReleaseSRWLockExclusive(&watch_lock);
+        if (state == WAIT_FAILED)
+            ERR("remote worker identity unreadable %u; registry retained\n", (unsigned)GetLastError());
+        if (ready) publish_completion(watch);
+        watch_release(watch); /* timer snapshot pin */
+    }
+    HeapFree(GetProcessHeap(), 0, snapshot);
+    retire_empty_timer();
+}
+static DWORD stop_watch(UINT64 id)
+{
+    struct process_watch *watch;
+    BOOL ready;
+    DWORD status = ERROR_SUCCESS;
+    AcquireSRWLockExclusive(&watch_lock);
+    watch = watch_find(id);
+    if (watch)
+    {
+        InterlockedIncrement(&watch->refs);
+        ready = watch->completion_ready;
+        if (!ready && !SetEvent(watch->stop)) status = GetLastError();
+    }
+    ReleaseSRWLockExclusive(&watch_lock);
+    if (!watch) return ERROR_NOT_FOUND;
+    if (ready) publish_completion(watch);
+    watch_release(watch);
+    return status;
+}
+NTSTATUS WINAPI macdrv_remote_watch_callback(void *args, ULONG size)
+{
+    struct macdrv_remote_watch_request request;
+    struct macdrv_remote_watch_reply reply;
+    if (!args || size != sizeof(request)) return STATUS_INVALID_PARAMETER;
+    memcpy(&request, args, sizeof(request));
+    if (request.magic != MACDRV_REMOTE_WATCH_MAGIC || request.version != MACDRV_REMOTE_WATCH_VERSION ||
+        !request.lease_id || (request.operation != MACDRV_REMOTE_WATCH_START && request.operation != MACDRV_REMOTE_WATCH_STOP) ||
+        (request.operation == MACDRV_REMOTE_WATCH_STOP && request.process_handle)) return STATUS_INVALID_PARAMETER;
+    reply.magic = request.magic; reply.version = request.version;
+    reply.operation = request.operation; reply.lease_id = request.lease_id;
+    reply.status = request.operation == MACDRV_REMOTE_WATCH_START ? start_watch(&request) : stop_watch(request.lease_id);
+    return NtCallbackReturn(&reply, sizeof(reply), STATUS_SUCCESS);
+}
