+/* Producer state is a Wine process-object lease, not a Unix PID observation.
+ * Revocation is called on Wine threads (USER handler or PE wait completion).
+ * Cocoa validation/disposal only reads state or releases plain native pins. */
+static struct remote_producer *producer_lookup_locked(UINT64 id)
+{
+    struct remote_producer *producer;
+    for (producer = producers; producer; producer = producer->next)
+        if (producer->id == id) return producer;
+    return NULL;
+}
+static void producer_release(struct remote_producer *producer)
+{
+    if (!producer || InterlockedDecrement(&producer->refs)) return;
+    assert(!producer->process && !producer->cleanup_process && !producer->listed &&
+           !producer->watched && !producer->cleanup_listed && !producer->cleanup_inflight);
+    root_release(producer->root);
+    free(producer);
+}
+static DWORD watch_control(UINT operation, HANDLE process, UINT64 id, BOOL *acknowledged)
+{
+    struct macdrv_remote_watch_request request = {0};
+    struct macdrv_remote_watch_reply reply;
+    void *returned = NULL;
+    ULONG size = 0;
+    NTSTATUS status;
+    UINT_PTR handle = (UINT_PTR)process;
+    if (acknowledged) *acknowledged = FALSE;
+    if (handle != (UINT32)handle) return ERROR_INVALID_HANDLE;
+    request.dispatch.callback = (UINT64)InterlockedCompareExchange64(&watch_callback, 0, 0);
+    request.magic = MACDRV_REMOTE_WATCH_MAGIC;
+    request.version = MACDRV_REMOTE_WATCH_VERSION;
+    request.operation = operation;
+    request.process_handle = handle;
+    request.lease_id = id;
+    status = KeUserDispatchCallback(&request.dispatch, sizeof(request), &returned, &size);
+    if (status) return RtlNtStatusToDosError(status);
+    if (!returned || size != sizeof(reply)) return ERROR_INVALID_DATA;
+    memcpy(&reply, returned, sizeof(reply));
+    if (reply.magic != request.magic || reply.version != request.version ||
+        reply.operation != operation || reply.lease_id != id) return ERROR_INVALID_DATA;
+    if (acknowledged) *acknowledged = TRUE;
+    return reply.status;
+}
+/* Stable final acknowledgement includes handle-owning control frames, not
+ * only nullable fields. Check and detach share remote_lock; finalized is terminal. */
+static void finalize_producer_watch(struct remote_producer *producer)
+{
+    struct remote_producer **cursor;
+    BOOL detached = FALSE;
+    pthread_mutex_lock(&remote_lock);
+    if (producer->watched && producer->completion_requested && !producer->process &&
+        !producer->cleanup_process && !producer->cleanup_listed && !producer->cleanup_inflight)
+    {
+        for (cursor = &producer_watches; *cursor != producer; cursor = &(*cursor)->watch_next) assert(*cursor);
+        *cursor = producer->watch_next;
+        producer->watched = FALSE;
+        producer->finalized = TRUE;
+        detached = TRUE;
+    }
+    pthread_mutex_unlock(&remote_lock);
+    if (detached) producer_release(producer); /* completion registry owner */
+}
+/* One explicit cleanup-list owner survives failed STOP/NtClose. Future USER
+ * requests retry at most one cleanup, never ACQUIRE/INSTALL or other mutations. */
+static void queue_producer_cleanup(struct remote_producer *producer)
+{
+    pthread_mutex_lock(&remote_lock);
+    if (!producer->cleanup_listed && (producer->cleanup_process || (producer->cleanup_pending && producer->watched)))
+    {
+        InterlockedIncrement(&producer->refs);
+        producer->cleanup_listed = TRUE;
+        producer->cleanup_next = NULL;
+        *producer_cleanup_tail = producer;
+        producer_cleanup_tail = &producer->cleanup_next;
+    }
+    pthread_mutex_unlock(&remote_lock);
+}
+static DWORD close_producer_process(struct remote_producer *producer, HANDLE process)
+{
+    NTSTATUS status;
+    if (!process || !(status = NtClose(process))) return ERROR_SUCCESS;
+    pthread_mutex_lock(&remote_lock);
+    assert(!producer->cleanup_process);
+    producer->cleanup_process = process;
+    pthread_mutex_unlock(&remote_lock);
+    queue_producer_cleanup(producer);
+    ERR("remote producer process close failed %#x; handle owner retained\n", (unsigned int)status);
+    return RtlNtStatusToDosError(status);
+}
+static DWORD stop_producer_watch(struct remote_producer *producer)
+{
+    DWORD status;
+    BOOL watched, acknowledged;
+    pthread_mutex_lock(&remote_lock);
+    watched = producer->watched;
+    if (watched) ++producer->cleanup_inflight;
+    pthread_mutex_unlock(&remote_lock);
+    if (!watched) return ERROR_SUCCESS;
+    status = watch_control(MACDRV_REMOTE_WATCH_STOP, NULL, producer->id, &acknowledged);
+    pthread_mutex_lock(&remote_lock);
+    if (acknowledged && status == ERROR_NOT_FOUND)
+    {
+        producer->completion_requested = TRUE;
+        status = ERROR_SUCCESS;
+    }
+    producer->cleanup_pending = status != ERROR_SUCCESS;
+    --producer->cleanup_inflight;
+    pthread_mutex_unlock(&remote_lock);
+    if (status)
+    {
+        queue_producer_cleanup(producer);
+        ERR("remote producer %#llx stop failed %u; watch owner retained\n",
+            (unsigned long long)producer->id, (unsigned)status);
+    }
+    finalize_producer_watch(producer);
+    return status;
+}
+static void retry_producer_cleanup(void)
+{
+    struct remote_producer *producer;
+    HANDLE process = NULL;
+    BOOL pending = FALSE;
+    pthread_mutex_lock(&remote_lock);
+    producer = producer_cleanup;
+    if (producer)
+    {
+        producer_cleanup = producer->cleanup_next;
+        if (!producer_cleanup) producer_cleanup_tail = &producer_cleanup;
+        producer->cleanup_listed = FALSE;
+        ++producer->cleanup_inflight; /* transfer queue owner before clearing handle */
+        process = producer->cleanup_process;
+        producer->cleanup_process = NULL;
+        pending = producer->cleanup_pending && producer->watched && !producer->completion_requested;
+        if (producer->completion_requested) producer->cleanup_pending = FALSE;
+    }
+    pthread_mutex_unlock(&remote_lock);
+    if (!producer) return;
+    close_producer_process(producer, process);
+    if (pending) stop_producer_watch(producer);
+    pthread_mutex_lock(&remote_lock);
+    --producer->cleanup_inflight;
+    pthread_mutex_unlock(&remote_lock);
+    finalize_producer_watch(producer);
+    producer_release(producer); /* transferred cleanup-list owner */
+}
+static DWORD producer_revoke(struct remote_producer *producer, BOOL stop_worker)
+{
+    struct remote_producer **cursor;
+    struct remote_host *host, *next, *retired = NULL;
+    HANDLE process;
+    BOOL listed, started;
+    DWORD status, stop_status;
+    pthread_mutex_lock(&remote_lock);
+    producer->active = FALSE;
+    ++producer->cleanup_inflight; /* owns process locally until close/requeue completes */
+    process = producer->process;
+    producer->process = NULL;
+    listed = producer->listed;
+    if (listed)
+    {
+        for (cursor = &producers; *cursor != producer; cursor = &(*cursor)->next) assert(*cursor);
+        *cursor = producer->next;
+        producer->listed = FALSE;
+    }
+    started = producer->watch_started;
+    for (host = hosts; host; host = next)
+    {
+        next = host->next;
+        if (host->producer == producer) retire_locked(host, &retired);
+    }
+    pthread_mutex_unlock(&remote_lock);
+    dispose_retired(retired);
+    status = close_producer_process(producer, process);
+    if (stop_worker && started)
+    {
+        stop_status = stop_producer_watch(producer);
+        if (!status) status = stop_status;
+    }
+    pthread_mutex_lock(&remote_lock);
+    --producer->cleanup_inflight;
+    pthread_mutex_unlock(&remote_lock);
+    finalize_producer_watch(producer);
+    if (listed) producer_release(producer);
+    return status;
+}
+static void root_revoke_producers(struct remote_root *root)
+{
+    struct remote_producer *producer;
+    for (;;)
+    {
+        pthread_mutex_lock(&remote_lock);
+        for (producer = producers; producer; producer = producer->next)
+            if (producer->root == root) break;
+        if (producer) InterlockedIncrement(&producer->refs);
+        pthread_mutex_unlock(&remote_lock);
+        if (!producer) break;
+        producer_revoke(producer, TRUE);
+        producer_release(producer);
+    }
+}
+NTSTATUS macdrv_remote_watch_init(void *args)
+{
+    struct macdrv_remote_watch_init *init = args;
+    LONG64 old;
+    if (!init || init->magic != MACDRV_REMOTE_WATCH_MAGIC || init->version != MACDRV_REMOTE_WATCH_VERSION || !init->callback)
+        return STATUS_INVALID_PARAMETER;
+    old = InterlockedCompareExchange64(&watch_callback, init->callback, 0);
+    return !old || (UINT64)old == init->callback ? STATUS_SUCCESS : STATUS_INVALID_PARAMETER;
+}
+NTSTATUS macdrv_remote_watch_complete(void *args)
+{
+    const struct macdrv_remote_watch_completion *completion = args;
+    struct remote_producer *producer;
+    DWORD cleanup_status;
+    BOOL pending;
+    if (!completion || !completion->lease_id || completion->outcome < MACDRV_REMOTE_WATCH_EXITED ||
+        completion->outcome > MACDRV_REMOTE_WATCH_FAILED ||
+        (completion->outcome != MACDRV_REMOTE_WATCH_FAILED && completion->error)) return STATUS_INVALID_PARAMETER;
+    pthread_mutex_lock(&remote_lock);
+    for (producer = producer_watches; producer; producer = producer->watch_next)
+        if (producer->id == completion->lease_id) break;
+    if (producer)
+    {
+        InterlockedIncrement(&producer->refs);
+        producer->completion_requested = TRUE;
+        producer->cleanup_pending = FALSE;
+    }
+    pthread_mutex_unlock(&remote_lock);
+    if (!producer) return STATUS_NOT_FOUND;
+    TRACE("remote producer complete %#llx outcome %u error %u\n", (unsigned long long)producer->id,
+          completion->outcome, completion->error);
+    if (completion->outcome == MACDRV_REMOTE_WATCH_FAILED)
+        ERR("remote process wait failed %u; producer revoked\n", completion->error);
+    cleanup_status = producer_revoke(producer, FALSE);
+    pthread_mutex_lock(&remote_lock);
+    pending = !producer->finalized;
+    pthread_mutex_unlock(&remote_lock);
+    producer_release(producer);
+    return cleanup_status || pending ? STATUS_PENDING : STATUS_SUCCESS;
+}
+static UINT64 producer_acquire(HWND hwnd, UINT64 epoch, DWORD pid, DWORD tid, UINT64 generation, DWORD *error)
+{
+    OBJECT_ATTRIBUTES attributes = {sizeof(attributes)};
+    CLIENT_ID client = {ULongToHandle(pid), ULongToHandle(tid)};
+    THREAD_BASIC_INFORMATION thread_info;
+    KERNEL_USER_TIMES times;
+    LARGE_INTEGER zero = {0};
+    HANDLE thread = NULL, process = NULL;
+    struct remote_producer *producer, *current;
+    struct remote_root *root;
+    struct producer_history *history, *prepared;
+    UINT64 result = 0;
+    NTSTATUS status;
+    DWORD start_status;
+    *error = ERROR_INVALID_PARAMETER;
+    if (!pid || !tid || !generation) return 0;
+    if (!InterlockedCompareExchange64(&watch_callback, 0, 0))
+    { *error = ERROR_PROC_NOT_FOUND; return 0; }
+    if ((status = NtOpenThread(&thread, THREAD_QUERY_INFORMATION, &attributes, &client))) goto fail;
+    if ((status = NtQueryInformationThread(thread, ThreadBasicInformation, &thread_info, sizeof(thread_info), NULL))) goto fail;
+    if (thread_info.ClientId.UniqueProcess != client.UniqueProcess || thread_info.ClientId.UniqueThread != client.UniqueThread)
+    { status = STATUS_INVALID_CID; goto fail; }
+    /* Keep the thread's process reference until the process object is opened. */
+    client.UniqueThread = NULL;
+    if ((status = NtOpenProcess(&process, PROCESS_QUERY_INFORMATION | SYNCHRONIZE, &attributes, &client))) goto fail;
+    NtClose(thread); thread = NULL;
+    if ((status = NtQueryInformationProcess(process, ProcessTimes, &times, sizeof(times), NULL))) goto fail;
+    if ((status = NtWaitForSingleObject(process, FALSE, &zero)) != STATUS_TIMEOUT)
+    { if (!status) status = STATUS_PROCESS_IS_TERMINATING; goto fail; }
+    producer = calloc(1, sizeof(*producer));
+    prepared = calloc(1, sizeof(*prepared));
+    if (!producer || !prepared)
+    { free(producer); free(prepared); *error = ERROR_NOT_ENOUGH_MEMORY; NtClose(process); return 0; }
+    producer->refs = 1; /* local acquisition pin */
+    producer->pid = pid; producer->generation = generation;
+    producer->birth = times.CreateTime.QuadPart;
+    producer->process = process;
+    pthread_mutex_lock(&remote_lock);
+    root = root_lookup_locked(hwnd);
+    if (!root || !root->open || !root->revision || root->epoch != epoch) goto rejected;
+    for (current = producers; current; current = current->next)
+        if (current->root == root && current->pid == pid && current->birth == producer->birth && current->generation == generation)
+        {
+            if (current->active && current->watch_started) result = current->id;
+            goto rejected;
+        }
+    for (history = root->history; history; history = history->next)
+        if (history->pid == pid && history->birth == producer->birth) break;
+    if ((history && generation <= history->highwater) || !(producer->id = identity_locked())) goto rejected;
+    if (!history)
+    {
+        history = prepared; prepared = NULL;
+        history->pid = pid; history->birth = producer->birth;
+        history->next = root->history; root->history = history;
+    }
+    history->highwater = generation; /* failed setup still consumes the generation */
+    producer->root = root; InterlockedIncrement(&root->refs);
+    producer->active = producer->listed = producer->watched = TRUE;
+    producer->refs += 2; /* lookup registry + completion registry */
+    producer->next = producers; producers = producer;
+    producer->watch_next = producer_watches; producer_watches = producer;
+    pthread_mutex_unlock(&remote_lock);
+    free(prepared);
+    start_status = watch_control(MACDRV_REMOTE_WATCH_START, process, producer->id, NULL);
+    pthread_mutex_lock(&remote_lock);
+    if (!start_status) producer->watch_started = TRUE;
+    if (!start_status && producer->active && root->open && root->revision) result = producer->id;
+    pthread_mutex_unlock(&remote_lock);
+    if (!result)
+    {
+        producer_revoke(producer, TRUE);
+        if (start_status)
+        {
+            /* A malformed callback return cannot prove START did no work. */
+            stop_producer_watch(producer);
+        }
+    }
+    *error = result ? ERROR_SUCCESS : (start_status ? start_status : ERROR_PROCESS_ABORTED);
+    producer_release(producer);
+    return result;
+rejected:
+    pthread_mutex_unlock(&remote_lock);
+    free(prepared); free(producer); NtClose(process);
+    *error = result ? ERROR_SUCCESS : ERROR_INVALID_HANDLE;
+    return result;
+fail:
+    if (thread) NtClose(thread);
+    if (process) NtClose(process);
+    *error = RtlNtStatusToDosError(status);
+    return 0;
+}
