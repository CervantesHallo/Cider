+static DWORD packet_producer_begin(const struct macdrv_remote_packet *packet, struct remote_producer **result)
+{
+    struct remote_producer *producer;
+    DWORD error = ERROR_INVALID_HANDLE;
+    *result = NULL;
+    pthread_mutex_lock(&remote_lock);
+    producer = producer_lookup_locked(packet->lease_id);
+    if (producer && producer->active && producer->root->open && producer->root->revision &&
+        producer->root->epoch == packet->root_epoch && wine_server_user_handle(producer->root->hwnd) == packet->root &&
+        producer->pid == packet->producer_pid && producer->generation == packet->producer_generation)
+    {
+        if (!packet->sequence || packet->sequence <= producer->last_sequence) error = ERROR_RETRY;
+        else if (producer->busy && packet->operation != MACDRV_REMOTE_RELEASE_PRODUCER) error = ERROR_BUSY;
+        else
+        {
+            producer->busy = TRUE;
+            producer->last_sequence = packet->sequence;
+            InterlockedIncrement(&producer->refs);
+            *result = producer;
+            error = ERROR_SUCCESS;
+        }
+    }
+    pthread_mutex_unlock(&remote_lock);
+    return error;
+}
+LRESULT macdrv_remote_packet_receive(HWND hwnd, WPARAM size, struct macdrv_remote_packet *packet)
+{
+    struct remote_producer *producer = NULL;
+    struct remote_host *host;
+    KERNEL_USER_TIMES times;
+    BOOL owned;
+    DWORD error = ERROR_INVALID_PARAMETER;
+    NTSTATUS status;
+    HWND child;
+    if (size || !macdrv_remote_packet_header_valid(packet) || packet->flags ||
+        packet->root != wine_server_user_handle(hwnd)) return 0;
+    retry_producer_cleanup();
+    status = NtQueryInformationProcess(NtCurrentProcess(), ProcessTimes, &times, sizeof(times), NULL);
+    if (status) { error = RtlNtStatusToDosError(status); goto reply; }
+    if (packet->root_pid || packet->root_create_time || !packet->producer_pid || !packet->producer_tid) goto reply;
+    switch (packet->operation)
+    {
+    case MACDRV_REMOTE_QUERY_ROOT:
+        if (packet->child || packet->producer_generation || packet->root_epoch || packet->lease_id ||
+            packet->host_ticket || packet->context_id) goto reply;
+        break;
+    case MACDRV_REMOTE_ACQUIRE_PRODUCER:
+        if (!packet->producer_generation || !packet->root_epoch || packet->lease_id || packet->host_ticket ||
+            packet->child || packet->context_id) goto reply;
+        break;
+    case MACDRV_REMOTE_INSTALL_HOST:
+        if (!packet->context_id || packet->host_ticket) goto reply;
+        break;
+    case MACDRV_REMOTE_REFRESH_HOST:
+    case MACDRV_REMOTE_RELEASE_HOST:
+        if (!packet->host_ticket || packet->context_id || packet->child) goto reply;
+        break;
+    case MACDRV_REMOTE_RELEASE_PRODUCER:
+        if (packet->host_ticket || packet->context_id || packet->child) goto reply;
+        break;
+    }
+    packet->root_pid = GetCurrentProcessId();
+    packet->root_create_time = times.CreateTime.QuadPart;
+    if (packet->operation == MACDRV_REMOTE_QUERY_ROOT)
+    {
+        packet->root_epoch = macdrv_remote_root_epoch(hwnd);
+        error = packet->root_epoch ? ERROR_SUCCESS : ERROR_INVALID_HANDLE;
+        goto reply;
+    }
+    if (packet->operation == MACDRV_REMOTE_ACQUIRE_PRODUCER)
+    {
+        packet->lease_id = producer_acquire(hwnd, packet->root_epoch, packet->producer_pid,
+                                            packet->producer_tid, packet->producer_generation, &error);
+        goto reply;
+    }
+    if ((error = packet_producer_begin(packet, &producer))) goto reply;
+    switch (packet->operation)
+    {
+    case MACDRV_REMOTE_INSTALL_HOST:
+        child = packet->child ? wine_server_ptr_handle(packet->child) : hwnd;
+        packet->host_ticket = host_install(hwnd, packet->root_epoch, child, packet->context_id,
+                                            producer->id, producer->pid, producer->generation);
+        error = packet->host_ticket ? ERROR_SUCCESS : ERROR_INVALID_HANDLE;
+        break;
+    case MACDRV_REMOTE_REFRESH_HOST:
+    case MACDRV_REMOTE_RELEASE_HOST:
+        pthread_mutex_lock(&remote_lock);
+        host = host_lookup_locked(packet->host_ticket);
+        owned = host && host->producer == producer;
+        pthread_mutex_unlock(&remote_lock);
+        if (!owned) { error = ERROR_INVALID_HANDLE; break; }
+        if (packet->operation == MACDRV_REMOTE_REFRESH_HOST)
+            error = macdrv_remote_host_refresh(packet->host_ticket) ? ERROR_SUCCESS : ERROR_INVALID_HANDLE;
+        else
+        {
+            macdrv_remote_host_release(packet->host_ticket);
+            error = ERROR_SUCCESS;
+        }
+        break;
+    case MACDRV_REMOTE_RELEASE_PRODUCER:
+        error = producer_revoke(producer, TRUE);
+        break;
+    }
+    pthread_mutex_lock(&remote_lock);
+    producer->busy = FALSE;
+    if (!producer->active && packet->operation != MACDRV_REMOTE_RELEASE_PRODUCER) error = ERROR_PROCESS_ABORTED;
+    pthread_mutex_unlock(&remote_lock);
+    producer_release(producer);
+reply:
+    packet->status = error;
+    packet->flags = MACDRV_REMOTE_PACKET_RESPONSE;
+    return 1; /* copied reply delivered; packet.status is the actual operation result */
+}
+BOOL macdrv_remote_packet_send(HWND root, struct macdrv_remote_packet *packet)
+{
+    struct send_message_timeout_params timeout = { .flags = SMTO_ABORTIFHUNG, .timeout = 3000 };
+    LRESULT delivered;
+    packet->size = sizeof(*packet);
+    packet->version = MACDRV_REMOTE_PACKET_VERSION;
+    packet->root = wine_server_user_handle(root);
+    packet->producer_pid = GetCurrentProcessId();
+    packet->producer_tid = GetCurrentThreadId();
+    packet->status = ERROR_IO_PENDING;
+    packet->flags = 0;
+    packet->reserved = 0;
+    packet->root_pid = 0;
+    packet->root_create_time = 0;
+    delivered = NtUserMessageCall(root, WM_MACDRV_REMOTE_HOST_PACKET, 0, (LPARAM)packet,
+                                  &timeout, NtUserSendMessageTimeout, FALSE);
+    return delivered && timeout.result == 1 && packet->flags == MACDRV_REMOTE_PACKET_RESPONSE &&
+           macdrv_remote_packet_header_valid(packet);
+}
