@@ -0,0 +1,35 @@
+/* Private, fixed-width native USER-driver transport. No native pointers on wire. */
+#ifndef __WINE_MACDRV_REMOTE_H
+#define __WINE_MACDRV_REMOTE_H
+#include <stddef.h>
+#include <stdint.h>
+#define WM_MACDRV_REMOTE_HOST_PACKET 0x80001800u
+#define MACDRV_REMOTE_PACKET_VERSION 1u
+#define MACDRV_REMOTE_PACKET_RESPONSE 1u
+enum macdrv_remote_operation
+{
+    MACDRV_REMOTE_QUERY_ROOT = 1,
+    MACDRV_REMOTE_ACQUIRE_PRODUCER,
+    MACDRV_REMOTE_INSTALL_HOST,
+    MACDRV_REMOTE_REFRESH_HOST,
+    MACDRV_REMOTE_RELEASE_HOST,
+    MACDRV_REMOTE_RELEASE_PRODUCER
+};
+struct macdrv_remote_packet
+{
+    uint32_t size, version, operation, status;
+    uint32_t root, child, producer_pid, producer_tid;
+    uint64_t producer_generation, root_epoch, lease_id, host_ticket, sequence;
+    uint32_t context_id, flags, root_pid, reserved;
+    uint64_t root_create_time;
+};
+_Static_assert(sizeof(struct macdrv_remote_packet) == 96, "remote packet width");
+_Static_assert(offsetof(struct macdrv_remote_packet, producer_generation) == 32, "remote producer offset");
+_Static_assert(offsetof(struct macdrv_remote_packet, root_create_time) == 88, "remote root offset");
+static inline int macdrv_remote_packet_header_valid(const struct macdrv_remote_packet *packet)
+{
+    return packet && packet->size == sizeof(*packet) && packet->version == MACDRV_REMOTE_PACKET_VERSION &&
+           packet->operation >= MACDRV_REMOTE_QUERY_ROOT && packet->operation <= MACDRV_REMOTE_RELEASE_PRODUCER &&
+           !packet->reserved;
+}
+#endif
