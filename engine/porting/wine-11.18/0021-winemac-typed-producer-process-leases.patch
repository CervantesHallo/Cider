+NTSTATUS macdrv_remote_watch_recover(void *args)
+{
+    struct macdrv_remote_watch_recovery *recovery = args;
+    struct remote_producer *producer;
+    UINT32 count = 0;
+    if (!recovery || recovery->size != sizeof(*recovery) || recovery->version != MACDRV_REMOTE_WATCH_VERSION || recovery->reserved)
+        return STATUS_INVALID_PARAMETER;
+    retry_producer_cleanup();
+    pthread_mutex_lock(&remote_lock);
+    for (producer = producer_cleanup; producer; producer = producer->cleanup_next) ++count;
+    pthread_mutex_unlock(&remote_lock);
+    recovery->pending = count;
+    return STATUS_SUCCESS;
+}
