 static IMMNotificationClient g_notif = { &g_notif_vtbl };
 
+static BOOL CALLBACK WINMM_InitMMDevicesOnce(INIT_ONCE *once, void *param, void **context)
+{
+    WINMM_MMDevice *out_devices = NULL, *in_devices = NULL;
+    WINMM_MMDevice **out_map = NULL, **in_map = NULL;
+    UINT out_count = 0, in_count = 0;
+    IMMDeviceEnumerator *devenum = NULL;
+    BOOL complete = FALSE;
+    HRESULT hr, init_hr;
+
+    init_hr = CoInitialize(NULL);
+    if (FAILED(init_hr) && init_hr != RPC_E_CHANGED_MODE)
+    {
+        hr = init_hr;
+        goto done;
+    }
+
+    hr = CoCreateInstance(&CLSID_MMDeviceEnumerator, NULL,
+            CLSCTX_INPROC_SERVER, &IID_IMMDeviceEnumerator, (void **)&devenum);
+    if (FAILED(hr))
+        goto done;
+
+    hr = WINMM_EnumDevices(&out_devices, &out_map, &out_count, eRender, devenum);
+    if (FAILED(hr))
+        goto done;
+    hr = WINMM_EnumDevices(&in_devices, &in_map, &in_count, eCapture, devenum);
+    if (FAILED(hr))
+        goto done;
+
+    /* An empty successful enumeration still returns success to this caller,
+     * but leave the once pending so a later call can discover new devices. */
+    if (!out_count && !in_count)
+        goto done;
+
+    /* No caller can pass InitOnce until completion. Publish both directions
+     * before registering callbacks, which take the same map lock. */
+    EnterCriticalSection(&g_devthread_lock);
+    g_out_mmdevices = out_devices;
+    g_out_map = out_map;
+    g_outmmdevices_count = out_count;
+    g_in_mmdevices = in_devices;
+    g_in_map = in_map;
+    g_inmmdevices_count = in_count;
+    LeaveCriticalSection(&g_devthread_lock);
+    out_devices = in_devices = NULL;
+    out_map = in_map = NULL;
+    out_count = in_count = 0;
+
+    hr = IMMDeviceEnumerator_RegisterEndpointNotificationCallback(devenum, &g_notif);
+    if (FAILED(hr))
+        WARN("RegisterEndpointNotificationCallback failed: %08lx\n", hr);
+    /* Preserve the existing nonfatal notification-registration behavior. */
+    hr = S_OK;
+    complete = TRUE;
+
+done:
+    WINMM_FreeMMDevices(out_devices, out_count);
+    WINMM_FreeMMDevices(in_devices, in_count);
+    free(out_map);
+    free(in_map);
+    if (devenum)
+        IMMDeviceEnumerator_Release(devenum);
+    if (SUCCEEDED(init_hr))
+        CoUninitialize();
+    *(HRESULT *)param = hr;
+    return complete;
+}
