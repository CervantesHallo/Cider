+
+/* Reference an actual primary-token object through an existing kernel-process
+ * capability. No token handle or access rights are created by this request. */
+DECL_HANDLER(reference_process_primary_token)
+{
+    struct device_manager *manager;
+    struct process *process = NULL;
+    struct token *token = NULL;
+    struct kernel_object *process_ref, *token_ref;
+
+    if (!(manager = get_owned_device_manager( req->manager )))
+        return;
+    if (!req->process_ptr || !req->candidate_ptr)
+    {
+        set_error( STATUS_INVALID_PARAMETER );
+        goto done;
+    }
+    if (!(process = get_process_from_handle( req->process, PROCESS_QUERY_LIMITED_INFORMATION )))
+        goto done;
+    process_ref = kernel_object_from_ptr( manager, req->process_ptr );
+    if (!process_ref || process_ref->object != (struct object *)process)
+    {
+        set_error( STATUS_INVALID_HANDLE );
+        goto done;
+    }
+    if (kernel_object_from_ptr( manager, req->candidate_ptr ))
+    {
+        set_error( STATUS_OBJECT_NAME_COLLISION );
+        goto done;
+    }
+    if (!(token = get_process_primary_token_reference( (struct object *)process )))
+        goto done;
+    if (!(token_ref = kernel_object_from_obj( manager, (struct object *)token )))
+    {
+        if (!(token_ref = set_kernel_object( manager, (struct object *)token, req->candidate_ptr )))
+        {
+            set_error( STATUS_NO_MEMORY );
+            goto done;
+        }
+    }
+    if (!token_ref->user_ptr)
+    {
+        set_error( STATUS_INVALID_HANDLE );
+        goto done;
+    }
+    reply->new_owned = !token_ref->owned;
+    grab_kernel_object( token_ref );
+    reply->user_ptr = token_ref->user_ptr;
+
+done:
+    if (token) release_object( token );
+    if (process) release_object( process );
+    release_object( manager );
+}
