+static void CALLBACK unlock_obref( BOOL normal )
+{
+    LeaveCriticalSection( &obref_cs );
+}
+
+struct primary_token_reference_context
+{
+    HANDLE process;
+    void *candidate;
+    void *result;
+    BOOL registered;
+    NTSTATUS close_status;
+};
+
+static void CALLBACK finish_primary_token_reference( BOOL normal, void *context )
+{
+    struct primary_token_reference_context *state = context;
+
+    if (state->candidate && !state->registered) free_kernel_object( state->candidate );
+    if (state->process)
+    {
+        HANDLE handle = state->process;
+        state->process = NULL;
+        __TRY
+        {
+            state->close_status = NtClose( handle );
+        }
+        __EXCEPT_ALL
+        {
+            state->close_status = GetExceptionCode();
+        }
+        __ENDTRY
+        if (state->close_status) WARN( "primary-token temporary process handle close failed: %#lx\n", state->close_status );
+    }
+    if (!normal && state->result)
+    {
+        void *token = state->result;
+        state->result = NULL;
+        ObDereferenceObject( token );
+    }
+}
+
+/***********************************************************************
+ *           PsReferencePrimaryToken  (NTOSKRNL.EXE.@)
+ */
+PACCESS_TOKEN WINAPI PsReferencePrimaryToken( PEPROCESS process )
+{
+    struct primary_token_reference_context state = {0};
+    NTSTATUS status = STATUS_SUCCESS;
+
+    if (!process) RtlRaiseStatus( STATUS_INVALID_PARAMETER );
+    __TRY
+    {
+        status = ObOpenObjectByPointer( process, 0, NULL, PROCESS_QUERY_LIMITED_INFORMATION,
+                                        PsProcessType, KernelMode, &state.process );
+        if (!status) status = alloc_kernel_object_checked( SeTokenObjectType, NULL, 0, 0, &state.candidate );
+        if (!status)
+        {
+            EnterCriticalSection( &handle_map_cs );
+            __TRY
+            {
+                EnterCriticalSection( &obref_cs );
+                __TRY
+                {
+                    void *object = NULL;
+                    BOOL new_owned = FALSE;
+                    struct object_header *header;
+
+                    SERVER_START_REQ( reference_process_primary_token )
+                    {
+                        req->manager = wine_server_obj_handle( get_device_manager() );
+                        req->process = wine_server_obj_handle( state.process );
+                        req->process_ptr = wine_server_client_ptr( process );
+                        req->candidate_ptr = wine_server_client_ptr( state.candidate );
+                        status = wine_server_call( req );
+                        if (!status)
+                        {
+                            object = wine_server_get_ptr( reply->user_ptr );
+                            new_owned = reply->new_owned;
+                        }
+                    }
+                    SERVER_END_REQ;
+                    if (!status)
+                    {
+                        state.registered = object == state.candidate;
+                        if (!object) status = STATUS_INVALID_DEVICE_STATE;
+                        else
+                        {
+                            header = (struct object_header *)object - 1;
+                            if (header->type != SeTokenObjectType) status = STATUS_OBJECT_TYPE_MISMATCH;
+                            else if (header->reference_error) status = header->reference_error;
+                            else if (header->ref < 0) status = STATUS_INVALID_PARAMETER;
+                            else if (header->ref == MAXLONG) status = STATUS_INTEGER_OVERFLOW;
+                            else if ((header->ref == 0) != !!new_owned) status = STATUS_INVALID_DEVICE_STATE;
+                            else
+                            {
+                                ++header->ref;
+                                state.result = object;
+                            }
+                            if (status && new_owned)
+                            {
+                                NTSTATUS cleanup_status;
+                                SERVER_START_REQ( release_kernel_object )
+                                {
+                                    req->manager = wine_server_obj_handle( get_device_manager() );
+                                    req->user_ptr = wine_server_client_ptr( object );
+                                    cleanup_status = wine_server_call( req );
+                                }
+                                SERVER_END_REQ;
+                                if (cleanup_status)
+                                {
+                                    if (!header->ref && !header->reference_error) header->reference_error = cleanup_status;
+                                    WARN( "primary-token reference rollback failed: %#lx\n", cleanup_status );
+                                }
+                            }
+                        }
+                    }
+                }
+                __FINALLY( unlock_obref );
+            }
+            __FINALLY_CTX( unlock_handle_map, NULL );
+        }
+    }
+    __FINALLY_CTX( finish_primary_token_reference, &state );
+    if (state.close_status)
+    {
+        if (state.result)
+        {
+            void *token = state.result;
+            state.result = NULL;
+            ObDereferenceObject( token );
+        }
+        if (!status) status = state.close_status;
+    }
+    if (status) RtlRaiseStatus( status );
+    return state.result;
+}
