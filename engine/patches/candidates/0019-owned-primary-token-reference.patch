+/* Kernel pointer mappings belong to one address space. A duplicated manager
+ * handle must not mutate another process's local-reference accounting. */
+static struct device_manager *get_owned_device_manager( obj_handle_t handle )
+{
+    struct device_manager *manager;
+
+    if (!(manager = (struct device_manager *)get_handle_obj( current->process, handle,
+                                                             0, &device_manager_ops )))
+        return NULL;
+    if (manager->owner != current->process)
+    {
+        release_object( manager );
+        set_error( STATUS_ACCESS_DENIED );
+        return NULL;
+    }
+    return manager;
+}
 
 
