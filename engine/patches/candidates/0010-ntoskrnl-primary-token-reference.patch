Subject: [candidate] primary token reference and balanced dereference

Requires candidates/0009-token-kernel-object-mapping.patch. Use the existing
Wine object/handle reference mechanism for the explicit target process, as
in pinned upstream eba89375a0515957701928faac0f5007ef638b04, with type
validation and query-only temporary access. No fallback identity or copied
token. Not selected by any recipe; native lifetime/access evidence pending.
See docs/research/57-primary-token-candidate-20261013.md.

--- a/dlls/ntoskrnl.exe/ntoskrnl.c
+++ b/dlls/ntoskrnl.exe/ntoskrnl.c
@@ -3392,6 +3392,47 @@
 
 
 /***********************************************************************
+ *           PsReferencePrimaryToken   (NTOSKRNL.EXE.@)
+ */
+PACCESS_TOKEN WINAPI PsReferencePrimaryToken( PEPROCESS process )
+{
+    HANDLE process_handle, token_handle;
+    PACCESS_TOKEN token = NULL;
+    NTSTATUS status;
+
+    TRACE( "%p\n", process );
+
+    status = ObOpenObjectByPointer( process, 0, NULL, PROCESS_QUERY_INFORMATION,
+                                   PsProcessType, KernelMode, &process_handle );
+    if (status)
+    {
+        WARN( "failed to open process: %#lx\n", status );
+        return NULL;
+    }
+
+    status = NtOpenProcessToken( process_handle, TOKEN_QUERY, &token_handle );
+    if (!status)
+    {
+        status = ObReferenceObjectByHandle( token_handle, TOKEN_QUERY, SeTokenObjectType,
+                                            KernelMode, &token, NULL );
+        NtClose( token_handle );
+    }
+    NtClose( process_handle );
+    if (status) WARN( "failed to reference primary token: %#lx\n", status );
+    return token;
+}
+
+/***********************************************************************
+ *           PsDereferencePrimaryToken   (NTOSKRNL.EXE.@)
+ */
+void WINAPI PsDereferencePrimaryToken( PACCESS_TOKEN token )
+{
+    TRACE( "%p\n", token );
+    ObDereferenceObject( token );
+}
+
+
