From 539aa62220ad23a390ce9f2a1c99ee5d3831907b Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Alexander=20Thei=C3=9Fen?= <alex@theissen.io>
Date: Sun, 6 Sep 2026 11:26:31 +0400
Subject: [PATCH] ntdll: Keep no-exec on under Rosetta and decide it from the
 main executable.

Wine turned data execution prevention off for the whole process as soon as
any loaded module lacked IMAGE_DLLCHARACTERISTICS_NX_COMPAT. Windows does
not do that for a DLL: the flag of the main executable decides, and only the
application compatibility database switches DEP off later. Check the flag on
the main image only.

Turning it off sets force_exec_prot, which adds PROT_EXEC to every readable
mapping for the rest of the process. Under Rosetta a writable and executable
page costs a Mach round trip on first touch, so a process with DEP off turns
every allocation into a fault storm (athei/wine-build#3 measured a 190x
frame time difference from a single LoadLibrary). An old main executable
without the flag, or a program calling SetProcessDEPPolicy, does the same.

Under Rosetta treat DEP as permanently on, as the Windows AlwaysOn policy
does: ProcessExecuteFlags reports MEM_EXECUTE_OPTION_PERMANENT and a request
to turn it off fails with STATUS_ACCESS_DENIED. WINE_DISABLE_NX_COMPAT=0
restores the Windows behaviour on any host, and any other value keeps DEP
permanently on everywhere.
---
 dlls/ntdll/loader.c       | 16 +++++++++++++---
 dlls/ntdll/unix/process.c | 34 ++++++++++++++++++++++++++++++++--
 2 files changed, 45 insertions(+), 5 deletions(-)

diff --git a/dlls/ntdll/loader.c b/dlls/ntdll/loader.c
index e1aea34fb5d..0a34640807e 100644
--- a/dlls/ntdll/loader.c
+++ b/dlls/ntdll/loader.c
@@ -1613,11 +1613,21 @@ static WINE_MODREF *alloc_module( HMODULE hModule, const UNICODE_STRING *nt_name
         ERR( "rtl_rb_tree_put failed.\n" );
     /* wait until init is called for inserting into InInitializationOrderModuleList */
 
-    if (!(nt->OptionalHeader.DllCharacteristics & IMAGE_DLLCHARACTERISTICS_NX_COMPAT))
+    /* Data execution prevention follows the main executable, as on Windows: a
+     * DLL without IMAGE_DLLCHARACTERISTICS_NX_COMPAT does not turn it off for
+     * the process. Turning it off forces PROT_EXEC on every readable mapping,
+     * and under Rosetta each fresh writable and executable page then costs a
+     * Mach round trip on first touch, so the process policy keeps it on there
+     * unless WINE_DISABLE_NX_COMPAT=0. */
+    if (hModule == NtCurrentTeb()->Peb->ImageBaseAddress &&
+        !(nt->OptionalHeader.DllCharacteristics & IMAGE_DLLCHARACTERISTICS_NX_COMPAT))
     {
         ULONG flags = MEM_EXECUTE_OPTION_ENABLE;
-        WARN( "disabling no-exec because of %s\n", debugstr_w(wm->ldr.BaseDllName.Buffer) );
-        NtSetInformationProcess( GetCurrentProcess(), ProcessExecuteFlags, &flags, sizeof(flags) );
+        if (!NtSetInformationProcess( GetCurrentProcess(), ProcessExecuteFlags, &flags, sizeof(flags) ))
+            WARN( "disabling no-exec because %s is not NX compatible\n",
+                  debugstr_w(wm->ldr.BaseDllName.Buffer) );
+        else
+            WARN( "keeping no-exec for %s\n", debugstr_w(wm->ldr.BaseDllName.Buffer) );
     }
     return wm;
 }
diff --git a/dlls/ntdll/unix/process.c b/dlls/ntdll/unix/process.c
index 1f550a60216..85de32687a9 100644
--- a/dlls/ntdll/unix/process.c
+++ b/dlls/ntdll/unix/process.c
@@ -86,6 +86,36 @@ WINE_DEFAULT_DEBUG_CHANNEL(process);
 
 static ULONG execute_flags = MEM_EXECUTE_OPTION_DISABLE;
 
+/* Under Rosetta every page that is writable and executable costs a Mach round
+ * trip on first touch, and turning no-execute off makes every readable mapping
+ * executable, so a process that does it crawls. Keep no-execute permanently on
+ * there, as the Windows AlwaysOn policy does. WINE_DISABLE_NX_COMPAT=0 lets a
+ * process turn it off again on any host; any other value keeps it on on every
+ * host. */
+static ULONG get_execute_flags(void)
+{
+    static int always_on = -1;
+
+    if (always_on == -1)
+    {
+        const char *env = getenv( "WINE_DISABLE_NX_COMPAT" );
+
+        if (env) always_on = strcmp( env, "0" ) != 0;
+        else
+        {
+            int translated = 0;
+#ifdef __APPLE__
+            size_t size = sizeof(translated);
+            if (sysctlbyname( "sysctl.proc_translated", &translated, &size, NULL, 0 ) == -1)
+                translated = 0;
+#endif
+            always_on = translated;
+        }
+        if (always_on) TRACE( "no-execute is permanently on\n" );
+    }
+    return always_on ? execute_flags | MEM_EXECUTE_OPTION_PERMANENT : execute_flags;
+}
+
 static UINT process_error_mode;
 
 /* CrossOver Hack 10523: shunt the loading to CrossOver */
@@ -1970,7 +2000,7 @@ NTSTATUS WINAPI NtQueryInformationProcess( HANDLE handle, PROCESSINFOCLASS class
                              MEM_EXECUTE_OPTION_DISABLE_THUNK_EMULATION |
                              MEM_EXECUTE_OPTION_PERMANENT;
         else
-            *(ULONG *)info = execute_flags;
+            *(ULONG *)info = get_execute_flags();
         break;
 
     case ProcessPriorityClass:
@@ -2257,7 +2287,7 @@ NTSTATUS WINAPI NtSetInformationProcess( HANDLE handle, PROCESSINFOCLASS class,
 
     case ProcessExecuteFlags:
         if ((is_win64 && !is_wow64()) || size != sizeof(ULONG)) return STATUS_INVALID_PARAMETER;
-        if (execute_flags & MEM_EXECUTE_OPTION_PERMANENT) return STATUS_ACCESS_DENIED;
+        if (get_execute_flags() & MEM_EXECUTE_OPTION_PERMANENT) return STATUS_ACCESS_DENIED;
         else
         {
             BOOL enable;
