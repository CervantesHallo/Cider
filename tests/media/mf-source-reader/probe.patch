+        ATTR_RATIO(MF_MT_FRAME_RATE, 30, 1),
+        ATTR_RATIO(MF_MT_PIXEL_ASPECT_RATIO, 1, 1),
+        ATTR_UINT32(MF_MT_INTERLACE_MODE, MFVideoInterlace_Progressive),
+        ATTR_UINT32(MF_MT_DEFAULT_STRIDE, 4),
+        {0},
+    };
+    static const struct attribute_desc output_desc[] =
+    {
+        ATTR_GUID(MF_MT_MAJOR_TYPE, MFMediaType_Video),
+        ATTR_GUID(MF_MT_SUBTYPE, MFVideoFormat_RGB32),
+        ATTR_RATIO(MF_MT_FRAME_SIZE, 4, 4),
+        ATTR_RATIO(MF_MT_FRAME_RATE, 30, 1),
+        ATTR_RATIO(MF_MT_PIXEL_ASPECT_RATIO, 1, 1),
+        ATTR_UINT32(MF_MT_INTERLACE_MODE, MFVideoInterlace_Progressive),
+        ATTR_UINT32(MF_MT_DEFAULT_STRIDE, 16),
+        {0},
+    };
+    IMFTransform *processor = NULL;
+    IMFMediaType *type = NULL;
+    IMFSample *dark = NULL, *bright = NULL, *output_sample = NULL;
+    IMFMediaBuffer *buffer = NULL;
+    MFT_OUTPUT_DATA_BUFFER output = {0};
+    DWORD status = 0, length = 0;
+    unsigned int pixel;
+    BYTE *data;
+    HRESULT hr;
+
+    hr = CoInitializeEx(NULL, COINIT_MULTITHREADED);
+    ok(hr == S_OK || hr == S_FALSE, "CoInitializeEx %#lx.\n", hr);
+    if (FAILED(hr)) return;
+    hr = CoCreateInstance(&CLSID_VideoProcessorMFT, NULL, CLSCTX_INPROC_SERVER,
+            &IID_IMFTransform, (void **)&processor);
+    ok(hr == S_OK, "Create actual video processor %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+    hr = MFCreateMediaType(&type);
+    ok(hr == S_OK, "Create input type %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+    init_media_type(type, input_desc, -1);
+    hr = IMFTransform_SetInputType(processor, 0, type, 0);
+    ok(hr == S_OK, "Set NV12 input %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+    IMFMediaType_Release(type);
+    type = NULL;
+    hr = MFCreateMediaType(&type);
+    ok(hr == S_OK, "Create output type %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+    init_media_type(type, output_desc, -1);
+    hr = IMFTransform_SetOutputType(processor, 0, type, 0);
+    ok(hr == S_OK, "Set RGB32 output %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+    dark = cider_nv12_sample(16);
+    bright = cider_nv12_sample(235);
+    if (!dark || !bright) goto done;
+    hr = IMFTransform_ProcessInput(processor, 0, dark, 0);
+    ok(hr == S_OK, "Initial copy-fallback input %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+    hr = IMFTransform_ProcessOutput(processor, 0, 1, &output, &status);
+    ok(hr == E_INVALIDARG, "Missing output buffer should leave pending frame, got %#lx.\n", hr);
+    hr = IMFTransform_ProcessMessage(processor, MFT_MESSAGE_COMMAND_FLUSH, 0);
+    ok(hr == S_OK, "Flush pending copied frame %#lx.\n", hr);
+    hr = IMFTransform_ProcessMessage(processor, MFT_MESSAGE_COMMAND_FLUSH, 0);
+    ok(hr == S_OK, "Repeated empty Flush %#lx.\n", hr);
+    hr = IMFTransform_ProcessInput(processor, 0, bright, 0);
+    ok(hr == S_OK, "Post-Flush input without renegotiation %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+    hr = MFCreateSample(&output_sample);
+    ok(hr == S_OK, "Create output sample %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+    hr = MFCreateMemoryBuffer(64, &buffer);
+    ok(hr == S_OK, "Create RGB output buffer %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+    hr = IMFSample_AddBuffer(output_sample, buffer);
+    ok(hr == S_OK, "Attach RGB output buffer %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+    output.pSample = output_sample;
+    hr = IMFTransform_ProcessOutput(processor, 0, 1, &output, &status);
+    ok(hr == S_OK, "Post-Flush real output %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+    hr = IMFMediaBuffer_GetCurrentLength(buffer, &length);
+    ok(hr == S_OK && length == 64, "Output length %#lx, %lu.\n", hr, length);
+    hr = IMFMediaBuffer_Lock(buffer, &data, NULL, NULL);
+    ok(hr == S_OK, "Lock RGB output %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+    for (pixel = 0; pixel < 16; ++pixel)
+        ok(data[4 * pixel] >= 200 && data[4 * pixel + 1] >= 200 && data[4 * pixel + 2] >= 200,
+                "Pixel %u is not the new bright frame: %u/%u/%u.\n", pixel,
+                data[4 * pixel], data[4 * pixel + 1], data[4 * pixel + 2]);
+    printf("cider-mf-real-processor first-rgb=%u/%u/%u bytes=%lu\n", data[0], data[1], data[2], length);
+    IMFMediaBuffer_Unlock(buffer);
+    hr = IMFTransform_ProcessOutput(processor, 0, 1, &output, &status);
+    ok(hr == MF_E_TRANSFORM_NEED_MORE_INPUT, "Output consumed once, got %#lx.\n", hr);
+done:
+    if (output.pEvents) IMFCollection_Release(output.pEvents);
+    if (buffer) IMFMediaBuffer_Release(buffer);
+    if (output_sample) IMFSample_Release(output_sample);
+    if (bright) IMFSample_Release(bright);
+    if (dark) IMFSample_Release(dark);
+    if (type) IMFMediaType_Release(type);
+    if (processor) IMFTransform_Release(processor);
+    CoUninitialize();
+}
+
+/* Two admitted reads, one queued CPU sample and one native queue OOM.
+ * Apply the three opt-in mock insertions in oom-fixture-report-v1.json.
+ * Parent DIAG DLL must fail only the first two EMPTY-status queue_response
+ * allocations. This fragment does not inject or emulate those reader failures.
+ */
+struct cider_oom_record
+{
+    HRESULT hr;
+    DWORD index, flags;
+    LONGLONG timestamp;
+    BOOL has_sample;
+};
+
+struct cider_oom_callback
+{
+    struct async_callback base;
+    HANDLE drained_event;
+    LONG drain_armed, calls, completed, samples, ooms, other;
+    struct cider_oom_record records[4];
+};
+
+static struct cider_oom_callback *cider_oom_callback_from_iface(IMFSourceReaderCallback *iface)
+{
+    return CONTAINING_RECORD(impl_from_IMFSourceReaderCallback(iface), struct cider_oom_callback, base);
+}
+
+static ULONG WINAPI cider_oom_callback_Release(IMFSourceReaderCallback *iface)
+{
+    struct cider_oom_callback *callback = cider_oom_callback_from_iface(iface);
+    ULONG refs = InterlockedDecrement(&callback->base.refcount);
+
+    if (!refs)
+    {
+        if (callback->base.event) CloseHandle(callback->base.event);
+        if (callback->drained_event) CloseHandle(callback->drained_event);
+        free(callback);
+    }
+    else if (refs == 1 && InterlockedCompareExchange(&callback->drain_armed, 0, 0))
+    {
+        /* Sole remaining reference is the fixture's; no later field access. */
+        SetEvent(callback->drained_event);
+    }
+    return refs;
+}
+
+static HRESULT WINAPI cider_oom_callback_OnReadSample(IMFSourceReaderCallback *iface, HRESULT hr,
+        DWORD index, DWORD flags, LONGLONG timestamp, IMFSample *sample)
+{
+    struct cider_oom_callback *callback = cider_oom_callback_from_iface(iface);
+    LONG ordinal = InterlockedIncrement(&callback->calls);
+    DWORD buffers = 0;
+    HRESULT sample_hr;
+    LONG completed;
+
+    /* Ordinal is an observation, never an expected global callback order. */
+    if (ordinal > 0 && ordinal <= (LONG)ARRAY_SIZE(callback->records))
+    {
+        struct cider_oom_record *record = &callback->records[ordinal - 1];
+        record->hr = hr;
+        record->index = index;
+        record->flags = flags;
+        record->timestamp = timestamp;
+        record->has_sample = !!sample;
+    }
+    ok(ordinal <= 2, "Extra OOM-pair callback %ld, hr %#lx.\n", ordinal, hr);
+    ok(index == 0, "OOM-pair callback index %lu.\n", index);
+    ok(timestamp == 0, "OOM-pair callback timestamp %I64d.\n", timestamp);
+    if (hr == S_OK)
+    {
+        InterlockedIncrement(&callback->samples);
+        ok(!!sample, "Successful OOM-pair callback has no sample.\n");
+        ok(flags == 0, "Successful OOM-pair callback flags %#lx.\n", flags);
+        if (sample)
+        {
+            sample_hr = IMFSample_GetBufferCount(sample, &buffers);
+            ok(sample_hr == S_OK, "OOM-pair GetBufferCount returned %#lx.\n", sample_hr);
+            ok(buffers == 1, "Expected one fake CPU sample buffer, got %lu.\n", buffers);
+        }
+    }
+    else if (hr == E_OUTOFMEMORY)
+    {
+        InterlockedIncrement(&callback->ooms);
+        ok(!sample, "Native OOM callback supplied a sample %p.\n", sample);
+        ok(flags == MF_SOURCE_READERF_ERROR, "Native OOM callback flags %#lx.\n", flags);
+    }
+    else
+    {
+        InterlockedIncrement(&callback->other);
+        ok(0, "Unexpected OOM-pair callback hr %#lx, flags %#lx, sample %p.\n", hr, flags, sample);
+    }
+    completed = InterlockedIncrement(&callback->completed);
+    /* Final access; each callback owns its record slot and borrowed sample. */
+    if (completed >= 2) SetEvent(callback->base.event);
+    return S_OK;
+}
+
+static const IMFSourceReaderCallbackVtbl cider_oom_callback_vtbl =
+{
+    async_callback_QueryInterface,
+    async_callback_AddRef,
+    cider_oom_callback_Release,
+    cider_oom_callback_OnReadSample,
+    async_callback_OnFlush,
+    async_callback_OnEvent,
+};
+
+static BOOL cider_oom_wait(HANDLE event, const char *what)
+{
+    DWORD wait = WaitForSingleObject(event, 1500);
+
+    ok(wait == WAIT_OBJECT_0, "%s wait failed or timed out, result %#lx.\n", what, wait);
+    return wait == WAIT_OBJECT_0;
+}
+
+static BOOL cider_oom_reader_barrier(IMFSourceReader *reader)
+{
+    IMFMediaType *type = NULL;
+    HRESULT hr = IMFSourceReader_GetCurrentMediaType(reader, 0, &type);
+
+    /* The supplied reader takes reader->cs here. After the EMPTY signal this
+     * waits until the enclosing source event/helper has attempted its queue. */
+    ok(hr == S_OK, "OOM-pair reader barrier returned %#lx.\n", hr);
+    if (type) IMFMediaType_Release(type);
+    return hr == S_OK;
+}
+
+static void cider_oom_pair_case(void)
+{
+    static const struct attribute_desc input_desc[] =
+    {
+        ATTR_GUID(MF_MT_MAJOR_TYPE, MFMediaType_Video),
+        ATTR_GUID(MF_MT_SUBTYPE, MFVideoFormat_TEST),
+        ATTR_RATIO(MF_MT_FRAME_SIZE, 96, 96),
+        {0},
+    };
+    static const struct attribute_desc output_desc[] =
+    {
+        ATTR_GUID(MF_MT_MAJOR_TYPE, MFMediaType_Video),
+        ATTR_GUID(MF_MT_SUBTYPE, MFVideoFormat_YUY2),
+        {0},
+    };
+    struct cider_oom_callback *callback = NULL;
+    IMFSourceReaderEx *reader_ex = NULL;
+    IMFStreamDescriptor *descriptor = NULL;
+    IMFAttributes *attributes = NULL;
+    IMFSourceReader *reader = NULL;
+    IMFMediaSource *source = NULL;
+    IMFTransform *transform = NULL;
+    IMFMediaType *type = NULL;
+    struct test_decoder *decoder = NULL;
+    HANDLE empty_event = NULL;
+    BOOL pair_completed = FALSE, reader_created = FALSE, drained;
+    HRESULT hr;
+    ULONG refs;
+    LONG i;
+
+    callback = calloc(1, sizeof(*callback));
+    ok(!!callback, "Failed to allocate OOM-pair callback.\n");
+    if (!callback) goto done;
+    callback->base.IMFSourceReaderCallback_iface.lpVtbl = &cider_oom_callback_vtbl;
+    callback->base.refcount = 1;
+    callback->base.event = CreateEventW(NULL, TRUE, FALSE, NULL);
+    callback->drained_event = CreateEventW(NULL, TRUE, FALSE, NULL);
+    empty_event = CreateEventW(NULL, FALSE, FALSE, NULL);
+    ok(!!callback->base.event && !!callback->drained_event && !!empty_event,
+            "Failed to create OOM-pair events.\n");
+    if (!callback->base.event || !callback->drained_event || !empty_event) goto done;
+
+    hr = MFCreateAttributes(&attributes, 1);
+    ok(hr == S_OK, "OOM-pair MFCreateAttributes returned %#lx.\n", hr);
+    if (hr != S_OK) goto done;
+    hr = IMFAttributes_SetUnknown(attributes, &MF_SOURCE_READER_ASYNC_CALLBACK,
+            (IUnknown *)&callback->base.IMFSourceReaderCallback_iface);
+    ok(hr == S_OK, "OOM-pair SetUnknown(callback) returned %#lx.\n", hr);
+    if (hr != S_OK) goto done;
+    hr = MFCreateMediaType(&type);
+    ok(hr == S_OK, "OOM-pair MFCreateMediaType returned %#lx.\n", hr);
+    if (hr != S_OK) goto done;
+    init_media_type(type, input_desc, -1);
+    hr = MFCreateStreamDescriptor(0, 1, &type, &descriptor);
+    ok(hr == S_OK, "OOM-pair MFCreateStreamDescriptor returned %#lx.\n", hr);
+    if (hr != S_OK) goto done;
+    source = create_test_source(&descriptor, 1);
+    ok(!!source, "Failed to create OOM-pair source.\n");
+    if (!source) goto done;
+    hr = MFCreateSourceReaderFromMediaSource(source, attributes, &reader);
+    ok(hr == S_OK, "OOM-pair MFCreateSourceReader returned %#lx.\n", hr);
+    if (hr != S_OK) goto done;
+    reader_created = TRUE;
+    hr = IMFSourceReader_SetStreamSelection(reader, 0, TRUE);
+    ok(hr == S_OK, "OOM-pair SetStreamSelection returned %#lx.\n", hr);
+    if (hr != S_OK) goto done;
+    IMFMediaType_Release(type);
+    type = NULL;
+    hr = MFCreateMediaType(&type);
+    ok(hr == S_OK, "OOM-pair MFCreateMediaType(output) returned %#lx.\n", hr);
+    if (hr != S_OK) goto done;
+    init_media_type(type, output_desc, -1);
+    hr = IMFSourceReader_SetCurrentMediaType(reader, 0, NULL, type);
+    ok(hr == S_OK, "OOM-pair SetCurrentMediaType returned %#lx.\n", hr);
+    if (hr != S_OK) goto done;
+    hr = IMFSourceReader_QueryInterface(reader, &IID_IMFSourceReaderEx, (void **)&reader_ex);
+    ok(hr == S_OK, "OOM-pair QueryInterface(SourceReaderEx) returned %#lx.\n", hr);
+    if (hr != S_OK) goto done;
+    hr = IMFSourceReaderEx_GetTransformForStream(reader_ex, 0, 0, NULL, &transform);
+    ok(hr == S_OK, "OOM-pair GetTransformForStream returned %#lx.\n", hr);
+    if (hr != S_OK) goto done;
+    ok(transform->lpVtbl == &test_decoder_vtbl, "OOM-pair got a different transform %p.\n", transform);
+    if (transform->lpVtbl != &test_decoder_vtbl) goto done;
+    IMFSourceReaderEx_Release(reader_ex);
+    reader_ex = NULL;
+    decoder = test_decoder_from_IMFTransform(transform);
+    decoder->cider_allocator_gate = TRUE;
+    decoder->cider_empty_event = empty_event;
+    test_decoder_set_next_output(transform, MF_E_SAMPLEALLOCATOR_EMPTY);
+
+    hr = IMFSourceReader_ReadSample(reader, 0, 0, NULL, NULL, NULL, NULL); /* R1 */
+    ok(hr == S_OK, "OOM-pair R1 submission returned %#lx.\n", hr);
+    if (hr != S_OK) goto done;
+    if (!cider_oom_wait(empty_event, "R1 injected EMPTY")) goto done;
+    if (!cider_oom_reader_barrier(reader)) goto done;
+    ok(InterlockedCompareExchange(&decoder->cider_input_count, 0, 0) == 1,
+            "R1 EMPTY must follow exactly one ProcessInput.\n");
+    ok(InterlockedCompareExchange(&decoder->cider_empty_count, 0, 0) == 1,
+            "Expected first real EMPTY mock hit.\n");
+    ok(InterlockedCompareExchange(&callback->calls, 0, 0) == 0,
+            "R1 unexpectedly completed before R2 admission.\n");
+
+    decoder->cider_reblock_after_success = TRUE;
+    test_decoder_set_next_output(transform, S_OK);
+    hr = IMFSourceReader_ReadSample(reader, 0, 0, NULL, NULL, NULL, NULL); /* R2 */
+    ok(hr == S_OK, "OOM-pair R2 submission returned %#lx.\n", hr);
+    if (hr != S_OK) goto done;
+    if (!cider_oom_wait(empty_event, "R2 second injected EMPTY")) goto done;
+    if (!cider_oom_reader_barrier(reader)) goto done;
+    ok(InterlockedCompareExchange(&decoder->cider_empty_count, 0, 0) == 2,
+            "Expected exactly two actual EMPTY mock hits.\n");
+    ok(InterlockedCompareExchange(&decoder->cider_success_count, 0, 0) == 1,
+            "Expected exactly one success followed immediately by reblock.\n");
+    ok(!decoder->cider_reblock_after_success && decoder->next_output == MF_E_SAMPLEALLOCATOR_EMPTY,
+            "Fake decoder did not consume the one-shot reblock.\n");
+    ok(InterlockedCompareExchange(&decoder->cider_input_count, 0, 0) == 1,
+            "R2 consumed new input instead of retained output.\n");
+    pair_completed = cider_oom_wait(callback->base.event, "both admitted read completions");
+    if (pair_completed)
+    {
+        ok(InterlockedCompareExchange(&callback->samples, 0, 0) == 1, "Expected one successful sample callback.\n");
+        ok(InterlockedCompareExchange(&callback->ooms, 0, 0) == 1, "Expected one native OOM callback.\n");
+        ok(InterlockedCompareExchange(&callback->other, 0, 0) == 0, "Unexpected callback status count.\n");
+    }
+
+done:
+    if (reader_ex) IMFSourceReaderEx_Release(reader_ex);
+    if (attributes) IMFAttributes_Release(attributes);
+    if (reader)
+    {
+        InterlockedExchange(&callback->drain_armed, 1);
+        refs = IMFSourceReader_Release(reader);
+        ok(!refs, "OOM-pair final reader Release returned %lu.\n", refs);
+        drained = cider_oom_wait(callback->drained_event, "reader callback ownership drain");
+        if (!drained)
+        {
+            /* The missing drain is already a normal failure. Do not detach
+             * live work or free borrowed mock handles after claiming cleanup. */
+            fputs("cider-mf-oom-pair-callback-drain-failed\n", stderr);
+            fflush(stderr);
+            ExitProcess(125);
+        }
+        ok(InterlockedCompareExchange(&callback->base.refcount, 0, 0) == 1,
+                "Reader retained callback ownership after drain.\n");
+    }
+    if (reader_created)
+    {
+        ok(pair_completed, "OOM-pair did not complete both admitted reads before cleanup.\n");
+        ok(InterlockedCompareExchange(&callback->calls, 0, 0) == 2,
+                "Expected exactly two callbacks through reader teardown, got %ld.\n", callback->calls);
+        ok(InterlockedCompareExchange(&callback->completed, 0, 0) == 2, "Expected two finished callbacks.\n");
+        ok(callback->samples == 1 && callback->ooms == 1 && callback->other == 0,
+                "Final categories: samples=%ld ooms=%ld other=%ld.\n",
+                callback->samples, callback->ooms, callback->other);
+        if (decoder)
+        {
+            ok(InterlockedCompareExchange(&decoder->cider_input_count, 0, 0) == 1,
+                    "Final OOM-pair input count is not one.\n");
+            ok(InterlockedCompareExchange(&decoder->cider_empty_count, 0, 0) == 2,
+                    "Final OOM-pair EMPTY count is not two.\n");
+            ok(InterlockedCompareExchange(&decoder->cider_success_count, 0, 0) == 1,
+                    "Final OOM-pair success count is not one.\n");
+            printf("cider-mf-oom-pair-final input=%ld empty=%ld success=%ld callbacks=%ld completed=%ld samples=%ld ooms=%ld other=%ld\n",
+                    decoder->cider_input_count, decoder->cider_empty_count, decoder->cider_success_count,
+                    callback->calls, callback->completed, callback->samples, callback->ooms, callback->other);
+        }
+        for (i = 0; i < (LONG)ARRAY_SIZE(callback->records) && i < callback->calls; ++i)
+        {
+            const struct cider_oom_record *record = &callback->records[i];
+            printf("cider-mf-oom-pair-callback ordinal=%ld hr=%#lx index=%lu flags=%#lx time=%I64d sample=%u\n",
+                    i + 1, record->hr, record->index, record->flags, record->timestamp, record->has_sample);
+        }
+        fflush(stdout);
+    }
+    if (decoder) decoder->cider_empty_event = NULL;
+    if (transform) IMFTransform_Release(transform);
+    if (empty_event) CloseHandle(empty_event);
+    if (source) IMFMediaSource_Release(source);
+    if (descriptor) IMFStreamDescriptor_Release(descriptor);
+    if (type) IMFMediaType_Release(type);
+    if (callback) IMFSourceReaderCallback_Release(&callback->base.IMFSourceReaderCallback_iface);
+}
+
+static DWORD WINAPI cider_oom_pair_worker(void *unused)
+{
+    const MFT_REGISTER_TYPE_INFO input_info[] = {{MFMediaType_Video, MFVideoFormat_TEST}};
+    const MFT_REGISTER_TYPE_INFO output_info[] = {{MFMediaType_Video, MFVideoFormat_YUY2}};
+    IClassFactory factory = {.lpVtbl = &test_mft_factory_vtbl};
+    BOOL saved_fail = fail_request_sample, saved_allocate = test_decoder_allocate_samples;
+    BOOL saved_d3d9 = test_decoder_d3d_aware, saved_d3d11 = test_decoder_d3d11_aware;
+    HRESULT hr;
+
+    hr = CoInitializeEx(NULL, COINIT_MULTITHREADED);
+    ok(hr == S_OK || hr == S_FALSE, "OOM-pair CoInitializeEx returned %#lx.\n", hr);
+    if (FAILED(hr)) return 1;
+    hr = MFTRegisterLocal(&factory, &MFT_CATEGORY_VIDEO_DECODER, L"Cider OOM pair", 0,
+            ARRAY_SIZE(input_info), input_info, ARRAY_SIZE(output_info), output_info);
+    ok(hr == S_OK, "OOM-pair MFTRegisterLocal returned %#lx.\n", hr);
+    if (hr != S_OK)
+    {
+        CoUninitialize();
+        return 1;
+    }
+    fail_request_sample = FALSE;
+    test_decoder_allocate_samples = TRUE;
+    test_decoder_d3d_aware = test_decoder_d3d11_aware = FALSE;
+    cider_oom_pair_case();
+    fail_request_sample = saved_fail;
+    test_decoder_allocate_samples = saved_allocate;
+    test_decoder_d3d_aware = saved_d3d9;
+    test_decoder_d3d11_aware = saved_d3d11;
+    hr = MFTUnregisterLocal(&factory);
+    ok(hr == S_OK, "OOM-pair MFTUnregisterLocal returned %#lx.\n", hr);
+    CoUninitialize();
+    return 0;
+}
+
+static void test_cider_allocator_oom_pair(void)
+{
+    HANDLE thread;
+    DWORD wait, exit_code = ~0u;
+    BOOL ret;
+
+    thread = CreateThread(NULL, 0, cider_oom_pair_worker, NULL, 0, NULL);
+    ok(!!thread, "Failed to create OOM-pair worker, error %lu.\n", GetLastError());
+    if (!thread) return;
+    wait = WaitForSingleObject(thread, 20000);
+    ok(wait == WAIT_OBJECT_0, "OOM-pair worker exceeded deadline or wait failed, result %#lx.\n", wait);
+    if (wait != WAIT_OBJECT_0)
+    {
+        fputs("cider-mf-oom-pair-worker-deadline-failed\n", stderr);
+        fflush(stderr);
+        ExitProcess(125);
+    }
+    ret = GetExitCodeThread(thread, &exit_code);
+    ok(ret, "OOM-pair GetExitCodeThread failed, error %lu.\n", GetLastError());
+    ok(exit_code == 0, "OOM-pair worker exit code %lu.\n", exit_code);
+    CloseHandle(thread);
+}
