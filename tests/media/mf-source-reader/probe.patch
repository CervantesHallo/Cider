+static DWORD WINAPI cider_media_watchdog(void *unused)
+{
+    Sleep(30000);
+    fputs("cider-mf-watchdog-expired\n", stderr);
+    fflush(stderr);
+    ExitProcess(124);
+    return 0;
+}
+
+/* SourceReader scheduling/error-completion injection, not a GPU pool test.
+ * Apply the three opt-in mock additions in pool-fixture-report-v1.json first.
+ * Insert before START_TEST(mfplat); invoke with MFStartup active.
+ */
+struct cider_allocator_callback
+{
+    struct async_callback base;
+    HANDLE flush_event;
+    BOOL expect_sample, expect_flush;
+    LONG reads, flushes;
+};
+
+static struct cider_allocator_callback *cider_allocator_callback_from_iface(IMFSourceReaderCallback *iface)
+{
+    return CONTAINING_RECORD(impl_from_IMFSourceReaderCallback(iface), struct cider_allocator_callback, base);
+}
+
+static ULONG WINAPI cider_allocator_callback_Release(IMFSourceReaderCallback *iface)
+{
+    struct cider_allocator_callback *callback = cider_allocator_callback_from_iface(iface);
+    ULONG refcount = InterlockedDecrement(&callback->base.refcount);
+
+    if (!refcount)
+    {
+        CloseHandle(callback->base.event);
+        CloseHandle(callback->flush_event);
+        free(callback);
+    }
+    return refcount;
+}
+
+static HRESULT WINAPI cider_allocator_callback_OnReadSample(IMFSourceReaderCallback *iface, HRESULT hr,
+        DWORD index, DWORD flags, LONGLONG timestamp, IMFSample *sample)
+{
+    struct cider_allocator_callback *callback = cider_allocator_callback_from_iface(iface);
+    DWORD buffers = 0;
+    HRESULT sample_hr;
+
+    ok(callback->base.expected, "Unexpected allocator read callback.\n");
+    ok(hr == callback->base.expected_hr, "Allocator callback hr %#lx, expected %#lx.\n",
+            hr, callback->base.expected_hr);
+    ok(index == 0, "Allocator callback index %lu.\n", index);
+    ok(flags == (callback->expect_sample ? 0 : MF_SOURCE_READERF_ERROR),
+            "Allocator callback flags %#lx.\n", flags);
+    ok(timestamp == 0, "Allocator callback timestamp %I64d.\n", timestamp);
+    ok(!!sample == callback->expect_sample, "Allocator callback sample %p, expected presence %u.\n",
+            sample, callback->expect_sample);
+    if (sample)
+    {
+        sample_hr = IMFSample_GetBufferCount(sample, &buffers);
+        ok(sample_hr == S_OK, "GetBufferCount returned %#lx.\n", sample_hr);
+        ok(buffers == 1, "Expected one fake CPU buffer, got %lu.\n", buffers);
+    }
+    callback->base.expected = FALSE;
+    InterlockedIncrement(&callback->reads);
+    /* Last access: a waiter may arm the next expectation after this signal. */
+    SetEvent(callback->base.event);
+    return S_OK;
+}
+
+static HRESULT WINAPI cider_allocator_callback_OnFlush(IMFSourceReaderCallback *iface, DWORD index)
+{
+    struct cider_allocator_callback *callback = cider_allocator_callback_from_iface(iface);
+
+    ok(callback->expect_flush, "Unexpected allocator flush callback.\n");
+    ok(index == 0, "Allocator flush index %lu.\n", index);
+    callback->expect_flush = FALSE;
+    InterlockedIncrement(&callback->flushes);
+    SetEvent(callback->flush_event);
+    return S_OK;
+}
+
+static const IMFSourceReaderCallbackVtbl cider_allocator_callback_vtbl =
+{
+    async_callback_QueryInterface,
+    async_callback_AddRef,
+    cider_allocator_callback_Release,
+    cider_allocator_callback_OnReadSample,
+    cider_allocator_callback_OnFlush,
+    async_callback_OnEvent,
+};
+
+static BOOL cider_allocator_read(IMFSourceReader *reader, struct cider_allocator_callback *callback,
+        HRESULT expected_hr)
+{
+    BOOL expect_sample = expected_hr == S_OK;
+    DWORD index = ~0u, flags = ~0u, buffers = 0, wait;
+    LONGLONG timestamp = -1;
+    IMFSample *sample = NULL;
+    LONG reads = 0;
+    HRESULT hr, sample_hr;
+
+    if (callback)
+    {
+        reads = InterlockedCompareExchange(&callback->reads, 0, 0);
+        callback->base.expected_hr = expected_hr;
+        callback->expect_sample = expect_sample;
+        callback->base.expected = TRUE;
+        hr = IMFSourceReader_ReadSample(reader, 0, 0, NULL, NULL, NULL, NULL);
+        ok(hr == S_OK, "Async ReadSample submission returned %#lx.\n", hr);
+        if (hr != S_OK) return FALSE;
+        wait = WaitForSingleObject(callback->base.event, 1500);
+        ok(wait == WAIT_OBJECT_0, "Allocator read callback wait returned %#lx.\n", wait);
+        if (wait != WAIT_OBJECT_0) return FALSE;
+        ok(!callback->base.expected, "Read callback did not consume expectation.\n");
+        ok(InterlockedCompareExchange(&callback->reads, 0, 0) == reads + 1,
+                "Expected exactly one allocator read callback.\n");
+        return TRUE;
+    }
+
+    /* This synchronous call is covered by the fixture worker's 20 s join. */
+    hr = IMFSourceReader_ReadSample(reader, 0, 0, &index, &flags, &timestamp, &sample);
+    ok(hr == expected_hr, "Sync allocator read returned %#lx, expected %#lx.\n", hr, expected_hr);
+    ok(index == 0, "Sync allocator index %lu.\n", index);
+    ok(flags == (expect_sample ? 0 : MF_SOURCE_READERF_ERROR), "Sync allocator flags %#lx.\n", flags);
+    ok(timestamp == 0, "Sync allocator timestamp %I64d.\n", timestamp);
+    ok(!!sample == expect_sample, "Sync allocator sample %p, expected presence %u.\n", sample, expect_sample);
+    if (sample)
+    {
+        sample_hr = IMFSample_GetBufferCount(sample, &buffers);
+        ok(sample_hr == S_OK, "GetBufferCount returned %#lx.\n", sample_hr);
+        ok(buffers == 1, "Expected one fake CPU buffer, got %lu.\n", buffers);
+        IMFSample_Release(sample);
+    }
+    return hr == expected_hr;
+}
+
+static void cider_allocator_case(BOOL asynchronous, BOOL release_blocked)
+{
+    static const struct attribute_desc input_desc[] =
+    {
+        ATTR_GUID(MF_MT_MAJOR_TYPE, MFMediaType_Video),
+        ATTR_GUID(MF_MT_SUBTYPE, MFVideoFormat_TEST),
+        ATTR_RATIO(MF_MT_FRAME_SIZE, 96, 96),
+        {0},
+    };
+    static const struct attribute_desc output_desc[] =
+    {
+        ATTR_GUID(MF_MT_MAJOR_TYPE, MFMediaType_Video),
+        ATTR_GUID(MF_MT_SUBTYPE, MFVideoFormat_YUY2),
+        {0},
+    };
+    struct cider_allocator_callback *callback = NULL;
+    IMFStreamDescriptor *descriptor = NULL;
+    IMFSourceReaderEx *reader_ex = NULL;
+    IMFAttributes *attributes = NULL;
+    IMFTransform *transform = NULL;
+    IMFMediaType *type = NULL;
+    IMFSourceReader *reader = NULL;
+    IMFMediaSource *source = NULL;
+    struct test_decoder *decoder;
+    DWORD wait;
+    HRESULT hr;
+    LONG inputs;
+    ULONG refs;
+
+    trace("allocator fixture async=%u release_blocked=%u\n", asynchronous, release_blocked);
+    if (asynchronous)
+    {
+        callback = calloc(1, sizeof(*callback));
+        ok(!!callback, "Failed to allocate allocator callback.\n");
+        if (!callback) goto done;
+        callback->base.IMFSourceReaderCallback_iface.lpVtbl = &cider_allocator_callback_vtbl;
+        callback->base.refcount = 1;
+        callback->base.event = CreateEventW(NULL, FALSE, FALSE, NULL);
+        callback->flush_event = CreateEventW(NULL, FALSE, FALSE, NULL);
+        ok(!!callback->base.event && !!callback->flush_event, "Failed to create allocator callback events.\n");
+        if (!callback->base.event || !callback->flush_event) goto done;
+        hr = MFCreateAttributes(&attributes, 1);
+        ok(hr == S_OK, "MFCreateAttributes returned %#lx.\n", hr);
+        if (hr != S_OK) goto done;
+        hr = IMFAttributes_SetUnknown(attributes, &MF_SOURCE_READER_ASYNC_CALLBACK,
+                (IUnknown *)&callback->base.IMFSourceReaderCallback_iface);
+        ok(hr == S_OK, "SetUnknown(callback) returned %#lx.\n", hr);
+        if (hr != S_OK) goto done;
+    }
+
+    hr = MFCreateMediaType(&type);
+    ok(hr == S_OK, "MFCreateMediaType returned %#lx.\n", hr);
+    if (hr != S_OK) goto done;
+    init_media_type(type, input_desc, -1);
+    hr = MFCreateStreamDescriptor(0, 1, &type, &descriptor);
+    ok(hr == S_OK, "MFCreateStreamDescriptor returned %#lx.\n", hr);
+    if (hr != S_OK) goto done;
+    source = create_test_source(&descriptor, 1);
+    ok(!!source, "Failed to create allocator test source.\n");
+    if (!source) goto done;
+    hr = MFCreateSourceReaderFromMediaSource(source, attributes, &reader);
+    ok(hr == S_OK, "MFCreateSourceReaderFromMediaSource returned %#lx.\n", hr);
+    if (hr != S_OK) goto done;
+    hr = IMFSourceReader_SetStreamSelection(reader, 0, TRUE);
+    ok(hr == S_OK, "SetStreamSelection returned %#lx.\n", hr);
+    if (hr != S_OK) goto done;
+    IMFMediaType_Release(type);
+    type = NULL;
+    hr = MFCreateMediaType(&type);
+    ok(hr == S_OK, "MFCreateMediaType(output) returned %#lx.\n", hr);
+    if (hr != S_OK) goto done;
+    init_media_type(type, output_desc, -1);
+    hr = IMFSourceReader_SetCurrentMediaType(reader, 0, NULL, type);
+    ok(hr == S_OK, "SetCurrentMediaType returned %#lx.\n", hr);
+    if (hr != S_OK) goto done;
+    hr = IMFSourceReader_QueryInterface(reader, &IID_IMFSourceReaderEx, (void **)&reader_ex);
+    ok(hr == S_OK, "QueryInterface(SourceReaderEx) returned %#lx.\n", hr);
+    if (hr != S_OK) goto done;
+    hr = IMFSourceReaderEx_GetTransformForStream(reader_ex, 0, 0, NULL, &transform);
+    ok(hr == S_OK, "GetTransformForStream returned %#lx.\n", hr);
+    if (hr != S_OK) goto done;
+    ok(transform->lpVtbl == &test_decoder_vtbl, "Expected registered fake decoder, got %p.\n", transform);
+    if (transform->lpVtbl != &test_decoder_vtbl) goto done;
+    /* Drop this extra public reader reference before checking final Release. */
+    IMFSourceReaderEx_Release(reader_ex);
+    reader_ex = NULL;
+    decoder = test_decoder_from_IMFTransform(transform);
+    decoder->cider_allocator_gate = TRUE;
+    test_decoder_set_next_output(transform, MF_E_SAMPLEALLOCATOR_EMPTY);
+
+    if (!cider_allocator_read(reader, callback, MF_E_SAMPLEALLOCATOR_EMPTY)) goto done;
+    inputs = InterlockedCompareExchange(&decoder->cider_input_count, 0, 0);
+    ok(inputs == 1, "Initial EMPTY must follow exactly one ProcessInput, got %ld.\n", inputs);
+    ok(InterlockedCompareExchange(&decoder->cider_empty_count, 0, 0) == 1,
+            "Initial read did not reach exactly one injected EMPTY.\n");
+    if (release_blocked) goto done;
+
+    /* A consumer still holding its pool has not made output available yet. */
+    if (!cider_allocator_read(reader, callback, MF_E_SAMPLEALLOCATOR_EMPTY)) goto done;
+    ok(InterlockedCompareExchange(&decoder->cider_input_count, 0, 0) == inputs,
+            "Still-empty retry consumed new input.\n");
+    ok(InterlockedCompareExchange(&decoder->cider_empty_count, 0, 0) == 2,
+            "Expected exactly two injected EMPTY results.\n");
+
+    /* Explicit caller retry on the same MFT; no allocator notification implied. */
+    test_decoder_set_next_output(transform, S_OK);
+    if (!cider_allocator_read(reader, callback, S_OK)) goto done;
+    ok(InterlockedCompareExchange(&decoder->cider_input_count, 0, 0) == inputs,
+            "Recovery requested new input instead of pulling retained output.\n");
+    ok(decoder->next_output == MF_E_TRANSFORM_NEED_MORE_INPUT,
+            "Fake decoder did not consume the armed successful output.\n");
+
+    /* Put the reader back into allocator-blocked state before flushing. */
+    test_decoder_set_next_output(transform, MF_E_SAMPLEALLOCATOR_EMPTY);
+    if (!cider_allocator_read(reader, callback, MF_E_SAMPLEALLOCATOR_EMPTY)) goto done;
+    ok(InterlockedCompareExchange(&decoder->cider_empty_count, 0, 0) == 3,
+            "Flush must follow a fresh third EMPTY injection, not a stale response.\n");
+    if (callback) callback->expect_flush = TRUE;
+    hr = IMFSourceReader_Flush(reader, 0);
+    ok(hr == S_OK, "Allocator-blocked Flush returned %#lx.\n", hr);
+    if (callback && hr == S_OK)
+    {
+        wait = WaitForSingleObject(callback->flush_event, 1500);
+        ok(wait == WAIT_OBJECT_0, "Allocator flush callback wait returned %#lx.\n", wait);
+        if (wait == WAIT_OBJECT_0)
+        {
+            ok(!callback->expect_flush, "Flush callback did not consume expectation.\n");
+            ok(InterlockedCompareExchange(&callback->flushes, 0, 0) == 1,
+                    "Expected exactly one flush callback.\n");
+        }
+    }
+
+done:
+    if (reader_ex) IMFSourceReaderEx_Release(reader_ex);
+    if (reader)
+    {
+        /* Includes direct Release with EMPTY armed in release_blocked cases. */
+        refs = IMFSourceReader_Release(reader);
+        ok(!refs, "Final allocator reader Release returned %lu.\n", refs);
+    }
+    if (transform) IMFTransform_Release(transform);
+    if (source) IMFMediaSource_Release(source);
+    if (descriptor) IMFStreamDescriptor_Release(descriptor);
+    if (type) IMFMediaType_Release(type);
+    if (attributes) IMFAttributes_Release(attributes);
+    if (callback) IMFSourceReaderCallback_Release(&callback->base.IMFSourceReaderCallback_iface);
+}
+
+static DWORD WINAPI cider_allocator_worker(void *unused)
+{
+    const MFT_REGISTER_TYPE_INFO input_info[] = {{MFMediaType_Video, MFVideoFormat_TEST}};
+    const MFT_REGISTER_TYPE_INFO output_info[] = {{MFMediaType_Video, MFVideoFormat_YUY2}};
+    IClassFactory factory = {.lpVtbl = &test_mft_factory_vtbl};
+    BOOL saved_fail = fail_request_sample, saved_allocate = test_decoder_allocate_samples;
+    BOOL saved_d3d9 = test_decoder_d3d_aware, saved_d3d11 = test_decoder_d3d11_aware;
+    unsigned int asynchronous;
+    HRESULT hr;
+
+    hr = CoInitializeEx(NULL, COINIT_MULTITHREADED);
+    ok(hr == S_OK || hr == S_FALSE, "Allocator worker CoInitializeEx returned %#lx.\n", hr);
+    if (FAILED(hr)) return 1;
+    hr = MFTRegisterLocal(&factory, &MFT_CATEGORY_VIDEO_DECODER, L"Cider allocator injection", 0,
+            ARRAY_SIZE(input_info), input_info, ARRAY_SIZE(output_info), output_info);
+    ok(hr == S_OK, "Allocator MFTRegisterLocal returned %#lx.\n", hr);
+    if (hr != S_OK)
+    {
+        CoUninitialize();
+        return 1;
+    }
+
+    fail_request_sample = FALSE;
+    test_decoder_allocate_samples = TRUE;
+    test_decoder_d3d_aware = test_decoder_d3d11_aware = FALSE;
+    for (asynchronous = 0; asynchronous < 2; ++asynchronous)
+    {
+        cider_allocator_case(asynchronous, FALSE);
+        cider_allocator_case(asynchronous, TRUE);
+    }
+    fail_request_sample = saved_fail;
+    test_decoder_allocate_samples = saved_allocate;
+    test_decoder_d3d_aware = saved_d3d9;
+    test_decoder_d3d11_aware = saved_d3d11;
+    hr = MFTUnregisterLocal(&factory);
+    ok(hr == S_OK, "Allocator MFTUnregisterLocal returned %#lx.\n", hr);
+    CoUninitialize();
+    return 0;
+}
+
+static void test_cider_allocator_exhaustion(void)
+{
+    HANDLE thread;
+    DWORD wait, exit_code = ~0u;
+    BOOL ret;
+
+    thread = CreateThread(NULL, 0, cider_allocator_worker, NULL, 0, NULL);
+    ok(!!thread, "Failed to create allocator fixture worker, error %lu.\n", GetLastError());
+    if (!thread) return;
+    wait = WaitForSingleObject(thread, 20000);
+    ok(wait == WAIT_OBJECT_0, "Allocator fixture exceeded its deadline or wait failed, result %#lx.\n", wait);
+    if (wait != WAIT_OBJECT_0)
+    {
+        /* Do not detach a worker using stack/global mocks or pretend cleanup ran. */
+        fputs("cider-mf-allocator-fixture-deadline-failed\n", stderr);
+        fflush(stderr);
+        ExitProcess(125);
+    }
+    ret = GetExitCodeThread(thread, &exit_code);
+    ok(ret, "GetExitCodeThread failed, error %lu.\n", GetLastError());
+    ok(exit_code == 0, "Allocator fixture worker exit code %lu.\n", exit_code);
+    CloseHandle(thread);
+}
+
+/* Actual CPU video-processor copy fallback and Flush; no GPU pool claim. */
+static IMFSample *cider_nv12_sample(BYTE luma)
+{
+    IMFMediaBuffer *buffer = NULL;
+    IMFSample *sample = NULL;
+    BYTE *data;
+    HRESULT hr;
+
+    hr = MFCreateSample(&sample);
+    ok(hr == S_OK, "Create input sample %#lx.\n", hr);
+    if (FAILED(hr)) return NULL;
+    hr = MFCreateMemoryBuffer(24, &buffer);
+    ok(hr == S_OK, "Create 4x4 NV12 buffer %#lx.\n", hr);
+    if (FAILED(hr)) goto failed;
+    hr = IMFMediaBuffer_Lock(buffer, &data, NULL, NULL);
+    ok(hr == S_OK, "Lock input %#lx.\n", hr);
+    if (FAILED(hr)) goto failed;
+    memset(data, luma, 16);
+    memset(data + 16, 128, 8);
+    IMFMediaBuffer_Unlock(buffer);
+    hr = IMFMediaBuffer_SetCurrentLength(buffer, 24);
+    ok(hr == S_OK, "Input length %#lx.\n", hr);
+    if (FAILED(hr)) goto failed;
+    hr = IMFSample_AddBuffer(sample, buffer);
+    ok(hr == S_OK, "Add input buffer %#lx.\n", hr);
+    if (FAILED(hr)) goto failed;
+    IMFMediaBuffer_Release(buffer);
+    return sample;
+failed:
+    if (buffer) IMFMediaBuffer_Release(buffer);
+    IMFSample_Release(sample);
+    return NULL;
+}
