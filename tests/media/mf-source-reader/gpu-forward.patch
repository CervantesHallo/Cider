+            : D3D11_RESOURCE_MISC_SHARED)), "Returned sharing flags %#x do not match request.\n", returned_desc.MiscFlags);
+    CIDER_GPU_HR(ID3D11Texture2D_QueryInterface(returned_texture, &IID_IDXGIResource, (void **)&resource));
+    CIDER_GPU_HR(IDXGIResource_GetSharedHandle(resource, &shared_handle));
+    ok(!!shared_handle, "Returned texture has no legacy shared handle.\n");
+    /* A DXGI legacy handle is borrowed; never CloseHandle(shared_handle). */
+    if (!cider_gpu_pixels(returned_texture)) goto done;
+    ok(InterlockedCompareExchange(&decoder->cider_gpu_inputs, 0, 0) == 1,
+            "Expected exactly one fake input.\n");
+    ok(InterlockedCompareExchange(&decoder->cider_gpu_outputs, 0, 0) == 1,
+            "Expected exactly one actual DXGI output.\n");
+    result = TRUE;
+done:
+    CIDER_GPU_DROP(resource);
+    CIDER_GPU_DROP(returned_texture);
+    CIDER_GPU_DROP(dxgi);
+    CIDER_GPU_DROP(returned_buffer);
+    CIDER_GPU_DROP(returned);
+    CIDER_GPU_DROP(extra_transform);
+    CIDER_GPU_DROP(reader_ex);
+    if (reader)
+    {
+        refs = IMFSourceReader_Release(reader);
+        ok(!refs, "gpu-forward final public reader refs %lu.\n", refs);
+    }
+    CIDER_GPU_DROP(transform);
+    CIDER_GPU_DROP(current_type);
+    CIDER_GPU_DROP(type);
+    CIDER_GPU_DROP(source);
+    CIDER_GPU_DROP(descriptor);
+    CIDER_GPU_DROP(attributes);
+    CIDER_GPU_DROP(provided);
+    CIDER_GPU_DROP(buffer);
+    CIDER_GPU_DROP(texture);
+    expect_dxgi_manager = NULL;
+    CIDER_GPU_DROP(manager);
+    CIDER_GPU_DROP(multithread);
+    CIDER_GPU_DROP(context);
+    CIDER_GPU_DROP(device);
+    printf("cider-mf-gpu-case-end supplied_keyed=%u requested_keyed=%u reached_pixel_end=%u\n",
+            supplied_keyed, requested_keyed, result);
+    fflush(stdout);
+    winetest_pop_context();
+    return result;
+}
+
+static DWORD WINAPI cider_gpu_worker(void *unused)
+{
+    const MFT_REGISTER_TYPE_INFO input_info[] = {{MFMediaType_Video, MFVideoFormat_TEST}};
+    const MFT_REGISTER_TYPE_INFO output_info[] = {{MFMediaType_Video, MFVideoFormat_RGB32},
+            {MFMediaType_Video, MFVideoFormat_ABGR32}};
+    IClassFactory factory = {.lpVtbl = &test_mft_factory_vtbl};
+    BOOL saved_fail = fail_request_sample, saved_d3d9 = test_decoder_d3d_aware;
+    BOOL saved_d3d11 = test_decoder_d3d11_aware, saved_got_manager = test_decoder_got_d3d_manager;
+    IMFDXGIDeviceManager *saved_manager = expect_dxgi_manager;
+    unsigned int reached = 0;
+    HRESULT hr;
+
+    hr = CoInitializeEx(NULL, COINIT_MULTITHREADED);
+    ok(hr == S_OK || hr == S_FALSE, "gpu-forward CoInitializeEx returned %#lx.\n", hr);
+    if (FAILED(hr)) return 1;
+    cider_gpu_forward_scope = TRUE;
+    fail_request_sample = FALSE;
+    test_decoder_d3d_aware = FALSE;
+    test_decoder_d3d11_aware = TRUE;
+    hr = MFTRegisterLocal(&factory, &MFT_CATEGORY_VIDEO_DECODER, L"Cider owned GPU forward MFT", 0,
+            ARRAY_SIZE(input_info), input_info, ARRAY_SIZE(output_info), output_info);
+    ok(hr == S_OK, "gpu-forward MFTRegisterLocal returned %#lx.\n", hr);
+    if (hr == S_OK)
+    {
+        reached += cider_gpu_case(FALSE, FALSE);
+        reached += cider_gpu_case(TRUE, TRUE);
+        reached += cider_gpu_case(FALSE, TRUE);
+        reached += cider_gpu_case(TRUE, FALSE);
+        ok(reached == 4, "Only %u/4 cases reached their pixel oracle.\n", reached);
+        hr = MFTUnregisterLocal(&factory);
+        ok(hr == S_OK, "gpu-forward MFTUnregisterLocal returned %#lx.\n", hr);
+    }
+    cider_gpu_forward_scope = FALSE;
+    fail_request_sample = saved_fail;
+    test_decoder_d3d_aware = saved_d3d9;
+    test_decoder_d3d11_aware = saved_d3d11;
+    test_decoder_got_d3d_manager = saved_got_manager;
+    expect_dxgi_manager = saved_manager;
+    CoUninitialize();
+    return reached == 4 ? 0 : 1;
+}
+
+static void test_cider_gpu_forward(void)
+{
+    HANDLE thread;
+    DWORD wait, code = ~0u;
+    BOOL ret;
+
+    thread = CreateThread(NULL, 0, cider_gpu_worker, NULL, 0, NULL);
+    ok(!!thread, "Failed to create gpu-forward worker, error %lu.\n", GetLastError());
+    if (!thread) return;
+    wait = WaitForSingleObject(thread, 25000);
+    ok(wait == WAIT_OBJECT_0, "gpu-forward worker timed out/wait failed, result %#lx.\n", wait);
+    if (wait != WAIT_OBJECT_0)
+    {
+        fputs("cider-mf-gpu-forward-worker-deadline-failed\n", stderr);
+        fflush(stderr);
+        ExitProcess(125);
+    }
+    ret = GetExitCodeThread(thread, &code);
+    ok(ret, "gpu-forward GetExitCodeThread failed, error %lu.\n", GetLastError());
+    ok(code == 0, "gpu-forward worker exit code %lu.\n", code);
+    CloseHandle(thread);
+}
