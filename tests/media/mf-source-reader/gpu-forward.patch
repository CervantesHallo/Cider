+/* gpu-forward: real D3D11 resources, test-owned single-output MFT only.
+ * MF_FIXTURE_SCOPE=gpu-forward selects this fixture under the existing watchdog.
+ * No keyed ownership crosses ReadSample or an MF buffer copy/lock call.
+ */
+static const GUID cider_gpu_attribute =
+        {0xa51fe129, 0x42a1, 0x4acf, {0x8b, 0x01, 0x25, 0x10, 0x25, 0xc1, 0xde, 0x01}};
+
+#define CIDER_GPU_HR(call) do { hr = (call); \
+    ok(hr == S_OK, "%s returned %#lx.\n", #call, hr); \
+    if (hr != S_OK) goto done; } while (0)
+#define CIDER_GPU_DROP(pointer) do { if (pointer) IUnknown_Release((IUnknown *)(pointer)); } while (0)
+
+static BOOL cider_gpu_wait(ID3D11Device *device, ID3D11DeviceContext *context, const char *stage)
+{
+    D3D11_QUERY_DESC desc = {D3D11_QUERY_EVENT, 0};
+    ID3D11Query *query = NULL;
+    BOOL complete = FALSE, result = FALSE;
+    ULONGLONG deadline;
+    HRESULT hr;
+
+    CIDER_GPU_HR(ID3D11Device_CreateQuery(device, &desc, &query));
+    ID3D11DeviceContext_End(context, (ID3D11Asynchronous *)query);
+    ID3D11DeviceContext_Flush(context);
+    deadline = GetTickCount64() + 1500;
+    do
+    {
+        hr = ID3D11DeviceContext_GetData(context, (ID3D11Asynchronous *)query, &complete, sizeof(complete), 0);
+        if (hr != S_FALSE && !(hr == S_OK && !complete)) break;
+        Sleep(1);
+    } while (GetTickCount64() < deadline);
+    ok(hr == S_OK && complete, "%s GPU completion failed/timed out, hr %#lx, complete %u.\n", stage, hr, complete);
+    result = hr == S_OK && complete;
+done:
+    CIDER_GPU_DROP(query);
+    return result;
+}
+
+static BOOL cider_gpu_identity(IUnknown *left, IUnknown *right, BOOL same, const char *what)
+{
+    IUnknown *left_id = NULL, *right_id = NULL;
+    BOOL result = FALSE;
+    HRESULT hr;
+
+    CIDER_GPU_HR(IUnknown_QueryInterface(left, &IID_IUnknown, (void **)&left_id));
+    CIDER_GPU_HR(IUnknown_QueryInterface(right, &IID_IUnknown, (void **)&right_id));
+    ok((left_id == right_id) == same, "%s identities %p / %p, expected same=%u.\n",
+            what, left_id, right_id, same);
+    result = (left_id == right_id) == same;
+done:
+    CIDER_GPU_DROP(left_id);
+    CIDER_GPU_DROP(right_id);
+    return result;
+}
+
+static BOOL cider_gpu_clear(ID3D11Device *device, ID3D11DeviceContext *context, ID3D11Texture2D *texture)
+{
+    const float color[4] = {0.25f, 0.5f, 0.75f, 1.0f};
+    ID3D11RenderTargetView *view = NULL;
+    IDXGIKeyedMutex *mutex = NULL;
+    D3D11_TEXTURE2D_DESC desc;
+    BOOL owned = FALSE, result = FALSE;
+    HRESULT hr;
+
+    ID3D11Texture2D_GetDesc(texture, &desc);
+    CIDER_GPU_HR(ID3D11Device_CreateRenderTargetView(device, (ID3D11Resource *)texture, NULL, &view));
+    if (desc.MiscFlags & D3D11_RESOURCE_MISC_SHARED_KEYEDMUTEX)
+    {
+        CIDER_GPU_HR(ID3D11Texture2D_QueryInterface(texture, &IID_IDXGIKeyedMutex, (void **)&mutex));
+        CIDER_GPU_HR(IDXGIKeyedMutex_AcquireSync(mutex, 0, 500));
+        owned = TRUE;
+    }
+    ID3D11DeviceContext_ClearRenderTargetView(context, view, color);
+    if (!cider_gpu_wait(device, context, "producer clear")) goto done;
+    if (owned)
+    {
+        CIDER_GPU_HR(IDXGIKeyedMutex_ReleaseSync(mutex, 0));
+        owned = FALSE;
+    }
+    result = TRUE;
+done:
+    if (owned)
+    {
+        hr = IDXGIKeyedMutex_ReleaseSync(mutex, 0);
+        ok(hr == S_OK, "Producer cleanup ReleaseSync returned %#lx.\n", hr);
+    }
+    CIDER_GPU_DROP(mutex);
+    CIDER_GPU_DROP(view);
+    return result;
+}
+
+static BOOL cider_gpu_pixels(ID3D11Texture2D *texture)
+{
+    static const int expected[3] = {191, 128, 64}; /* BGR; RGB32 X byte is unused. */
+    ID3D11Device *device = NULL;
+    ID3D11DeviceContext *context = NULL;
+    ID3D11Texture2D *staging = NULL;
+    IDXGIKeyedMutex *mutex = NULL;
+    D3D11_MAPPED_SUBRESOURCE mapped = {0};
+    D3D11_TEXTURE2D_DESC desc;
+    BOOL owned = FALSE, is_mapped = FALSE, result = FALSE;
+    unsigned int x, y, channel, mismatches = 0;
+    ULONGLONG deadline;
+    HRESULT hr;
+
+    ID3D11Texture2D_GetDesc(texture, &desc);
+    ok(desc.Width == 16 && desc.Height == 16 && desc.Format == DXGI_FORMAT_B8G8R8X8_UNORM,
+            "Readback texture layout %ux%u, format %#x.\n", desc.Width, desc.Height, desc.Format);
+    if (desc.Width != 16 || desc.Height != 16 || desc.Format != DXGI_FORMAT_B8G8R8X8_UNORM) goto done;
+    ID3D11Texture2D_GetDevice(texture, &device);
+    ID3D11Device_GetImmediateContext(device, &context);
+    if (desc.MiscFlags & D3D11_RESOURCE_MISC_SHARED_KEYEDMUTEX)
+    {
+        CIDER_GPU_HR(ID3D11Texture2D_QueryInterface(texture, &IID_IDXGIKeyedMutex, (void **)&mutex));
+        CIDER_GPU_HR(IDXGIKeyedMutex_AcquireSync(mutex, 0, 500));
+        owned = TRUE;
+    }
+    desc.Usage = D3D11_USAGE_STAGING;
+    desc.BindFlags = desc.MiscFlags = 0;
+    desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    CIDER_GPU_HR(ID3D11Device_CreateTexture2D(device, &desc, NULL, &staging));
+    ID3D11DeviceContext_CopyResource(context, (ID3D11Resource *)staging, (ID3D11Resource *)texture);
+    if (!cider_gpu_wait(device, context, "returned texture copy")) goto done;
+    deadline = GetTickCount64() + 1500;
+    do
+    {
+        hr = ID3D11DeviceContext_Map(context, (ID3D11Resource *)staging, 0, D3D11_MAP_READ,
+                D3D11_MAP_FLAG_DO_NOT_WAIT, &mapped);
+        if (hr != DXGI_ERROR_WAS_STILL_DRAWING) break;
+        Sleep(1);
+    } while (GetTickCount64() < deadline);
+    ok(hr == S_OK, "Nonblocking staging Map failed/timed out, hr %#lx.\n", hr);
+    if (hr != S_OK) goto done;
+    is_mapped = TRUE;
+    ok(!!mapped.pData && mapped.RowPitch >= 16 * 4, "Readback pointer %p, row pitch %u.\n",
+            mapped.pData, mapped.RowPitch);
+    if (!mapped.pData || mapped.RowPitch < 16 * 4) goto done;
+    for (y = 0; y < 16; ++y)
+        for (x = 0; x < 16; ++x)
+            for (channel = 0; channel < 3; ++channel)
+            {
+                const BYTE *pixel = (const BYTE *)mapped.pData + y * mapped.RowPitch + x * 4;
+                int delta = (int)pixel[channel] - expected[channel];
+                if (delta < -1 || delta > 1) ++mismatches;
+            }
+    ok(!mismatches, "Returned texture has %u mismatching BGR components (256 pixels).\n", mismatches);
+    result = !mismatches;
+done:
+    if (is_mapped) ID3D11DeviceContext_Unmap(context, (ID3D11Resource *)staging, 0);
+    if (owned)
+    {
+        hr = IDXGIKeyedMutex_ReleaseSync(mutex, 0);
+        ok(hr == S_OK, "Readback cleanup ReleaseSync returned %#lx.\n", hr);
+        if (hr != S_OK) result = FALSE;
+    }
+    CIDER_GPU_DROP(mutex);
+    CIDER_GPU_DROP(staging);
+    CIDER_GPU_DROP(context);
+    CIDER_GPU_DROP(device);
+    return result;
+}
