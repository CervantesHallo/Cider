+/* DIAGNOSTIC ONLY: retain the failed-close handle locally until a real PE
+ * worker has executed native completion. Every field uses remote_lock. */
+static struct { UINT64 id; BOOL armed, seen, finalized, watched; UINT inflight; NTSTATUS decision; } inflight_fixture;
+static void diagnostic_inflight_close(struct remote_producer *producer, HANDLE process)
+{
+    struct timespec start, now;
+    LARGE_INTEGER pause = { .QuadPart = -10000 };
+    OBJECT_BASIC_INFORMATION information = {0};
+    BOOL seen = FALSE, finalized = FALSE, watched = FALSE, clock_ok;
+    LONGLONG elapsed = 0;
+    UINT inflight = 0;
+    NTSTATUS decision = STATUS_UNSUCCESSFUL, query;
+    DWORD stopped;
+    pthread_mutex_lock(&remote_lock);
+    memset(&inflight_fixture, 0, sizeof(inflight_fixture));
+    inflight_fixture.id = producer->id; inflight_fixture.armed = TRUE;
+    pthread_mutex_unlock(&remote_lock);
+    clock_ok = !clock_gettime(CLOCK_MONOTONIC, &start);
+    stopped = stop_producer_watch(producer); /* actual stop event, no lock held */
+    if (clock_ok)
+        for (;;)
+        {
+            if (clock_gettime(CLOCK_MONOTONIC, &now) ||
+                (elapsed = (now.tv_sec - start.tv_sec) * 1000000000LL + now.tv_nsec - start.tv_nsec) >= 1500000000LL) break;
+            pthread_mutex_lock(&remote_lock);
+            seen = inflight_fixture.seen;
+            if (seen)
+            {
+                finalized = inflight_fixture.finalized; watched = inflight_fixture.watched;
+                inflight = inflight_fixture.inflight; decision = inflight_fixture.decision;
+            }
+            pthread_mutex_unlock(&remote_lock);
+            if (clock_gettime(CLOCK_MONOTONIC, &now) ||
+                (elapsed = (now.tv_sec - start.tv_sec) * 1000000000LL + now.tv_nsec - start.tv_nsec) >= 1500000000LL)
+            { seen = FALSE; break; }
+            if (seen) break;
+            NtDelayExecution(FALSE, &pause);
+        }
+    query = NtQueryObject(process, ObjectBasicInformation, &information, sizeof(information), NULL);
+    if (!clock_ok || clock_gettime(CLOCK_MONOTONIC, &now) ||
+        (elapsed = (now.tv_sec - start.tv_sec) * 1000000000LL + now.tv_nsec - start.tv_nsec) >= 1500000000LL) seen = FALSE;
+    pthread_mutex_lock(&remote_lock); inflight_fixture.armed = FALSE; pthread_mutex_unlock(&remote_lock);
+    WARN("inflight-close snapshot id %#llx seen %u finalized %u watched %u inflight %u decision %#x query %#x handles %u stop %u elapsed %lld\n",
+         (unsigned long long)producer->id, seen, finalized, watched, inflight,
+         (unsigned)decision, (unsigned)query, (unsigned)information.HandleCount, (unsigned)stopped, (long long)elapsed);
+}
