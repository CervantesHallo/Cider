--- a/dlls/winemac.drv/remote_coordinator.c
+++ b/dlls/winemac.drv/remote_coordinator.c
@@ -517,6 +517,17 @@
     NTSTATUS status;
     UINT_PTR handle = (UINT_PTR)process;
     if (acknowledged) *acknowledged = FALSE;
+    /* DIAGNOSTIC ONLY: lose one STOP before callback dispatch. The real PE
+     * worker and its handles remain live; this is a failure, never success. */
+    if (operation == MACDRV_REMOTE_WATCH_STOP)
+    {
+        static LONG lost_once;
+        if (!InterlockedCompareExchange(&lost_once, 1, 0))
+        {
+            WARN("transport-stop-fault lost-unacknowledged %#llx\n", (unsigned long long)id);
+            return RtlNtStatusToDosError(STATUS_NOT_FOUND);
+        }
+    }
     if (handle != (UINT32)handle) return ERROR_INVALID_HANDLE;
     request.dispatch.callback = (UINT64)InterlockedCompareExchange64(&watch_callback, 0, 0);
     request.magic = MACDRV_REMOTE_WATCH_MAGIC;
