+/* Diagnostic-only read-only owner counts; not pixels or complete heap accounting. */
+#include "probe.h"
+NTSTATUS macdrv_remote_transport_probe(void *args)
+{
+    struct transport_probe *probe = args;
+    struct remote_root *root;
+    struct remote_host *host;
+    struct remote_producer *producer;
+    if (!probe || probe->size != sizeof(*probe) || probe->version != 2) return STATUS_INVALID_PARAMETER;
+    probe->roots = probe->producers = probe->watch_pins = probe->hosts = 0;
+    probe->target_active = probe->target_watched = 0;
+    pthread_mutex_lock(&remote_lock);
+    for (root = roots; root; root = root->next) ++probe->roots;
+    for (host = hosts; host; host = host->next) ++probe->hosts;
+    for (producer = producers; producer; producer = producer->next)
+    {
+        ++probe->producers;
+        if (producer->id == probe->target_lease && producer->active && producer->watch_started &&
+            producer->root->open && producer->root->revision) probe->target_active = 1;
+    }
+    for (producer = producer_watches; producer; producer = producer->watch_next)
+    {
+        ++probe->watch_pins;
+        if (producer->id == probe->target_lease) probe->target_watched = 1;
+    }
+    for (producer = producer_cleanup; producer; producer = producer->cleanup_next) ++probe->cleanup_pins;
+    pthread_mutex_unlock(&remote_lock);
+    return STATUS_SUCCESS;
+}
