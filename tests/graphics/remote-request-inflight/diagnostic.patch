+#include "probe.h"
+NTSTATUS WINAPI cider_remote_transport_probe(void *args)
+{
+    struct transport_probe *probe = args;
+    if (!probe || probe->size != sizeof(*probe) || probe->version != 2) return STATUS_INVALID_PARAMETER;
+    probe->pe_watches = InterlockedCompareExchange(&fixture_live_watches, 0, 0);
+    probe->cleanup_pins = InterlockedCompareExchange(&fixture_live_timers, 0, 0);
+    return MACDRV_CALL(remote_transport_probe, probe);
+}
+
+#include "fixture.h"
+NTSTATUS WINAPI cider_request_fixture(void *args)
+{
+    struct request_fixture *frame = args;
+    NTSTATUS status;
+    if (!frame || frame->size != sizeof(*frame) || frame->version != 2 || frame->reserved)
+        return STATUS_INVALID_PARAMETER;
+    status = MACDRV_CALL(request_fixture, frame);
+    frame->pe_watches = InterlockedCompareExchange(&fixture_live_watches, 0, 0);
+    frame->pe_timers = InterlockedCompareExchange(&fixture_live_timers, 0, 0);
+    if (!status && frame->operation == 4 && !frame->status && (frame->pe_watches || frame->pe_timers))
+        frame->status = ERROR_IO_PENDING;
+    return status;
+}
