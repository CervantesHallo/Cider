+#include "fixture.h"
+NTSTATUS WINAPI cider_retirement_fixture(void *args)
+{
+    struct retirement_fixture *frame = args;
+    NTSTATUS status;
+    if (!frame || frame->size != sizeof(*frame) || frame->version != 1 || frame->reserved)
+        return STATUS_INVALID_PARAMETER;
+    status = MACDRV_CALL(retirement_fixture, frame);
+    frame->pe_watches = InterlockedCompareExchange(&fixture_live_watches, 0, 0);
+    frame->pe_timers = InterlockedCompareExchange(&fixture_live_timers, 0, 0);
+    if (!status && frame->operation == 5 && !frame->status && (frame->pe_watches || frame->pe_timers))
+        frame->status = ERROR_IO_PENDING;
+    return status;
+}
