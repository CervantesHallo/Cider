+#include "probe.h"
+NTSTATUS WINAPI cider_remote_transport_probe(void *args)
+{
+    struct transport_probe *probe = args;
+    if (!probe || probe->size != sizeof(*probe) || probe->version != 2) return STATUS_INVALID_PARAMETER;
+    probe->pe_watches = InterlockedCompareExchange(&fixture_live_watches, 0, 0);
+    probe->cleanup_pins = InterlockedCompareExchange(&fixture_live_timers, 0, 0);
+    return MACDRV_CALL(remote_transport_probe, probe);
+}
